# Sanity-Projekt "WERKstatt Gemeinschaft" (Org: Intuitivmedia)
# Diese Werte sind auch als Defaults im Code (astro/src/lib/sanity.ts
# und astro/sanity/sanity.config.ts) — .env nur nötig wenn ein anderes
# Dataset (z.B. "staging") gegen die Production-Site läuft.
PUBLIC_SANITY_PROJECT_ID=z6eclgt8
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-03-01

# Studio-spezifisch (für sanity dev / sanity deploy aus astro/sanity/)
SANITY_STUDIO_PROJECT_ID=z6eclgt8
SANITY_STUDIO_DATASET=production

# Schreib-Token nur für Server-Operationen (z.B. Formular-Submit) —
# Niemals im Browser exposen. Wird angelegt, wenn das Mitkommen-Formular
# auf Sanity-Backend umgestellt wird (statt mailto).
# SANITY_API_WRITE_TOKEN=
