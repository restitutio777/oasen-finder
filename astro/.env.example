# Sanity-Verbindung — Werte werden eingetragen, sobald Sanity-Projekt in
# Katharinas Namen angelegt ist (siehe README.md > "Sanity-Setup")
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-03-01

# Nur für lokales Studio + Build-Deploys — kein read-token im Frontend nötig,
# da dataset public ist (Lese-Zugriff via CDN)
# SANITY_API_WRITE_TOKEN=
