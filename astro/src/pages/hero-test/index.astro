---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Hero-Vergleich (interne Abstimmung mit Katharina · 18.05.).
 * Drei Hero-Konzepte untereinander, nicht in der Navigation verlinkt:
 *   A — Aktuelle Linie (Cream-Glas-Box auf weichem Foto)
 *   B — Editorial (Cream-First, Foto als Polaroid-Akzent)
 *   C — Cinematic (Vollbild-Foto klar, Minimal-Text-Overlay)
 *
 * Diese Seite ist eine Diskussionsbasis. Wenn die Entscheidung
 * gefallen ist, kann sie gelöscht werden — bis dahin URL teilen
 * für externes Feedback.
 */
---

<BaseLayout
  title="Hero-Vergleich · WERKSTATT Gemeinschaft"
  description="Interne Hero-Konzept-Abstimmung — drei Entwürfe zur Auswahl"
>
  {/* ============================================================
     VARIANT A — Aktuelle Linie (= Landing-Hero)
     Cream-Glas-Box auf weichem Lagerfeuer-Foto. Zwei Farben in der
     Headline (Logo-Champagne + Türkis), klar und scharf, kein Glow.
     Subtitle-Trenner in Türkis als Brand-Akzent.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf A · Aktuelle Linie (= Landing-Hero)</span></div></div>
  <section class="hero hero--a">
    <div class="container hero__inner">
      <div class="hero__main">
        <span class="eyebrow hero__eyebrow">
          <span class="hero__eyebrow-nowrap">Gemeinschafts<em class="hero__eyebrow-werk">WERK</em></span> statt allein unterwegs
        </span>
        <h1 class="hero__title">
          <span class="hero__title-a">Auf der Suche —</span><br />
          <span class="hero__title-b">wie wird <em>Gemeinschaft?</em></span>
        </h1>
        <p class="hero__subtitle">
          Reisen <span class="hero__subtitle-dot">·</span> Werkstätten <span class="hero__subtitle-dot">·</span> Notizen <span class="hero__subtitle-dot">·</span> Fotos
        </p>
        <div class="hero__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT B — Editorial / Brief-von-unterwegs
     Cream-Hintergrund, kein Foto-Background. Sehr große Cormorant-
     Typo links, ein kleines Polaroid-Foto rechts als Akzent. Wie
     ein Brief, ruhig, literarisch.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf B · Editorial · Bild-Hauch im Cream</span></div></div>
  <section class="hero hero--b">
    <div class="hero-b__photo-hint" aria-hidden="true"></div>
    <div class="container hero-b__inner">
      <div class="hero-b__text">
        <span class="hero-b__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-b__title">
          Auf der Suche —<br />
          wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-b__subtitle">
          Reisen · Werkstätten · Notizen · Fotos
        </p>
        <div class="hero-b__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT C — Cinematic
     Vollbild-Foto in voller Schärfe (kein Blur), dezente Vignette.
     Headlines + Subtitle als heller Cream-Text auf dem Bild,
     dramatisch-cinematic.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf C · Cinematic · Bild dominiert</span></div></div>
  <section class="hero hero--c">
    <div class="hero-c__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-c__vignette" aria-hidden="true"></div>
    <div class="container hero-c__content">
      <span class="hero-c__eyebrow">— GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-c__title">
        Auf der Suche —<br />
        wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-c__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-c__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT D — Magazin-Cover-Split (kreativer Entwurf)
     Vollbild-Sonnenblume links als emotionale Komposition, Cream-
     Textspalte rechts als ruhiges Pendant. Soft-Fade an der Naht
     für organischen Übergang. Auf Mobile stacked (Bild oben, Text
     unten).
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf D · Magazin-Cover · Split-Layout</span></div></div>
  <section class="hero hero--d">
    <div class="hero-d__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-d__text">
      <span class="hero-d__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-d__title">
        Auf der Suche —<br />
        wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-d__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-d__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  <style>
    /* ========== Info-Banner oben ========== */
    .vergleich-info {
      background: #2d2435;
      color: rgba(255, 255, 255, 0.9);
      padding: 18px 0;
      font-size: 14px;
    }
    .vergleich-label {
      max-width: 760px;
      margin: 0;
      line-height: 1.55;
    }
    .variant-label {
      background: var(--bg-warm-soft);
      padding: 14px 0;
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }
    .variant-label span {
      font-family: var(--font-text);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-hover);
      font-weight: 500;
    }

    /* ============================================================
       VARIANT A — erbt komplett von globalen .hero-Regeln
       (gleicher Stand wie Landing-Hero). Keine Overrides nötig.
       ============================================================ */

    /* ============================================================
       VARIANT B — Editorial mit dezentem Bild-Hauch
       Cream-Hintergrund, dazu ein zarter Sonnenblumen-Wash rechts
       (sehr niedrige Opazität, weicher Blur, weicher Maske-Rand).
       Vom Bild nur „ein Hauch" zu sehen — die Stimmung trägt, das
       Foto drängt sich nicht auf (Katharina · 18.05.).
       ============================================================ */
    .hero--b {
      position: relative;
      background: var(--bg-base);
      padding: clamp(80px, 11vw, 140px) 0 clamp(72px, 9vw, 120px);
      min-height: auto;
      overflow: hidden;
      isolation: isolate;
    }
    .hero--b::before,
    .hero--b::after {
      display: none;
      content: none;
    }
    /* Bild-Hauch rechts — Sonnenblume als progressives Reveal:
       links beginnt es als reines Cream (mask transparent), nach
       rechts hin wird das Bild zunehmend sichtbar. Zusätzlich
       radial-Verstärkung in der rechten Bildmitte für sanften
       Ankerpunkt. (Katharina · 18.05.: „progressive reveal"). */
    .hero-b__photo-hint {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 75%;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: blur(4px) saturate(0.95) brightness(1.04);
      opacity: 0.55;
      mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.0) 18%,
          rgba(0, 0, 0, 0.15) 40%,
          rgba(0, 0, 0, 0.45) 65%,
          rgba(0, 0, 0, 0.80) 85%,
          rgba(0, 0, 0, 0.95) 100%);
      -webkit-mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.0) 18%,
          rgba(0, 0, 0, 0.15) 40%,
          rgba(0, 0, 0, 0.45) 65%,
          rgba(0, 0, 0, 0.80) 85%,
          rgba(0, 0, 0, 0.95) 100%);
      pointer-events: none;
      z-index: 0;
    }
    .hero-b__inner {
      position: relative;
      z-index: 1;
    }
    .hero-b__text {
      max-width: 720px;
    }
    .hero-b__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 2vw, 26px);
      color: var(--accent-hover);
      margin-bottom: clamp(24px, 2.8vw, 36px);
      letter-spacing: 0.01em;
      line-height: 1.4;
    }
    .hero-b__title {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 7vw, 5.6rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-b__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-b__subtitle {
      margin-top: clamp(24px, 3vw, 36px);
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-hover);
    }
    .hero-b__cta-row {
      margin-top: clamp(28px, 3.5vw, 44px);
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }
    /* Auf schmalen Viewports den Bild-Hauch nach unten verschieben
       und kleiner halten — sonst zieht er auf Mobile zu viel
       Aufmerksamkeit auf sich. */
    @media (max-width: 720px) {
      .hero-b__photo-hint {
        top: auto;
        right: -20%;
        bottom: -10%;
        width: 80%;
        height: 60%;
        opacity: 0.16;
      }
    }

    /* ============================================================
       VARIANT C — Cinematic
       ============================================================ */
    .hero--c {
      position: relative;
      padding: 0;
      min-height: clamp(580px, 88vh, 880px);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }
    .hero--c::before,
    .hero--c::after {
      display: none;
      content: none;
    }
    .hero-c__image {
      position: absolute;
      inset: 0;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: saturate(0.92) contrast(1.02);
      z-index: -2;
    }
    .hero-c__vignette {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 120% 90% at 50% 35%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.35) 75%,
          rgba(0, 0, 0, 0.55) 100%),
        linear-gradient(180deg,
          rgba(0, 0, 0, 0.30) 0%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.0) 60%,
          rgba(0, 0, 0, 0.70) 100%);
      z-index: -1;
    }
    .hero-c__content {
      padding: clamp(60px, 9vw, 120px) 0 clamp(56px, 8vw, 100px);
      max-width: 1080px;
      color: #fff;
    }
    .hero-c__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(16px, 1.4vw, 20px);
      color: rgba(251, 246, 243, 0.92);
      margin-bottom: clamp(20px, 2.4vw, 32px);
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
    }
    .hero-c__title {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 7.4vw, 6rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      font-weight: 400;
      color: rgba(251, 246, 243, 0.98);
      margin: 0;
      text-shadow: 0 4px 28px rgba(0, 0, 0, 0.55);
    }
    .hero-c__title em {
      font-style: italic;
      color: #8fc4dc;
      font-weight: 500;
    }
    .hero-c__subtitle {
      margin-top: clamp(20px, 2.6vw, 32px);
      font-family: var(--font-display);
      font-size: clamp(20px, 2vw, 26px);
      color: rgba(251, 246, 243, 0.92);
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
      max-width: 640px;
    }
    .hero-c__cta-row {
      margin-top: clamp(32px, 4vw, 48px);
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }
    .hero--c .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow:
        0 10px 30px -8px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.20);
    }
    .hero--c .btn--ghost.btn--fresh {
      background: rgba(251, 246, 243, 0.18);
      color: #fff;
      border-color: rgba(251, 246, 243, 0.6);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .hero--c .btn--ghost.btn--fresh:hover {
      background: rgba(251, 246, 243, 0.92);
      color: var(--text-primary);
    }

    /* ============================================================
       VARIANT D — Magazin-Cover-Split
       Bild links 58 %, Cream-Textspalte rechts 42 %. Soft-Fade an
       der Naht via linear-gradient mask. Mobile stacked.
       ============================================================ */
    .hero--d {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      min-height: clamp(620px, 88vh, 880px);
      background: var(--bg-base);
      overflow: hidden;
      isolation: isolate;
      padding: 0;
    }
    .hero--d::before,
    .hero--d::after {
      display: none;
      content: none;
    }
    @media (min-width: 900px) {
      .hero--d {
        grid-template-columns: 1.38fr 1fr;
      }
    }
    /* Bild-Spalte: vollformatig, satte Sättigung. An der rechten Kante
       (Übergang zur Textspalte) ein weicher Cream-Fade via Mask, sodass
       die Naht organisch zur Text-Seite atmet statt mit harter Kante zu
       brechen. */
    .hero-d__image {
      position: relative;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: 50% 45%;
      min-height: clamp(280px, 38vh, 420px);
      filter: saturate(0.95) contrast(1.02);
      mask-image: linear-gradient(to right,
          black 0%,
          black 78%,
          rgba(0, 0, 0, 0.5) 95%,
          transparent 100%);
      -webkit-mask-image: linear-gradient(to right,
          black 0%,
          black 78%,
          rgba(0, 0, 0, 0.5) 95%,
          transparent 100%);
    }
    @media (min-width: 900px) {
      .hero-d__image {
        min-height: 0;
      }
    }
    /* Auf Mobile: vertikales Fade unten statt horizontal rechts. */
    @media (max-width: 899px) {
      .hero-d__image {
        mask-image: linear-gradient(to bottom,
            black 0%,
            black 78%,
            rgba(0, 0, 0, 0.5) 95%,
            transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom,
            black 0%,
            black 78%,
            rgba(0, 0, 0, 0.5) 95%,
            transparent 100%);
      }
    }
    /* Text-Spalte: zentrierter Inhalt in einer Cream-Säule. */
    .hero-d__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(20px, 2.4vw, 30px);
      padding: clamp(48px, 7vw, 96px) clamp(32px, 5vw, 72px);
      max-width: 620px;
    }
    .hero-d__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(18px, 1.9vw, 24px);
      color: var(--accent-hover);
      letter-spacing: 0.01em;
      line-height: 1.4;
      margin: 0;
    }
    .hero-d__title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6.4vw, 5rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-d__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-d__subtitle {
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-hover);
      margin: 0;
    }
    .hero-d__cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      margin-top: clamp(8px, 1vw, 14px);
    }
    .hero--d .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 6px 18px -6px rgba(200, 154, 120, 0.45);
    }
    .hero--d .btn--primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .hero--d .btn--ghost.btn--fresh {
      background: transparent;
      border-width: 1.5px;
      box-shadow: none;
    }
  </style>
</BaseLayout>
