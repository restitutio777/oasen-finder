---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Hero-Vergleich (interne Abstimmung mit Katharina · 18.05.).
 * Drei Hero-Konzepte untereinander, nicht in der Navigation verlinkt:
 *   A — Aktuelle Linie (Cream-Glas-Box auf weichem Foto)
 *   B — Editorial (Cream-First, Foto als Polaroid-Akzent)
 *   C — Cinematic (Vollbild-Foto klar, Minimal-Text-Overlay)
 *
 * Diese Seite ist eine Diskussionsbasis. Wenn die Entscheidung
 * gefallen ist, kann sie gelöscht werden — bis dahin URL teilen
 * für externes Feedback.
 */
---

<BaseLayout
  title="Hero-Vergleich · WERKSTATT Gemeinschaft"
  description="Interne Hero-Konzept-Abstimmung — drei Entwürfe zur Auswahl"
>
  {/* ============================================================
     VARIANT A — Editorial · Headline + Foto-Karte
     Cream-Hintergrund, links Text-Säule (Eyebrow + zweifarbige
     Headline + Subtitle + CTAs), rechts eine Portrait-Foto-Karte
     (4:5, gerundete Ecken, dezenter Schatten). Alle Texte sitzen
     auf Cream und sind damit garantiert lesbar — keine Glas-Box-
     Tricks, kein Foto-Hintergrund, keine Lesbarkeits-Lottos.
     Mobile: Stack, Foto-Karte oben im 5:4-Format.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf A · Editorial · Headline + Foto-Karte</span></div></div>
  <section class="hero hero--a">
    <div class="container hero-a__grid">
      <div class="hero-a__text">
        <span class="hero-a__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-a__title">
          Auf der Suche —<br />
          wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-a__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
        <div class="hero-a__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
      <div class="hero-a__photo" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    </div>
  </section>

  {/* ============================================================
     VARIANT B — Editorial / Brief-von-unterwegs
     Cream-Hintergrund, kein Foto-Background. Sehr große Cormorant-
     Typo links, ein kleines Polaroid-Foto rechts als Akzent. Wie
     ein Brief, ruhig, literarisch.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf B · Editorial · Bild-Hauch im Cream</span></div></div>
  <section class="hero hero--b">
    <div class="hero-b__photo-hint" aria-hidden="true"></div>
    <div class="container hero-b__inner">
      <div class="hero-b__text">
        <span class="hero-b__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-b__title">
          Auf der Suche —<br />
          wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-b__subtitle">
          Reisen · Werkstätten · Notizen · Fotos
        </p>
        <div class="hero-b__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT C — Cinematic
     Vollbild-Foto in voller Schärfe (kein Blur), dezente Vignette.
     Headlines + Subtitle als heller Cream-Text auf dem Bild,
     dramatisch-cinematic.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf C · Cinematic · Bild dominiert</span></div></div>
  <section class="hero hero--c">
    <div class="hero-c__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-c__vignette" aria-hidden="true"></div>
    <div class="container hero-c__content">
      <span class="hero-c__eyebrow">— GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-c__title">
        Auf der Suche —<br />
        wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-c__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-c__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT C2 — Cinematic · Bild gedämpft
     Wie C, aber zusätzlich ein dunkler Dim-Layer über dem Foto.
     Bild bleibt scharf (kein Blur), wird aber gleichmäßig
     abgedunkelt — die helle Cream-Schrift trägt damit klar.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf C2 · Cinematic · Bild gedämpft</span></div></div>
  <section class="hero hero--c2">
    <div class="hero-c2__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-c2__dim" aria-hidden="true"></div>
    <div class="hero-c2__vignette" aria-hidden="true"></div>
    <div class="container hero-c2__content">
      <span class="hero-c2__eyebrow">— GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-c2__title">
        Auf der Suche —<br />
        wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-c2__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-c2__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT D — Split-Layout · klare Trennung
     Desktop: 50/50-Grid, links voll-bleed Sonnenblume, rechts
     ruhige Cream-Säule mit Text. Klare vertikale Kante, keine
     Soft-Fade-Masken, keine Verspieltheit. Alle Texte auf Cream
     → garantiert lesbar. Mobile: Stack, Foto oben (4:3), Text
     darunter auf Cream.
     ============================================================ */}
  <div class="variant-label"><div class="container"><span>Entwurf D · Split-Layout · klare Trennung</span></div></div>
  <section class="hero hero--d">
    <div class="hero-d__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-d__text">
      <span class="hero-d__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-d__title">
        Auf der Suche —<br />
        wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-d__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
      <div class="hero-d__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  <style>
    /* ========== Info-Banner oben ========== */
    .vergleich-info {
      background: #2d2435;
      color: rgba(255, 255, 255, 0.9);
      padding: 18px 0;
      font-size: 14px;
    }
    .vergleich-label {
      max-width: 760px;
      margin: 0;
      line-height: 1.55;
    }
    .variant-label {
      background: var(--bg-warm-soft);
      padding: 14px 0;
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }
    .variant-label span {
      font-family: var(--font-text);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-hover);
      font-weight: 500;
    }

    /* ============================================================
       VARIANT A — Editorial · Headline + Foto-Karte
       Cream-Hintergrund, klare 2-Spalten-Komposition auf Desktop
       (Text links, Foto-Karte rechts), Stack auf Mobile (Foto-
       Karte oben, Text drunter). Alle Texte sitzen auf Cream —
       keine Lesbarkeits-Tricks nötig.
       Globale .hero-Styles (full-bleed-bg via ::before, fix min-
       height) werden für .hero--a komplett deaktiviert.
       ============================================================ */
    .hero--a {
      background: var(--bg-base);
      padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 100px);
      min-height: auto;
      overflow: visible;
      isolation: auto;
    }
    .hero--a::before,
    .hero--a::after {
      display: none;
      content: none;
    }
    .hero-a__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(36px, 5vw, 64px);
      align-items: center;
    }
    @media (min-width: 900px) {
      .hero-a__grid {
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: clamp(48px, 6vw, 96px);
      }
    }
    .hero-a__text {
      display: flex;
      flex-direction: column;
      gap: clamp(20px, 2.4vw, 30px);
      max-width: 720px;
    }
    .hero-a__eyebrow {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 2vw, 26px);
      line-height: 1.4;
      /* Dunkles Plum (AAA-Kontrast auf Cream) statt zartem Bronze —
         kleine italic-Schrift muss klar lesbar sein. */
      color: var(--text-body);
      margin: 0;
    }
    .hero-a__title {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 7vw, 5.4rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-a__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-a__subtitle {
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      /* text-body statt accent-hover — kleine Caps-Schrift braucht
         klaren Kontrast, nicht „edlen" Bronze-Schimmer. */
      color: var(--text-body);
      margin: 0;
    }
    .hero-a__cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: clamp(8px, 1vw, 16px);
    }
    .hero--a .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 6px 18px -6px rgba(200, 154, 120, 0.45);
    }
    .hero--a .btn--primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .hero--a .btn--ghost.btn--fresh {
      background: transparent;
      border-width: 1.5px;
      box-shadow: none;
    }
    /* Foto-Karte als ruhiger Komposition-Anker rechts (Mobile:
       oben). Portrait-Format auf Desktop (4:5), Landscape auf
       Mobile (5:4) — beides bewährte Editorial-Cover-Proportionen.
       Sanfter Schatten gibt der Karte Schwebe ohne Foto zu dunkeln. */
    .hero-a__photo {
      width: 100%;
      aspect-ratio: 5 / 4;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      background-repeat: no-repeat;
      border-radius: clamp(14px, 2.6vw, 22px);
      filter: saturate(0.95);
      box-shadow:
        0 30px 60px -24px rgba(45, 36, 53, 0.28),
        0 12px 24px -12px rgba(45, 36, 53, 0.14);
    }
    @media (min-width: 900px) {
      .hero-a__photo {
        aspect-ratio: 4 / 5;
        border-radius: clamp(18px, 2vw, 26px);
      }
    }

    /* ============================================================
       VARIANT B — Editorial mit dezentem Bild-Hauch
       Cream-Hintergrund, dazu ein zarter Sonnenblumen-Wash rechts
       (sehr niedrige Opazität, weicher Blur, weicher Maske-Rand).
       Vom Bild nur „ein Hauch" zu sehen — die Stimmung trägt, das
       Foto drängt sich nicht auf (Katharina · 18.05.).
       ============================================================ */
    .hero--b {
      position: relative;
      background: var(--bg-base);
      padding: clamp(80px, 11vw, 140px) 0 clamp(72px, 9vw, 120px);
      min-height: auto;
      overflow: hidden;
      isolation: isolate;
    }
    .hero--b::before,
    .hero--b::after {
      display: none;
      content: none;
    }
    /* Bild rechts — scharf, ohne Blur, ohne Brightness-Wash. Linker
       Rand verläuft graduell ins Cream über eine lineare Mask. Rechts
       voll opak, links transparent, dazwischen gleichmäßiger Verlauf.
       (Katharina · 18.05.: „rechts deutlich sichtbar, dann gradueller
       Verlauf ins Weiße"). */
    .hero-b__photo-hint {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 50%;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: saturate(0.95);
      opacity: 1;
      /* Linearer Verlauf: links cream-transparent, rechts voll opak.
         Mittelpunkt etwas zur rechten Hälfte verschoben (60 %) — gibt
         der Text-Säule links spürbar mehr cream-Atmung, bevor das
         Bild aufkommt. */
      mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.35) 35%,
          rgba(0, 0, 0, 0.85) 75%,
          rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.35) 35%,
          rgba(0, 0, 0, 0.85) 75%,
          rgba(0, 0, 0, 1) 100%);
      pointer-events: none;
      z-index: 0;
    }
    .hero-b__inner {
      position: relative;
      z-index: 1;
    }
    .hero-b__text {
      max-width: 720px;
    }
    .hero-b__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 2vw, 26px);
      color: var(--accent-hover);
      margin-bottom: clamp(24px, 2.8vw, 36px);
      letter-spacing: 0.01em;
      line-height: 1.4;
    }
    .hero-b__title {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 7vw, 5.6rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-b__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-b__subtitle {
      margin-top: clamp(24px, 3vw, 36px);
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-hover);
    }
    .hero-b__cta-row {
      margin-top: clamp(28px, 3.5vw, 44px);
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }
    /* Auf schmalen Viewports den Bild-Hauch nach unten verschieben
       und kleiner halten — sonst zieht er auf Mobile zu viel
       Aufmerksamkeit auf sich. */
    @media (max-width: 720px) {
      .hero-b__photo-hint {
        top: auto;
        right: -20%;
        bottom: -10%;
        width: 80%;
        height: 60%;
        opacity: 0.16;
      }
    }

    /* ============================================================
       VARIANT C — Cinematic
       ============================================================ */
    .hero--c {
      position: relative;
      padding: 0;
      min-height: clamp(580px, 88vh, 880px);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }
    .hero--c::before,
    .hero--c::after {
      display: none;
      content: none;
    }
    .hero-c__image {
      position: absolute;
      inset: 0;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: saturate(0.92) contrast(1.02);
      z-index: -2;
    }
    .hero-c__vignette {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 120% 90% at 50% 35%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.35) 75%,
          rgba(0, 0, 0, 0.55) 100%),
        linear-gradient(180deg,
          rgba(0, 0, 0, 0.30) 0%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.0) 60%,
          rgba(0, 0, 0, 0.70) 100%);
      z-index: -1;
    }
    .hero-c__content {
      padding: clamp(60px, 9vw, 120px) 0 clamp(56px, 8vw, 100px);
      max-width: 1080px;
      color: #fff;
    }
    .hero-c__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      /* Eyebrow auf cinematic ist klein-italic über dem Bild — größer
         und mit dickerem Plum-Schatten, damit er nicht zwischen den
         hellen Sonnenblumen-Glanzlichtern verloren geht. */
      font-size: clamp(20px, 1.8vw, 26px);
      color: rgba(251, 246, 243, 0.98);
      margin-bottom: clamp(20px, 2.4vw, 32px);
      text-shadow:
        0 1px 4px rgba(0, 0, 0, 0.75),
        0 2px 14px rgba(0, 0, 0, 0.60),
        0 0 22px rgba(0, 0, 0, 0.35);
    }
    .hero-c__title {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 7.4vw, 6rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      font-weight: 400;
      color: rgba(251, 246, 243, 0.98);
      margin: 0;
      text-shadow: 0 4px 28px rgba(0, 0, 0, 0.55);
    }
    .hero-c__title em {
      font-style: italic;
      color: #8fc4dc;
      font-weight: 500;
    }
    .hero-c__subtitle {
      margin-top: clamp(20px, 2.6vw, 32px);
      font-family: var(--font-display);
      font-size: clamp(20px, 2vw, 26px);
      color: rgba(251, 246, 243, 0.92);
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
      max-width: 640px;
    }
    .hero-c__cta-row {
      margin-top: clamp(32px, 4vw, 48px);
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }
    .hero--c .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow:
        0 10px 30px -8px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.20);
    }
    .hero--c .btn--ghost.btn--fresh {
      background: rgba(251, 246, 243, 0.18);
      color: #fff;
      border-color: rgba(251, 246, 243, 0.6);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .hero--c .btn--ghost.btn--fresh:hover {
      background: rgba(251, 246, 243, 0.92);
      color: var(--text-primary);
    }

    /* ============================================================
       VARIANT C2 — Cinematic · Bild gedämpft
       Identisch zu C, plus ein zusätzlicher dunkler Dim-Layer
       (40 %) über dem scharfen Foto. Das Bild bleibt voll
       fokussiert (kein Blur, keine Sättigungs-Wäsche), nur das
       Helligkeits-Niveau wird gleichmäßig gesenkt — die helle
       Cream-Schrift trägt damit ohne Lesbarkeits-Risiko.
       ============================================================ */
    .hero--c2 {
      position: relative;
      padding: 0;
      min-height: clamp(580px, 88vh, 880px);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
    }
    .hero--c2::before,
    .hero--c2::after {
      display: none;
      content: none;
    }
    .hero-c2__image {
      position: absolute;
      inset: 0;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: saturate(0.92) contrast(1.02);
      z-index: -3;
    }
    /* Dim-Layer · gleichmäßige Helligkeits-Senkung. */
    .hero-c2__dim {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.42);
      z-index: -2;
    }
    /* Vignette identisch zu C — sanfter dunkler Rand, betont
       Komposition zur Mitte hin. */
    .hero-c2__vignette {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 120% 90% at 50% 35%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.25) 75%,
          rgba(0, 0, 0, 0.40) 100%),
        linear-gradient(180deg,
          rgba(0, 0, 0, 0.20) 0%,
          rgba(0, 0, 0, 0.0) 30%,
          rgba(0, 0, 0, 0.0) 60%,
          rgba(0, 0, 0, 0.55) 100%);
      z-index: -1;
    }
    .hero-c2__content {
      padding: clamp(60px, 9vw, 120px) 0 clamp(56px, 8vw, 100px);
      max-width: 1080px;
      color: #fff;
    }
    .hero-c2__eyebrow {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 1.8vw, 26px);
      color: rgba(251, 246, 243, 0.98);
      margin-bottom: clamp(20px, 2.4vw, 32px);
      text-shadow:
        0 1px 4px rgba(0, 0, 0, 0.70),
        0 2px 14px rgba(0, 0, 0, 0.50);
    }
    .hero-c2__title {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 7.4vw, 6rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      font-weight: 400;
      color: rgba(251, 246, 243, 0.98);
      margin: 0;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    }
    .hero-c2__title em {
      font-style: italic;
      color: #8fc4dc;
      font-weight: 500;
    }
    .hero-c2__subtitle {
      margin-top: clamp(20px, 2.6vw, 32px);
      font-family: var(--font-display);
      font-size: clamp(20px, 2vw, 26px);
      color: rgba(251, 246, 243, 0.95);
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.50);
      max-width: 640px;
    }
    .hero-c2__cta-row {
      margin-top: clamp(32px, 4vw, 48px);
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }
    .hero--c2 .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow:
        0 10px 30px -8px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.20);
    }
    .hero--c2 .btn--ghost.btn--fresh {
      background: rgba(251, 246, 243, 0.18);
      color: #fff;
      border-color: rgba(251, 246, 243, 0.6);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .hero--c2 .btn--ghost.btn--fresh:hover {
      background: rgba(251, 246, 243, 0.92);
      color: var(--text-primary);
    }

    /* ============================================================
       VARIANT D — Split-Layout · klare Trennung
       Desktop: 50/50-Grid, links voll-bleed Sonnenblume, rechts
       Cream-Textspalte mit linksbündigem Inhalt. Klare vertikale
       Kante, keine Soft-Fade-Masken, keine Verspieltheit.
       Mobile: Stack — Foto oben (4:3), Text drunter.
       ============================================================ */
    .hero--d {
      display: grid;
      grid-template-columns: 1fr;
      background: var(--bg-base);
      overflow: hidden;
      isolation: auto;
      padding: 0;
      min-height: auto;
    }
    .hero--d::before,
    .hero--d::after {
      display: none;
      content: none;
    }
    @media (min-width: 900px) {
      .hero--d {
        /* Text-Säule bekommt mehr Platz als das Bild — die Sonnen-
           blume soll Akzent setzen, nicht dominieren. (Katharina ·
           18.05.: „Bild ist viel zu dominant, Text gequetscht"). */
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        min-height: clamp(560px, 80vh, 760px);
      }
      /* Spalten gedreht: Text LINKS, Bild RECHTS — HTML-Reihenfolge
         bleibt (Bild zuerst, damit auf Mobile das Foto oben sitzt),
         auf Desktop via grid-column-Override umsortiert. */
      .hero-d__text {
        grid-column: 1;
        grid-row: 1;
      }
      .hero-d__image {
        grid-column: 2;
        grid-row: 1;
      }
    }
    /* Bild-Spalte — voll-bleed, klare Kante. */
    .hero-d__image {
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      background-repeat: no-repeat;
      aspect-ratio: 4 / 3;
      filter: saturate(0.95);
    }
    @media (min-width: 900px) {
      .hero-d__image {
        aspect-ratio: auto;
      }
    }
    /* Text-Spalte — ruhige Cream-Säule, linksbündig, vertikal
       zentriert. Alle Texte dunkel auf Cream → garantiert lesbar.
       Großzügiges max-width (720) + viel horizontales Padding sorgen
       für Atmung. */
    .hero-d__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(22px, 2.6vw, 34px);
      padding: clamp(56px, 8vw, 104px) clamp(28px, 6vw, 88px);
      max-width: 720px;
    }
    .hero-d__eyebrow {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 1.9vw, 24px);
      line-height: 1.4;
      color: var(--accent-hover);
      margin: 0;
    }
    .hero-d__title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5.6vw, 4.4rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-d__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-d__subtitle {
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-hover);
      margin: 0;
    }
    .hero-d__cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: clamp(8px, 1vw, 16px);
    }
    .hero--d .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 6px 18px -6px rgba(200, 154, 120, 0.45);
    }
    .hero--d .btn--primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .hero--d .btn--ghost.btn--fresh {
      background: transparent;
      border-width: 1.5px;
      box-shadow: none;
    }
  </style>
</BaseLayout>
