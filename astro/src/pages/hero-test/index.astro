---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Hero-Vergleich (interne Abstimmung mit Katharina · 18.05.).
 * Drei Hero-Konzepte untereinander, nicht in der Navigation verlinkt:
 *   A — Aktuelle Linie (Cream-Glas-Box auf weichem Foto)
 *   B — Editorial (Cream-First, Foto als Polaroid-Akzent)
 *   C — Cinematic (Vollbild-Foto klar, Minimal-Text-Overlay)
 *
 * Diese Seite ist eine Diskussionsbasis. Wenn die Entscheidung
 * gefallen ist, kann sie gelöscht werden — bis dahin URL teilen
 * für externes Feedback.
 */
---

<BaseLayout
  title="Hero-Vergleich · WERKSTATT Gemeinschaft"
  description="Interne Hero-Konzept-Abstimmung — drei Entwürfe zur Auswahl"
>
  {/* ============================================================
     VARIANT I — Atelier als Hintergrund-Hauch, Text-Insel
     Bild deckt fast die ganze Breite ab, ABER linke ~55 % sind mit
     einer kräftigen Cream-Maske überdeckt — der Text sitzt wie eine
     ruhige Insel im Cream, das Atelier scheint nur durch den rechten
     Bildausschnitt durch. Mobile: Bild fadet komplett ins Cream
     (Stack mit zarter Hintergrundandeutung).
     ============================================================ */}
  <section class="hero hero--i">
    <span class="hero-num" aria-hidden="true">I</span>
    <div class="hero-i__image" role="img" aria-label="Sabines Töpferatelier — Helga mit hochgesteckten Haaren rechts modelliert eine Tonfigur"></div>
    <div class="container hero-i__inner">
      <div class="hero-i__text">
        <span class="hero-i__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-i__title">
          Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-i__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
        <div class="hero-i__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT H — Atelier dominanter (60/40), breitere Verschleierung
     Bild nimmt ~60 % rechts ein, Text-Säule schmaler (40 %). Maske
     fließt weiter ins Bild hinein — Werkstatt-Stimmung wird stärker
     spürbar, der Text bleibt aber durch ruhige Cream-Säule garantiert
     lesbar. Mobile: Stack wie G.
     ============================================================ */}
  <section class="hero hero--h">
    <span class="hero-num" aria-hidden="true">H</span>
    <div class="hero-h__text">
      <span class="hero-h__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-h__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-h__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
      <div class="hero-h__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
    <div class="hero-h__image" role="img" aria-label="Sabines Töpferatelier — Helga mit hochgesteckten Haaren rechts modelliert eine Tonfigur"></div>
  </section>

  {/* ============================================================
     VARIANT G — Atelier rechts, weiche Verschleierung links
     Katharinas Idee · 19.05.: „halben Hero rechts für das Werkstatt-
     bild — Helga rechts ist es bestimmt recht, Türkis dabei. Das
     linke Bild-Ende verschleiern, damit der Text-Bereich darin
     atmen kann." Klassisches 50/50 (Text links auf Cream, Atelier-
     Bild rechts mit linearer Soft-Mask am linken Rand). Mobile:
     Stack — Bild oben (16/10), Text drunter auf Cream.
     ============================================================ */}
  <section class="hero hero--g">
    <span class="hero-num" aria-hidden="true">G</span>
    <div class="hero-g__text">
      <span class="hero-g__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-g__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-g__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
      <div class="hero-g__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
    <div class="hero-g__image" role="img" aria-label="Sabines Töpferatelier — Helga mit hochgesteckten Haaren rechts modelliert eine Tonfigur"></div>
  </section>

  {/* ============================================================
     VARIANT F — Magazin-Split · Bild links, Cream rechts
     Desktop: 1.45 / 1-Grid, links voll-bleed Wandergruppe-Foto,
     rechts ruhige Cream-Säule mit Text. Klare vertikale Kante,
     keine Soft-Fade-Masken. Bild bekommt mehr Raum, weil das
     Panorama es trägt — Text-Säule bleibt schmal-elegant.
     Mobile: Stack — Bild oben (16:9), Text drunter.
     ============================================================ */}
  <section class="hero hero--f">
    <span class="hero-num" aria-hidden="true">F</span>
    <div class="hero-f__image" role="img" aria-label="Wandergruppe in einer Schlucht, Kreta"></div>
    <div class="hero-f__text">
      <span class="hero-f__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-f__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-f__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
      <div class="hero-f__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT E — Panorama · Foto oben, Cream-Block drunter
     Wandergruppe-Foto (bewegBAR) als full-bleed Panorama-Band
     oben — die Erzählung „gemeinsam einen Weg gehen" trägt
     das ganze Bild. Darunter Cream-Block mit Text, linksbündig
     in der Container-Breite. Alle Texte auf Cream → garantiert
     lesbar, keine Overlay-Tricks.
     Desktop: Bild 21:9, Text drunter. Mobile: Bild 4:3, Text drunter.
     ============================================================ */}
  <section class="hero hero--e">
    <span class="hero-num" aria-hidden="true">E</span>
    <div class="hero-e__image" role="img" aria-label="Wandergruppe in einer Schlucht, Kreta"></div>
    <div class="hero-e__panel">
      <div class="container hero-e__inner">
        <span class="hero-e__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-e__title">
          Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-e__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
        <div class="hero-e__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT D — Split-Layout · klare Trennung
     Desktop: 50/50-Grid, links voll-bleed Sonnenblume, rechts
     ruhige Cream-Säule mit Text. Klare vertikale Kante, keine
     Soft-Fade-Masken, keine Verspieltheit. Alle Texte auf Cream
     → garantiert lesbar. Mobile: Stack, Foto oben (4:3), Text
     darunter auf Cream.
     ============================================================ */}
  <section class="hero hero--d">
    <span class="hero-num" aria-hidden="true">D</span>
    <div class="hero-d__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-d__text">
      <span class="hero-d__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-d__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-d__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
      <div class="hero-d__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT C2 — Cinematic · Bild gedämpft
     Wie C, aber zusätzlich ein dunkler Dim-Layer über dem Foto.
     Bild bleibt scharf (kein Blur), wird aber gleichmäßig
     abgedunkelt — die helle Cream-Schrift trägt damit klar.
     ============================================================ */}
  <section class="hero hero--c2">
    <span class="hero-num" aria-hidden="true">C2</span>
    <div class="hero-c2__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-c2__dim" aria-hidden="true"></div>
    <div class="hero-c2__vignette" aria-hidden="true"></div>
    <div class="container hero-c2__content">
      <span class="hero-c2__eyebrow">— GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-c2__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-c2__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-c2__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT C — Cinematic
     Vollbild-Foto in voller Schärfe (kein Blur), dezente Vignette.
     Headlines + Subtitle als heller Cream-Text auf dem Bild,
     dramatisch-cinematic.
     ============================================================ */}
  <section class="hero hero--c">
    <span class="hero-num" aria-hidden="true">C</span>
    <div class="hero-c__image" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    <div class="hero-c__vignette" aria-hidden="true"></div>
    <div class="container hero-c__content">
      <span class="hero-c__eyebrow">— GemeinschaftsWERK statt allein unterwegs</span>
      <h1 class="hero-c__title">
        Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
      </h1>
      <p class="hero-c__subtitle">
        Reisen · Werkstätten · Notizen · Fotos
      </p>
      <div class="hero-c__cta-row">
        <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
        <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT B — Editorial / Brief-von-unterwegs
     Cream-Hintergrund, kein Foto-Background. Sehr große Cormorant-
     Typo links, ein kleines Polaroid-Foto rechts als Akzent. Wie
     ein Brief, ruhig, literarisch.
     ============================================================ */}
  <section class="hero hero--b">
    <span class="hero-num" aria-hidden="true">B</span>
    <div class="hero-b__photo-hint" aria-hidden="true"></div>
    <div class="container hero-b__inner">
      <div class="hero-b__text">
        <span class="hero-b__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-b__title">
          Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-b__subtitle">
          Reisen · Werkstätten · Notizen · Fotos
        </p>
        <div class="hero-b__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     VARIANT A — Editorial · Headline + Foto-Karte
     Cream-Hintergrund, links Text-Säule (Eyebrow + zweifarbige
     Headline + Subtitle + CTAs), rechts eine Portrait-Foto-Karte
     (4:5, gerundete Ecken, dezenter Schatten). Alle Texte sitzen
     auf Cream und sind damit garantiert lesbar — keine Glas-Box-
     Tricks, kein Foto-Hintergrund, keine Lesbarkeits-Lottos.
     Mobile: Stack, Foto-Karte oben im 5:4-Format.
     ============================================================ */}
  <section class="hero hero--a">
    <span class="hero-num" aria-hidden="true">A</span>
    <div class="container hero-a__grid">
      <div class="hero-a__text">
        <span class="hero-a__eyebrow">GemeinschaftsWERK statt allein unterwegs</span>
        <h1 class="hero-a__title">
          Auf der Suche —<br />wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-a__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
        <div class="hero-a__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">In die schreibBAR →</a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
      <div class="hero-a__photo" role="img" aria-label="Sonnenblume mit Biene, Kreta"></div>
    </div>
  </section>

  <style>
    /* ========== Info-Banner oben ========== */
    .vergleich-info {
      background: #2d2435;
      color: rgba(255, 255, 255, 0.9);
      padding: 18px 0;
      font-size: 14px;
    }
    .vergleich-label {
      max-width: 760px;
      margin: 0;
      line-height: 1.55;
    }
    /* Hero-Marker: ein einzelner Buchstabe als reines Overlay-Zeichen,
       ohne Box, ohne Hintergrund, ohne Padding — kein Millimeter Platz
       im Layout. Sitzt absolute oben rechts. Subtiler text-shadow gegen
       Foto-Hintergrund, damit das Zeichen auch auf hellen UND dunklen
       Bereichen erkennbar bleibt. */
    .hero { position: relative; }
    .hero-num {
      position: absolute;
      top: 12px;
      right: 14px;
      z-index: 8;
      font-family: var(--font-text);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.22em;
      color: rgba(45, 36, 53, 0.4);
      text-shadow: 0 1px 2px rgba(251, 246, 243, 0.7);
      pointer-events: none;
      user-select: none;
    }
    /* Auf Mobile sitzen bei A/G/H der Text oben und das Bild unten
       (Stack). Damit der Marker auf dem Bild landet, nicht im leeren
       Cream-Bereich des Text-Headers, schalten wir auf bottom-right.
       Plus: invertiertes Farb-Schema — heller Marker mit dunklem
       Schatten, damit er auf dem Foto-Hintergrund lesbar bleibt. */
    @media (max-width: 899px) {
      .hero--a .hero-num,
      .hero--g .hero-num,
      .hero--h .hero-num {
        top: auto;
        bottom: 12px;
        color: rgba(251, 246, 243, 0.85);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
      }
    }
    /* Variant C/C2/I haben das Foto immer im Hintergrund (auch
       Desktop) — Marker oben rechts braucht hellen Kontrast. */
    .hero--c .hero-num,
    .hero--c2 .hero-num,
    .hero--i .hero-num {
      color: rgba(251, 246, 243, 0.85);
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
    }
    /* Subtle Trenner zwischen Heros — eine zarte Cream-Linie, kein
       voller Streifen mehr. Hilft das Auge, einzelne Heros von oben
       bis unten zu unterscheiden. */
    .hero + .hero,
    [class*="hero--"] + [class*="hero--"] {
      border-top: 1px solid rgba(45, 36, 53, 0.08);
    }
    /* Auf Mobile soll jeder Hero die volle Viewport-Höhe füllen
       (abzüglich Site-Header ~73 px), damit jeder Entwurf als
       eigenständiger Vollbild-Eindruck wirkt — keine halbe Höhe
       mehr, kein bereits-sichtbarer-Nachbar-Hero unter dem Fold. */
    @media (max-width: 899px) {
      .hero {
        min-height: calc(100vh - 73px);
        display: flex;
        flex-direction: column;
      }
    }
    /* Typografische Hygiene auf allen Hero-Titles: text-wrap pretty
       lässt den Browser bessere Umbrüche wählen (kein „— wie" allein
       am Zeilenende), hyphens manual blockt unschöne Worttrennung
       automatischer Hyphenation. nbsp im HTML hält Em-dash + „wie"
       als atomic Block — Em-dash steht so nie alleine am Zeilen-Ende. */
    [class*="hero-"][class*="__title"] {
      text-wrap: pretty;
      hyphens: manual;
    }
    .hero--b, .hero--c, .hero--c2, .hero--d {
      content-visibility: auto;
      contain-intrinsic-size: auto 100vh;
    }

    /* ============================================================
       VARIANT A — Editorial · Headline + Foto-Karte
       Cream-Hintergrund, klare 2-Spalten-Komposition auf Desktop
       (Text links, Foto-Karte rechts), Stack auf Mobile (Foto-
       Karte oben, Text drunter). Alle Texte sitzen auf Cream —
       keine Lesbarkeits-Tricks nötig.
       Globale .hero-Styles (full-bleed-bg via ::before, fix min-
       height) werden für .hero--a komplett deaktiviert.
       ============================================================ */
    .hero--a {
      background: var(--bg-base);
      padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 100px);
      min-height: auto;
      overflow: visible;
      isolation: auto;
    }
    .hero--a::before,
    .hero--a::after {
      display: none;
      content: none;
    }
    .hero-a__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(36px, 5vw, 64px);
      align-items: center;
    }
    @media (min-width: 900px) {
      .hero-a__grid {
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: clamp(48px, 6vw, 96px);
      }
    }
    .hero-a__text {
      display: flex;
      flex-direction: column;
      gap: clamp(20px, 2.4vw, 30px);
      max-width: 720px;
    }
    .hero-a__eyebrow {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(20px, 2vw, 26px);
      line-height: 1.4;
      /* Dunkles Plum (AAA-Kontrast auf Cream) statt zartem Bronze —
         kleine italic-Schrift muss klar lesbar sein. */
      color: var(--text-body);
      margin: 0;
    }
    .hero-a__title {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 7vw, 5.4rem);
      line-height: 1.05;
      letter-spacing: -0.018em;
      font-weight: 400;
      color: var(--text-primary);
      margin: 0;
    }
    .hero-a__title em {
      font-style: italic;
      color: var(--accent-blue);
      font-weight: 500;
    }
    .hero-a__subtitle {
      font-family: var(--font-text);
      font-size: clamp(13px, 1.1vw, 15px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      /* text-body statt accent-hover — kleine Caps-Schrift braucht
         klaren Kontrast, nicht „edlen" Bronze-Schimmer. */
      color: var(--text-body);
      margin: 0;
    }
    .hero-a__cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: clamp(8px, 1vw, 16px);
    }
    .hero--a .btn--primary {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 6px 18px -6px rgba(200, 154, 120, 0.45);
    }
    .hero--a .btn--primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .hero--a .btn--ghost.btn--fresh {
      background: transparent;
      border-width: 1.5px;
      box-shadow: none;
    }
    /* Foto-Karte als ruhiger Komposition-Anker rechts (Mobile:
       oben). Portrait-Format auf Desktop (4:5), Landscape auf
       Mobile (5:4) — beides bewährte Editorial-Cover-Proportionen.
       Sanfter Schatten gibt der Karte Schwebe ohne Foto zu dunkeln. */
    .hero-a__photo {
      width: 100%;
      aspect-ratio: 5 / 4;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      background-repeat: no-repeat;
      border-radius: clamp(14px, 2.6vw, 22px);
      filter: saturate(0.95);
      box-shadow:
        0 30px 60px -24px rgba(45, 36, 53, 0.28),
        0 12px 24px -12px rgba(45, 36, 53, 0.14);
    }
    @media (min-width: 900px) {
      .hero-a__photo {
        aspect-ratio: 4 / 5;
        border-radius: clamp(18px, 2vw, 26px);
      }
    }

    /* ============================================================
       VARIANT B — Editorial mit dezentem Bild-Hauch
       Cream-Hintergrund, dazu ein zarter Sonnenblumen-Wash rechts
       (sehr niedrige Opazität, weicher Blur, weicher Maske-Rand).
       Vom Bild nur „ein Hauch" zu sehen — die Stimmung trägt, das
       Foto drängt sich nicht auf (Katharina · 18.05.).
       ============================================================ */
    .hero--b {
      position: relative;
      background: var(--bg-base);
      padding: clamp(80px, 11vw, 140px) 0 clamp(72px, 9vw, 120px);
      min-height: auto;
      overflow: hidden;
      isolation: isolate;
    }
    .hero--b::before,
    .hero--b::after {
      display: none;
      content: none;
    }
    /* Bild rechts — scharf, ohne Blur, ohne Brightness-Wash. Linker
       Rand verläuft graduell ins Cream über eine lineare Mask. Rechts
       voll opak, links transparent, dazwischen gleichmäßiger Verlauf.
       (Katharina · 18.05.: „rechts deutlich sichtbar, dann gradueller
       Verlauf ins Weiße"). */
    .hero-b__photo-hint {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 50%;
      background-image: url('/hero/sonnenblume.jpg');
      background-size: cover;
      background-position: center 45%;
      filter: saturate(0.95);
      opacity: 1;
      /* Linearer Verlauf: links cream-transparent, rechts voll opak.
         Mittelpunkt etwas zur rechten Hälfte verschoben (60 %) — gibt
         der Text-Säule links spürbar mehr cream-Atmung, bevor das
         Bild aufkommt. */
      mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.35) 35%,
          rgba(0, 0, 0, 0.85) 75%,
          rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right,
          transparent 0%,
          rgba(0, 0, 0, 0.35) 35%,
          rgba(0, 0, 0, 0.85) 75%,
          rgba(0, 0, 0, 1) 100%);
      pointer-events: none;
      z-index: 0;
    }
    .hero-b__inner {
      position: relative;
      z-index: 1;
    }
    .hero-b__text {
      max-width: 720px;
    }
    .hero-b__eyebrow {
      display: inline-block;
