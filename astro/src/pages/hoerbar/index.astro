---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShare from '../../components/PageShare.astro';
import PageBanner from '../../components/PageBanner.astro';
import ListFilter from '../../components/ListFilter.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';
import { withSafeSlugs } from '../../lib/slug.js';

let episodes: any[] = [];
if (isSanityConfigured) {
  episodes = await sanity.fetch(`
    *[_type == "episode"] | order(publishedAt desc) {
      _id, episodeNumber, title, kind, platform, url, publishedAt,
      "slug": slug.current,
      "thumb": cover { asset->{ url } }
    }
  `);
  /* Gleiche Slug-Absicherung wie in hoerbar/[slug].astro — sonst zeigt
     die Liste auf eine Adresse, die es dort nicht gibt. */
  episodes = withSafeSlugs(episodes);
}

/* Kennzeichnung der Episoden-Art — analog zu Notiz/Poesie in der schreibBAR.
   Alte Episoden ohne `kind` zeigen einfach kein Label. */
const KIND_LABELS: Record<string, string> = {
  gespraech: 'Gespräch',
  vortrag: 'Vortrag',
  gedicht: 'Gedicht',
  lied: 'Lied',
  reflexion: 'Reflexion',
};

/* Art-Filter: erscheint erst ab FILTER_THRESHOLD Episoden automatisch
   (darunter würde er eher leer wirken). Zeigt nur Arten, die es wirklich
   gibt, und nur wenn mindestens zwei verschiedene existieren. */
const FILTER_THRESHOLD = 20;
const KIND_ORDER = ['gespraech', 'vortrag', 'gedicht', 'lied', 'reflexion'];
const kindCounts: Record<string, number> = {};
for (const ep of episodes) {
  if (ep.kind) kindCounts[ep.kind] = (kindCounts[ep.kind] ?? 0) + 1;
}
const filters = KIND_ORDER
  .filter((k) => kindCounts[k])
  .map((k) => ({ value: k, label: KIND_LABELS[k], count: kindCounts[k] }));
const showFilter = episodes.length >= FILTER_THRESHOLD && filters.length >= 2;
---

<BaseLayout title="hörBAR — werkSTATT Gemeinschaft" description="Eingesprochene Reflexionen, Gespräche, Vorträge, Gedichte und Lieder">
  <PageBanner
    photo="photo-1693778259075-c47eda5e4b43"
    alt="Frau hält eine Muschel ans Ohr und blickt aufs Meer"
    position="center 40%"
  />
  <section style="padding: 4rem 0;">
    <div class="container">
      <span class="eyebrow">Audio · Episoden</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); margin: 1rem 0;">
        hör<em>BAR</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--text-secondary); margin-bottom: 1rem;">
        Reflexionen, Gespräche, Vorträge, Gedichte, Lieder
      </p>
      <p style="max-width: 600px; color: var(--text-body);">
        Eingesprochene Gedanken. Plus Gespräche von und mit Menschen, denen
        mehr Gemeinschaft in unserer Gesellschaft am Herzen liegt.
      </p>

      {episodes.length === 0 && (
        <p style="margin-top: 2rem; color: var(--text-secondary);">
          hörBAR · bald — die erste Folge entsteht gerade.
        </p>
      )}

      <div class="filterable">
        {showFilter && <ListFilter filters={filters} total={episodes.length} />}

        <ul style="list-style: none; padding: 0; display: grid; gap: 1.5rem; margin-top: 2rem;">
          {episodes.map((ep, idx) => (
            <li class={`filterable-item${idx >= 8 ? ' is-hidden' : ''}`} data-kind={ep.kind}>
              <a href={`/hoerbar/${ep.slug}/`} style="display: block; padding: 1.5rem; background: var(--bg-elevated); border-radius: 6px; text-decoration: none; color: inherit;">
                <p class="eyebrow">
                  {[
                    ep.episodeNumber && `#${ep.episodeNumber}`,
                    ep.platform,
                    new Date(ep.publishedAt).toLocaleDateString('de-DE'),
                  ].filter(Boolean).join(' · ')}
                </p>
                {ep.kind && KIND_LABELS[ep.kind] && (
                  <span class="entry__tag" data-tag={ep.kind} style="margin-top: 0.5rem;">{KIND_LABELS[ep.kind]}</span>
                )}
                <h3 style="font-family: var(--font-display); margin: 0.5rem 0;">{localized(ep.title)}</h3>
              </a>
            </li>
          ))}
        </ul>

        {episodes.length > 8 && (
          <div class="load-more-wrap">
            <button class="load-more" type="button">Weitere anzeigen ({episodes.length - 8})</button>
          </div>
        )}
      </div>
    </div>
  </section>
  <PageShare title="hörBAR — werkSTATT Gemeinschaft" text="Eingesprochene Reflexionen, Gespräche, Vorträge, Gedichte und Lieder." />
</BaseLayout>
