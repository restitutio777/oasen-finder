---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

let episodes: any[] = [];
if (isSanityConfigured) {
  episodes = await sanity.fetch(`
    *[_type == "episode"] | order(publishedAt desc) {
      _id, episodeNumber, title, platform, url, publishedAt,
      "slug": slug.current,
      "thumb": cover { asset->{ url } }
    }
  `);
}
---

<BaseLayout title="hörBAR — werkSTATT Gemeinschaft" description="Eingesprochene Reflexionen, Gedichte und Lieder">
  <PageBanner
    photo="photo-1693778259075-c47eda5e4b43"
    alt="Frau hält eine Muschel ans Ohr und blickt aufs Meer"
    position="center 40%"
  />
  <section style="padding: 4rem 0;">
    <div class="container">
      <span class="eyebrow">Audio · Episoden</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); margin: 1rem 0;">
        hör<em>BAR</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--text-secondary); margin-bottom: 1rem;">
        Reflexionen, Gedichte, Lieder
      </p>
      <p style="max-width: 600px; color: var(--text-body);">
        Eingesprochene Gedanken. Plus Gespräche mit Menschen, die in
        Gemeinschaft leben
      </p>

      {episodes.length === 0 && (
        <p style="margin-top: 2rem; color: var(--text-secondary);">
          hörBAR · bald — die erste Folge entsteht gerade.
        </p>
      )}

      <ul style="list-style: none; padding: 0; display: grid; gap: 1.5rem; margin-top: 2rem;">
        {episodes.map((ep, idx) => (
          <li class={idx >= 8 ? 'is-hidden' : ''}>
            <a href={`/hoerbar/${ep.slug}/`} style="display: block; padding: 1.5rem; background: var(--bg-elevated); border-radius: 6px; text-decoration: none; color: inherit;">
              <p class="eyebrow">
                {ep.episodeNumber && `#${ep.episodeNumber} · `}
                {ep.platform} · {new Date(ep.publishedAt).toLocaleDateString('de-DE')}
              </p>
              <h3 style="font-family: var(--font-display); margin: 0.5rem 0;">{localized(ep.title)}</h3>
            </a>
          </li>
        ))}
      </ul>

      {episodes.length > 8 && (
        <div class="load-more-wrap">
          <button class="load-more" type="button">Weitere anzeigen ({episodes.length - 8})</button>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
