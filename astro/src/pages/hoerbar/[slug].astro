---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import MediaLink from '../../components/MediaLink.astro';
import ShareButton from '../../components/ShareButton.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';
import { withSafeSlugs } from '../../lib/slug.js';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const eps = await sanity.fetch(`
    *[_type == "episode" && defined(slug.current)] {
      "slug": slug.current, _id, episodeNumber, title, kind, platform, url,
      publishedAt,
      summary,
      "coverUrl": cover.asset->url,
      "audioUrl": audioFile.asset->url,
      "audioMime": audioFile.asset->mimeType,
      "transcriptUrl": transcriptPdf.asset->url
    }
  `);
  // withSafeSlugs: Slug aus Sanity nur übernehmen, wenn er als Adress-
  // Segment taugt — sonst aus dem Titel neu bilden (siehe lib/slug.js).
  return withSafeSlugs(eps).map((ep: any) => ({
    params: { slug: ep.slug },
    props: { episode: ep },
  }));
}

const { episode } = Astro.props;

const episodeTitle = localized(episode.title) || 'Episode';

/* Kennzeichnung der Episoden-Art — analog zur schreibBAR. */
const KIND_LABELS: Record<string, string> = {
  gespraech: 'Gespräch',
  vortrag: 'Vortrag',
  gedicht: 'Gedicht',
  lied: 'Lied',
  reflexion: 'Reflexion',
};
const kindLabel = episode.kind ? KIND_LABELS[episode.kind] : undefined;
// OG-Image: Cover, wenn vorhanden — sonst greift BaseLayouts eigener
// Marken-Default (kein Unsplash-Fallback mehr, 03.07.).
const ogImage = episode.coverUrl
  ? `${episode.coverUrl}?w=1200&h=630&fit=crop&auto=format&q=85`
  : undefined;
---

<BaseLayout
  title={`${episodeTitle} — hörBAR`}
  description={[
    `hörBAR-Episode${episode.episodeNumber ? ` #${episode.episodeNumber}` : ''}`,
    kindLabel,
    episode.platform && `auf ${episode.platform}`,
  ].filter(Boolean).join(' · ')}
  image={ogImage}
  ogType="article"
>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <a href="/hoerbar/" style="color: var(--accent); font-size: 14px;">← Zurück zur hörBAR</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">
        {[
          'hörBAR',
          episode.episodeNumber && `#${episode.episodeNumber}`,
          kindLabel,
          episode.platform,
        ].filter(Boolean).join(' · ')}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">
        {localized(episode.title)}
      </h1>
      <p style="color: var(--text-secondary); font-size: 14px;">
        {new Date(episode.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>

      {episode.coverUrl && (
        <img src={episode.coverUrl} alt="" style="max-width: 400px; margin: 2rem 0; border-radius: 6px;" loading="lazy" decoding="async" />
      )}

      {/* Audio-Player-Priorität:
          1. Wenn audioFile gesetzt → eigener HTML5-Player im Brand-Look
             (datenschutzfreundlich, kein Plattform-Cookie)
          2. Falls zusätzlich URL gesetzt → kleine „auch auf X hören"-Zeile
          3. Wenn nur URL → klassisches Embed (YouTube/Spotify/Apple/etc.) */}
      {episode.audioUrl ? (
        <>
          <figure class="hoerbar-player">
            <audio
              controls
              preload="metadata"
              src={episode.audioUrl}
              style="width: 100%; max-width: 720px; border-radius: 8px;"
            >
              Dein Browser kann diese Audio-Datei leider nicht abspielen.
              <a href={episode.audioUrl}>Direkt herunterladen</a>
            </audio>
            <figcaption style="font-size: 13px; color: var(--text-secondary); margin-top: 0.5rem;">
              Hörzeit · direkt auf der Seite — kein externes Konto nötig
            </figcaption>
          </figure>
          {episode.url && episode.platform !== 'direkt' && (
            <p style="margin-top: 1rem; font-size: 14px;">
              Auch hörbar auf <a href={episode.url} target="_blank" rel="noopener" style="color: var(--accent);">{episode.platform === 'youtube' ? 'YouTube' : episode.platform === 'spotify' ? 'Spotify' : episode.platform === 'applemusic' ? 'Apple Music' : episode.platform} →</a>
            </p>
          )}
        </>
      ) : episode.url ? (
        <MediaLink url={episode.url} label={`Auf ${episode.platform} öffnen`} />
      ) : null}

      <div style="margin-top: 2rem;">
        <PortableText value={episode.summary} />
      </div>

      {episode.transcriptUrl && (
        <p style="margin-top: 2rem;">
          <a href={episode.transcriptUrl} target="_blank" rel="noopener">Transkript (PDF) →</a>
        </p>
      )}

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
        <ShareButton title={episodeTitle} />
      </div>
    </div>
  </article>
</BaseLayout>
