---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const eps = await sanity.fetch(`
    *[_type == "episode" && defined(slug.current)] {
      "slug": slug.current, _id, episodeNumber, title, platform, url,
      publishedAt, summary,
      "coverUrl": cover.asset->url,
      "transcriptUrl": transcriptPdf.asset->url
    }
  `);
  return eps.map((ep: any) => ({ params: { slug: ep.slug }, props: { episode: ep } }));
}

const { episode } = Astro.props;
---

<BaseLayout title={`${localized(episode.title) || 'Episode'} — HörBAR`}>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <a href="/hoerbar/" style="color: var(--accent-warm); font-size: 14px;">← Zurück zur HörBAR</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">
        HörBAR {episode.episodeNumber && `· #${episode.episodeNumber}`} · {episode.platform}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem;">
        {localized(episode.title)}
      </h1>
      <p style="color: var(--text-secondary); font-size: 14px;">
        {new Date(episode.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>

      {episode.coverUrl && (
        <img src={episode.coverUrl} alt="" style="max-width: 400px; margin: 2rem 0; border-radius: 6px;" />
      )}

      {/* TODO: Embed je nach Plattform (YouTube iframe, Spotify embed, Apple Music embed).
           Für jetzt: einfacher Link. */}
      <p style="margin-top: 2rem;">
        <a href={episode.url} target="_blank" rel="noopener" class="btn btn--primary">
          Auf {episode.platform} hören →
        </a>
      </p>

      <div style="margin-top: 2rem; font-family: var(--font-display); font-size: 18px; line-height: 1.7;">
        <p><em>(PortableText-Renderer für die Summary kommt im Folge-Commit.)</em></p>
      </div>

      {episode.transcriptUrl && (
        <p style="margin-top: 2rem;">
          <a href={episode.transcriptUrl} target="_blank" rel="noopener">Transkript (PDF) →</a>
        </p>
      )}
    </div>
  </article>
</BaseLayout>
