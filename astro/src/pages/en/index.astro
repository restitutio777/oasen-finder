---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="werkSTATT Gemeinschaft — English version (coming)"
  description="English version coming soon"
  locale="en"
>
  <section style="padding: 6rem 0; text-align: center; max-width: 560px; margin: 0 auto;">
    <div class="container">
      <span class="eyebrow">English · coming soon</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 1rem 0 1.5rem;">
        Soon in <em style="color: var(--accent-gold);">English</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: 19px; line-height: 1.6; color: var(--text-body);">
        The English version will be available once Katharina has translated
        the first content. In the meantime, visit
        <a href="/" style="color: var(--accent-gold);">the German version</a>.
      </p>
    </div>
  </section>
</BaseLayout>
