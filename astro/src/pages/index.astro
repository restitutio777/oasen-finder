---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { sanity, localized, isSanityConfigured } from '../lib/sanity';
import { isEventPast } from '../lib/events.js';

// Landing — Übersicht aller BARs.
//
// In Phase 1 lädt diese Seite Vorschau-Daten aus Sanity (neueste 3 Notizen,
// aktuelle Werkstatt-Termine, Foto für erkennBAR). Solange Sanity noch
// nicht konfiguriert ist, zeigt die Seite Demo-Inhalte aus dem aktuellen
// Prototyp (siehe index.html im Root).

let upcomingEvents: any[] = [];
let about: any = null;
let latest: any[] = [];

if (isSanityConfigured) {
  // Nächste Werkstatt-Termine — zeigen sich im Hero („Nächste Begegnung")
  // und in der machBAR-Karte der Räume-Übersicht. Filterung über
  // isEventPast() (lib/events.js) statt einer eigenen GROQ-Bedingung,
  // damit "vergangen vs. laufend/nächste" nur an einer Stelle im Code
  // definiert ist (Bug 03.07.: zwei unabhängige, abweichende
  // Implementierungen dieser Regel hatten den gleichen Fehler).
  const allEvents = await sanity.fetch(`
    *[_type == "event"] | order(startDate asc) {
      _id, title, "slug": slug.current, startDate, endDate, location
    }
  `);
  upcomingEvents = allEvents.filter((e: any) => !isEventPast(e)).slice(0, 3);
  // Mantra/Leitfrage aus dem About-Singleton — Pull-Quote unter dem Fold
  about = await sanity.fetch(`*[_type == "about" && _id == "about"][0]{ mantra }`);

  // „Zuletzt veröffentlicht" — eine schlichte Liste der jüngsten Beiträge
  // quer durch alle Räume. Abkürzung für Besucher: zeigt auf einen Blick,
  // wo zuletzt etwas dazukam, mit Direktlink — ohne jeden Raum einzeln zu
  // öffnen. Bewusst nur drei Einträge und reine Textzeilen, damit es nicht
  // mit der Raum-Übersicht („Wohin als nächstes?") konkurriert. Sortiert
  // nach _updatedAt (Sanitys Zeitpunkt der letzten Veröffentlichung);
  // defined(slug.current) sichert, dass nur verlinkbare Einträge erscheinen.
  latest = await sanity.fetch(`
    *[
      _type in ["note", "station", "event", "resource", "episode", "wonder"]
      && defined(slug.current)
    ] | order(_updatedAt desc) [0...3] {
      _type, _id, _updatedAt, kind,
      "slug": slug.current,
      title, name
    }
  `);
}

const mantra: string | undefined = localized(about?.mantra);

// Sanity-Typ (+ kind) → Raum-Metadaten: Label, Akzentfarbe und URL-Basis.
// Spiegelt die Routing-Logik der Detail-Seiten:
//   note  notiz/poesie        → /schreibbar/   · idee/vision/umfrage → /denkbar/
//   event werkstatt           → /machbar/      · forschungstreffen   → /denkbar/
//   resource buch/film/…      → /lesbar/  · webseite/konzept/werkzeug → /brauchbar/
//   station / episode / wonder→ /bewegbar/ · /hoerbar/ · /wunderbar/
// Farben folgen den Raum-Akzenten von Header und Räume-Übersicht. lesBAR
// nutzt hier --text-secondary (statt des sehr hellen --neutral), damit das
// kleine kursive Label lesbar bleibt, ohne die ruhige Bibliotheks-Identität
// zu verlassen.
type RoomMeta = { base: string; label: string; accent: string };
function roomFor(item: any): RoomMeta {
  const k: string = item.kind;
  switch (item._type) {
    case 'note':
      return ['idee', 'vision', 'umfrage'].includes(k)
        ? { base: 'denkbar', label: 'denkBAR', accent: 'var(--accent-hover)' }
        : { base: 'schreibbar', label: 'schreibBAR', accent: 'var(--accent-deep)' };
    case 'event':
      return k === 'forschungstreffen'
        ? { base: 'denkbar', label: 'denkBAR', accent: 'var(--accent-hover)' }
        : { base: 'machbar', label: 'machBAR', accent: 'var(--accent)' };
    case 'resource':
      return ['webseite', 'konzept', 'werkzeug'].includes(k)
        ? { base: 'brauchbar', label: 'brauchBAR', accent: 'var(--text-primary)' }
        : { base: 'lesbar', label: 'lesBAR', accent: 'var(--text-secondary)' };
    case 'station':
      return { base: 'bewegbar', label: 'bewegBAR', accent: 'var(--accent-blue)' };
    case 'episode':
      return { base: 'hoerbar', label: 'hörBAR', accent: 'var(--accent-mauve)' };
    case 'wonder':
      return { base: 'wunderbar', label: 'wunderBAR', accent: 'var(--accent-green)' };
    default:
      return { base: '', label: '', accent: 'var(--accent)' };
  }
}

const latestDateFmt = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

const latestItems = latest
  .map((item: any) => {
    const room = roomFor(item);
    const title = item._type === 'station' ? item.name : localized(item.title);
    return {
      title: title || '(ohne Titel)',
      href: `/${room.base}/${item.slug}/`,
      room,
      updatedAt: item._updatedAt as string,
      dateLabel: item._updatedAt ? latestDateFmt.format(new Date(item._updatedAt)) : '',
    };
  })
  .filter((i) => i.room.base);
---

<BaseLayout
  title="werkSTATT Gemeinschaft — Katharina Offenborn"
  description="Miteinander vereinBAR — GemeinschaftsWERK statt allein unterwegs. Katharina Offenborn auf Reisen zu Gemeinschaftsorten."
>
  {/* Hero · Variante E — Panorama oben, Cream-Block drunter.
      Katharinas Favorit aus /hero-test/ (20.05., per Telegram).
      Wandergruppe in der kretischen Schlucht trägt das Bild,
      Headline + Buttons sitzen ruhig auf Cream darunter. */}
  <section class="hero hero--landing-e">
    <div class="hero-le__image" role="img" aria-label="Wandergruppe in einer Schlucht, Kreta"></div>
    <div class="hero-le__panel">
      <div class="container hero-le__inner">
        <span class="hero-le__eyebrow">Gemeinschafts<em class="hero-le__eyebrow-werk">WERK</em> statt allein unterwegs</span>
        <h1 class="hero-le__title">
          Auf der Suche —<br />
          wie wird <em>Gemeinschaft?</em>
        </h1>
        <p class="hero-le__subtitle">Reisen · Werkstätten · Notizen · Fotos</p>
        <div class="hero-le__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">
            In die schreibBAR
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
    </div>
  </section>

  {/* Zweck der Seite — kommt jetzt als erstes nach dem Hero, vor
      dem Mantra. Was die Seite ist, was sie will. Verweise auf
      hörBAR und lesBAR sind direkte Anker auf die zwei
      „Schätze-Räume". */}
  {/* Purpose + Mantra als Pair: auf Desktop nebeneinander (Grid),
      auf Mobile gestapelt. Mantra wirkt als Atemzeichen-Annotation
      neben der Website-Statement. */}
  <section class="intro-pair">
    <div class="container intro-pair__grid">
      <div class="intro-pair__col">
        <h2 class="purpose-intro__heading">
          <em>Diese</em> <span class="purpose-intro__heading-bold">Webseite</span>
          <em>dient zweierlei:</em>
        </h2>
        <p class="purpose-intro__body">
          Sie ist ein Versuch, die Schätze zu bergen und zu teilen, die
          ich bisher finden durfte.
        </p>
        <p class="purpose-intro__body">
          Sie ist aber auch eine Einladung mitzukommen auf diese Reise
          zueinander, die uns alle betrifft.
        </p>
      </div>
      {mantra && (
        <div class="intro-pair__col intro-pair__col--mantra">
          <blockquote class="mantra__text">„{mantra}"</blockquote>
        </div>
      )}
    </div>
  </section>

  {/* Zuletzt veröffentlicht — schlichte Textliste der drei jüngsten
      Beiträge quer durch alle Räume. Bewusst kein Kachel-Grid (sonst
      Doppelung mit „Wohin als nächstes?" direkt darunter): nur Titel,
      Raum und Datum als ruhige Zeilen, jede ein Direktlink. Rendert
      nur, wenn es verlinkbare Einträge gibt. */}
  {latestItems.length > 0 && (
    <section class="freshly" aria-labelledby="freshly-title">
      <div class="container freshly__inner">
        <h2 id="freshly-title" class="eyebrow freshly__label">Zuletzt veröffentlicht</h2>
        <ul class="freshly__list">
          {latestItems.map((item) => (
            <li class="freshly__item">
              <a class="freshly__link" href={item.href}>
                <span class="freshly__entry-title">{item.title}</span>
                <span class="freshly__meta">
                  <span class="freshly__room" style={`color: ${item.room.accent};`}>{item.room.label}</span>
                  {item.dateLabel && (
                    <>
                      <span class="freshly__dot" aria-hidden="true">·</span>
                      <time class="freshly__time" datetime={item.updatedAt}>{item.dateLabel}</time>
                    </>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <style>
    /* Bewusst knapp gehalten — sitzt als Addon direkt unter dem Intro/
       Mantra-Block (gleicher --bg-base), nicht als eigene Sektion. */
    .freshly {
      padding: 0 0 2rem;
      background: var(--bg-base);
    }
    /* Linksbündig an der Container-Kante — gleiche linke Kante und
       Breite wie die linke Intro-Spalte darüber. KEINE zentrierte
       Insel mehr (das ließ die Box mittig schweben, ohne Bezug zum
       Seitenraster). So entsteht eine durchgehende linke Kante:
       Headline → Statement → Zuletzt veröffentlicht. */
    .freshly__inner {
      display: flex;
      flex-direction: column;
    }
    .freshly__label {
      display: block;
      margin: 0 0 0.7rem;
      max-width: 34rem;
    }
    .freshly__list {
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 34rem;
    }
    .freshly__item + .freshly__item {
      border-top: 1px solid var(--border-subtle);
    }
    /* Gestapelte Editorial-Zeile: Titel oben, darunter Raum + Datum als
       ruhige Meta. Kein Auseinanderreißen an die Ränder, dadurch auf
       jeder Breite gleich zusammenhängend (keine Box, kein Pfeil, kein
       Schatten). Auf Hover/Fokus färbt sich der Titel in die Akzentfarbe. */
    .freshly__link {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.85rem 0;
      text-decoration: none;
      color: var(--text-primary);
    }
    .freshly__entry-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      line-height: 1.25;
      transition: color 0.15s ease;
    }
    .freshly__link:hover .freshly__entry-title,
    .freshly__link:focus-visible .freshly__entry-title {
      color: var(--accent-hover);
    }
    .freshly__meta {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.1rem 0.45rem;
      font-family: var(--font-text);
      font-size: 0.8rem;
      letter-spacing: 0.01em;
      color: var(--text-muted);
    }
    .freshly__room {
      font-style: italic;
      font-weight: 500;
    }
    .freshly__dot {
      opacity: 0.55;
    }
    .freshly__time {
      font-variant-numeric: tabular-nums;
    }
  </style>
  <script>
    // Build-Zeit-Datum durch eine relative Angabe ersetzen, die zum
    // tatsächlichen Besuchszeitpunkt passt. Die Site ist statisch —
    // ohne dieses Skript würde „heute" am Deploy-Tag einfrieren. Fällt
    // ohne JS sauber auf das absolute Datum zurück.
    function relativeDe(iso: string): string | null {
      const then = new Date(iso).getTime();
      if (Number.isNaN(then)) return null;
      const days = Math.floor((Date.now() - then) / 86400000);
      if (days <= 0) return 'heute';
      if (days === 1) return 'gestern';
      if (days < 7) return `vor ${days} Tagen`;
      if (days < 14) return 'vor einer Woche';
      if (days < 31) return `vor ${Math.floor(days / 7)} Wochen`;
      if (days < 60) return 'vor einem Monat';
      if (days < 365) return `vor ${Math.floor(days / 30)} Monaten`;
      const years = Math.floor(days / 365);
      return years === 1 ? 'vor einem Jahr' : `vor ${years} Jahren`;
    }
    document.querySelectorAll<HTMLTimeElement>('.freshly__time').forEach((el) => {
      const iso = el.getAttribute('datetime');
      const label = iso ? relativeDe(iso) : null;
      if (label) {
        el.title = el.textContent || '';
        el.textContent = label;
      }
    });
  </script>

  {/* „Der rote Faden" mit Notizen-Vorschau wurde von der Landing
      entfernt — Mantra + Räume-Übersicht tragen den Einstieg jetzt
      allein, die Notizen leben unter /schreibbar/ und im Footer-
      Erkunden-Link. */}

  {/* Sechs Räume — jeder mit eigener Akzentfarbe.
      Die Farb-Trias der ersten Drei-Türen-Version wird auf alle sechs
      Räume erweitert: clay-rot · fern-grün · honig-bronze · mauve-rose
      · deep forest · honig-gold. Dieselben Farben tauchen in der
      Top-Nav als raumspezifischer Active-Underline wieder auf.
      `id="raeume"` ist Scroll-Anchor für den Hero-CTA „Wohin dann?".
      `scroll-margin-top` sorgt dafür, dass die Section nicht unter
      dem sticky Site-Header landet. */}
  <section id="raeume" style="padding: 5rem 0; background: var(--bg-warm-soft); scroll-margin-top: 80px;">
    <div class="container">
      <header style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
        <span class="eyebrow">Räume</span>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 0; color: var(--accent-hover);">
          Wohin als <em style="color: inherit;">nächstes</em>?
        </h2>
      </header>
      {/* Reihenfolge bewusst gesetzt — pro Zeile drei Karten mit
          klarer Farb-Logik:
          Zeile 1 (Brand-Trio, lebhaft): schreibbar Plum +
            machbar Gold + bewegbar Türkis = Komplementär-Tanz,
            das Pulsschlag-Trio der Site
          Zeile 2 (Schätze-Trio, ruhig): hörbar Berry-Plum +
            lesbar Warm-Grey + brauchbar Aubergine = gedämpfte
            Sammlungen, alle in der Plum-/Erd-Familie
          Zeile 3 (Outlier): wunderbar Grün = frecher Schluss
          hörBAR hat jetzt --accent-mauve (tieferes Berry-Plum)
          statt --accent-deep — sonst wäre Plum doppelt mit
          schreibBAR und die Abfolge wirkte chaotisch. */}
      <div class="rooms-grid">
        {[
          { slug: 'schreibbar', eyebrow: 'Notizen', stem: 'schreib', desc: 'Datierte Einträge — Notizen, Gedichte, Gedanken aus Reisen, Werkstätten und Lektüren', accent: 'var(--accent-deep)' },
          { slug: 'machbar', eyebrow: 'Werkstatt', stem: 'mach', desc: 'Werkstatt-Termine zum Mitmachen — drei Themen, im Jahres-Rhythmus', accent: 'var(--accent)' },
          { slug: 'bewegbar', eyebrow: 'Reisen', stem: 'beweg', desc: 'Orte, an denen ich war — Ökodörfer, Cohousing-Projekte und gemeinsame Lebensorte, auf einer Karte', accent: 'var(--accent-blue)' },
          { slug: 'hoerbar', eyebrow: 'Audio', stem: 'hör', desc: 'Eingesprochene Reflexionen, Gedichte, Lieder — plus Gespräche mit Menschen, die in Gemeinschaft leben', accent: 'var(--accent-mauve)' },
          { slug: 'lesbar', eyebrow: 'Bibliothek', stem: 'les', desc: 'Bücher, Artikel und Quellen zu Fragen des Miteinander', accent: 'var(--neutral)' },
          { slug: 'brauchbar', eyebrow: 'Werkzeuge', stem: 'brauch', desc: 'Webseiten, Konzepte und Werkzeuge — was sich in der Praxis als hilfreich erweist', accent: 'var(--text-primary)' },
          { slug: 'wunderbar', eyebrow: 'Kreatives', stem: 'wunder', desc: 'Was nicht in die anderen Räume passt — spielerisch, offen, ungeordnet', accent: 'var(--accent-green)' },
        ].map((room) => (
          <a class="room-card" href={`/${room.slug}/`} style={`--card-accent: ${room.accent};`}>
            <span class="eyebrow room-card__eyebrow">{room.eyebrow}</span>
            <h3 class="room-card__title">{room.stem}<em>BAR</em></h3>
            <p class="room-card__desc">
              {room.desc}
              {room.slug === 'machbar' && upcomingEvents[0]?.title && (
                <>
                  <br/><strong class="room-card__next">Nächster: {localized(upcomingEvents[0].title)}</strong>
                </>
              )}
            </p>
            <span class="room-card__cta">Zur {room.stem}BAR →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      max-width: 960px;
      margin: 0 auto;
    }
    .room-card {
      /* Tür-Andeutung: die linke Kante ist eine 3px-Leibung in der
         Raum-Akzentfarbe, links scharfkantig wie ein Türscharnier,
         rechts gerundet wie ein Türblatt. Ein kleiner Punkt
         (::before) auf halber Höhe markiert den Türknauf. Beim
         Hover „öffnet" sich der Knauf einen Hauch nach rechts. */
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 2rem 2rem 2rem 2.4rem;
      border: 1px solid rgba(45, 36, 53, 0.10);
      border-left: 3px solid var(--card-accent);
      border-radius: 0 6px 6px 0;
      /* Reinweiß auf cream-Sand-Section — sonst „schwimmen" die Karten
         im Eurythmie-Cream. Plus dezenter Plum-Schatten für klare
         Tile-Abhebung, ohne Härte. */
      background: #ffffff;
      box-shadow: 0 8px 24px -14px rgba(45, 36, 53, 0.20);
      text-decoration: none;
      color: var(--text-primary);
      transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.2s ease;
    }
    /* Türknauf — kleiner Kreis in der Raum-Akzentfarbe, mittig auf
       der Türleibung sitzend. Bewusst klein und ruhig, damit die
       Andeutung nicht zur Illustration wird. */
    .room-card::before {
      content: '';
      position: absolute;
      left: 12px;
      top: 50%;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--card-accent);
      opacity: 0.55;
      transform: translateY(-50%);
      transition: transform var(--t-base) var(--ease),
                  opacity var(--t-base) var(--ease);
    }
    .room-card:hover {
      border-color: var(--card-accent);
      transform: translateY(-2px);
      box-shadow: 0 14px 32px -16px rgba(45, 36, 53, 0.28);
    }
    /* Tür „öffnet" — Knauf rutscht ein Stück nach rechts und wird
       satter, als wäre er gerade gedrückt worden. */
    .room-card:hover::before {
      transform: translate(3px, -50%);
      opacity: 1;
    }
    .room-card__eyebrow {
      color: var(--card-accent);
    }
    .room-card__title {
      font-family: var(--font-display);
      font-size: 1.6rem;
      margin: 0;
      color: var(--text-primary);
    }
    .room-card__title em {
      /* „BAR" einheitlich in Altgold — als wiederkehrende Wortmarke
         über alle Karten, im Echo zum „WERKSTATT" im Logo. Die raum-
         spezifische Variation lebt im Eyebrow oben („Notizen",
         „Reisen", …), im Hover-Border der Karte und im CTA-Link
         unten („Zur schreibBAR →"). */
      color: var(--accent);
      font-style: italic;
    }
    .room-card__desc {
      color: var(--text-secondary);
      margin: 0;
      font-size: 15px;
      line-height: 1.55;
    }
    .room-card__next {
      color: var(--card-accent);
      font-weight: 500;
    }
    .room-card__cta {
      margin-top: auto;
      color: var(--card-accent);
      font-size: 14px;
    }

    /* Mantra-Pull-Quote — Linksausrichtung wie der Hero darüber.
       Dezenter Plum-Wash gibt der Section einen eigenen Klang
       („Bühnen-Atmosphäre"), italic Cormorant, Plum-Linie als
       Atemzeichen. */
    /* Intro-Pair: Purpose-Statement und Mantra-Zitat. Auf Mobile
       stacked (Mantra unter Purpose), auf Desktop nebeneinander
       in zwei Spalten. Mantra ist die kleinere Atemzeichen-
       Annotation rechts. */
    .intro-pair {
      padding: 5rem 0 1.5rem;
      background: var(--bg-base);
    }
    .intro-pair__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .intro-pair__grid {
        /* Beide Spalten gleichbreit — der Mantra-Block soll
           visuelles Gegengewicht zum Purpose-Block bilden, nicht
           als Anhängsel wirken. Vertikal zentriert. */
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }
    }
    /* Mantra-Spalte: das große Plum-Anführungszeichen als
       Wasserzeichen oben-links gibt dem Zitat einen Anker und Atem.
       Die rechte Spalte wirkte vorher wie ein verlorener Footnote-
       Block — jetzt liest sich's als eigene Mantra-Insel, ohne
       Box-Look (kein Background, keine Border-Wand). */
    .intro-pair__col--mantra {
      position: relative;
      padding-left: clamp(1.25rem, 3vw, 2.75rem);
      padding-top: clamp(0.5rem, 2vw, 1.75rem);
    }
    .intro-pair__col--mantra::before {
      content: '„';
      position: absolute;
      top: clamp(-3.5rem, -5vw, -2.5rem);
      left: clamp(-0.75rem, -0.5vw, -0.25rem);
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      /* Wasserzeichen prominenter — gibt dem Mantra-Block Volumen,
         bildet eigenen visuellen Anker statt nur subtilem Schmuck. */
      font-size: clamp(7rem, 13vw, 12rem);
      line-height: 1;
      color: var(--accent-deep);
      opacity: 0.20;
      pointer-events: none;
      user-select: none;
    }
    /* Feiner Plum-Strich am Ende des Zitats — Atemzeichen, das den
       Mantra-Block visuell abschließt. Etwas länger für mehr
       Gewicht im balancierten Layout. */
    .intro-pair__col--mantra::after {
      content: '';
      display: block;
      width: 64px;
      height: 1.5px;
      background: var(--accent-deep);
      opacity: 0.4;
      margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    }
    .mantra__text {
      margin: 0;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      /* Auf Purpose-Body-Niveau (clamp 1.45 → 2 rem) — der Mantra-
         Block muss visuelles Gegengewicht zum linken Block bilden,
         nicht als Anhängsel wirken. Color --text-body (gedämpftes
         Plum) hält die meditative Stimmung. */
      font-size: clamp(1.45rem, 2.4vw, 2rem);
      line-height: 1.45;
      color: var(--text-body);
      text-align: left;
      letter-spacing: -0.005em;
    }
    /* Auf Mobile: Mantra steht unter dem Purpose-Text, die großen
       Anführungszeichen sind dort eher Schmuck als Anker. Padding
       kleiner halten, sonst wird's links unnötig breit. */
    @media (max-width: 1023px) {
      .intro-pair__col--mantra::before {
        font-size: clamp(5rem, 18vw, 8rem);
        top: -2rem;
        opacity: 0.15;
      }
    }

    .purpose-intro__heading {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4.2vw, 3rem);
      font-weight: 400;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin: 0 0 2rem;
      color: var(--text-primary);
    }
    .purpose-intro__heading-bold {
      /* „Website" als Wortmarke in tieferem Bronze-Gold — Brand-
         Anker bleibt in der Gold-Familie (Echo zu WERKSTATT,
         BAR-Endungen, CTAs), aber auf dem Cream-Background braucht
         es den dunkleren Hover-Ton, damit das Wort trägt statt zu
         flirren. Champagne (--accent) ist zu hell für so große
         Display-Schrift auf Off-White. */
      font-weight: 700;
      color: var(--accent-hover);
      letter-spacing: 0.02em;
    }
    .purpose-intro__heading em {
      /* Globales h2 em ist Champagne-Akzent — hier explizit auf
         Text-Primary, „dient zweierlei:" soll nicht farbig sein.
         Brand-Wortmarke ist WEBSEITE, das em ist nur Italic-Rhythmus. */
      font-style: italic;
      font-weight: 400;
      color: var(--text-primary);
    }
    .purpose-intro__body {
      font-family: var(--font-display);
      font-size: clamp(1.45rem, 2.4vw, 2rem);
      line-height: 1.5;
      color: var(--text-primary);
      margin: 0 0 1.5rem;
    }
    .purpose-intro__body:last-child {
      margin-bottom: 0;
    }
    .purpose-intro__link {
      font-weight: 500;
      font-style: italic;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 1px;
      transition: opacity 0.15s ease;
    }
    .purpose-intro__link:hover {
      opacity: 0.7;
    }
  </style>

  {/* Mitkommen: zarter Peach-Cream-Wash, derselbe Ton wie die
      Räume-Section. Eyebrow mit beidseitigem Strich, Headline mit
      Italic-Schwung, dezentes Ornament unten als Brücke zum
      Newsletter darunter — sonst wirkten die zwei zentrierten
      Sections wie eine leere Cream-Wüste. */}
  <section class="meet-section">
    <div class="container meet-section__inner">
      <span class="eyebrow eyebrow--balanced meet-section__eyebrow">Begegnung</span>
      <h2 class="meet-section__title">
        <em>Mitkommen</em>
      </h2>
      <p class="meet-section__lead">
        Werkstatt, Einladung, Beratung, Gespräch — schreib mir, was du brauchst.
        Ich antworte gern, wenn auch nicht immer schnell.
      </p>
      <a href="/mitkommen/" class="btn btn--primary">Kontakt →</a>
    </div>
    {/* Atemzeichen-Ornament — drei dezente Plum-Punkte als visuelle
        Brücke zur Newsletter-Section darunter. */}
    <div class="meet-section__divider" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  </section>
  <style>
    .meet-section {
      padding: 5rem 0 3.5rem;
      background: var(--bg-warm-soft);
      text-align: center;
    }
    .meet-section__inner {
      max-width: 640px;
    }
    .meet-section__eyebrow {
      color: var(--accent-deep);
    }
    .meet-section__title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4.4vw, 3rem);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--text-primary);
      margin: 0.8rem 0 1.25rem;
    }
    .meet-section__title em {
      font-style: italic;
      font-weight: 400;
      /* „Mitkommen" als geschwungene Wortmarke — italic Cormorant
         trägt die einladende Geste. */
    }
    .meet-section__lead {
      color: var(--text-body);
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      line-height: 1.55;
      margin: 0 auto 2.25rem;
      max-width: 520px;
    }
    .meet-section__divider {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 14px;
      padding: 3rem 0 0;
      background: var(--bg-warm-soft);
    }
    .meet-section__divider span {
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent-deep);
      opacity: 0.35;
    }
    .meet-section__divider span:nth-child(2) {
      width: 5px;
      height: 5px;
      opacity: 0.5;
    }
  </style>

  <NewsletterBlock variant="landing" />
</BaseLayout>
