---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanity, localized, isSanityConfigured } from '../lib/sanity';

// Landing — Übersicht aller BARs.
//
// In Phase 1 lädt diese Seite Vorschau-Daten aus Sanity (neueste 3 Notizen,
// aktuelle Werkstatt-Termine, Foto für erkennBAR). Solange Sanity noch
// nicht konfiguriert ist, zeigt die Seite Demo-Inhalte aus dem aktuellen
// Prototyp (siehe index.html im Root).

let recentNotes: any[] = [];
let upcomingEvents: any[] = [];

if (isSanityConfigured) {
  // Neueste Notizen
  recentNotes = await sanity.fetch(`
    *[_type == "note"] | order(publishedAt desc) [0...3] {
      _id, title, kind, publishedAt, "slug": slug.current,
      "hero": hero { asset->{ url }, alt }
    }
  `);
  // Nächste Werkstatt-Termine
  upcomingEvents = await sanity.fetch(`
    *[_type == "event" && startDate >= now()] | order(startDate asc) [0...3] {
      _id, title, "slug": slug.current, startDate, location
    }
  `);
}
---

<BaseLayout
  title="WERKstatt Gemeinschaft — Katharina Offenborn"
  description="Miteinander vereinBAR — GemeinschaftsWERK statt allein unterwegs. Katharina Offenborn auf Reisen zu Gemeinschaftsorten."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__main">
        <span class="eyebrow hero__eyebrow">
          Miteinander vereinBAR — <span class="hero__eyebrow-nowrap">Gemeinschafts<em class="hero__eyebrow-werk">WERK</em></span> statt allein unterwegs
        </span>
        <h1 class="hero__title">
          <span class="hero__title-a">Auf der Suche —</span><br />
          <span class="hero__title-b">wie wird <em>Gemeinschaft?</em></span>
        </h1>
        <p class="hero__subtitle">
          Reisen · Werkstätten · Notizen · Fotos.
        </p>
        <div class="hero__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">
            In die SchreibBAR
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href="/mitkommen/" class="btn btn--ghost">Mitkommen</a>
        </div>
      </div>
      <a href="/machbar/" class="hero__meta" aria-label="Nächste Begegnung">
        Nächste Begegnung
        <strong>{upcomingEvents[0]?.startDate ? new Date(upcomingEvents[0].startDate).toLocaleDateString('de-DE', { day: 'numeric', month: 'long' }) : '21. Juni'}</strong>
        {upcomingEvents[0]?.location || 'Tempelhof'}
        <span class="hero__meta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {recentNotes.length > 0 && (
    <section style="padding: 5rem 0; background: var(--bg-primary);">
      <div class="container">
        <header style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
          <span class="eyebrow">Aus den Notizen</span>
          <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 0; color: var(--text-primary);">
            Die rote <em>Schnur</em>
          </h2>
          <p style="color: var(--text-secondary); margin-top: 1rem; font-size: 16px;">
            Datierte Einträge aus Reisen, Werkstätten, Lesen, Stimme.
          </p>
        </header>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; max-width: 960px; margin: 0 auto;">
          {recentNotes.map((note: any) => (
            <a
              href={`/schreibbar/${note.slug}/`}
              style="display: block; padding: 1.5rem 1.5rem 1.75rem; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-warm); text-decoration: none; color: var(--text-primary); transition: transform 0.15s ease, border-color 0.15s ease;"
              onmouseover="this.style.borderColor='var(--accent-warm)'; this.style.transform='translateY(-2px)';"
              onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
            >
              <span class="eyebrow" style="color: var(--accent-warm);">
                {note.publishedAt
                  ? new Date(note.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
                  : ''}
                {note.kind && ` · ${note.kind === 'denkbar' ? 'DenkBAR' : 'SchreibBAR'}`}
              </span>
              <h3 style="font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; margin: 0.6rem 0 0; color: var(--text-primary);">
                {localized(note.title)}
              </h3>
            </a>
          ))}
        </div>
        <div style="text-align: center; margin-top: 2.5rem;">
          <a href="/schreibbar/" style="color: var(--accent-warm); text-decoration: none; font-family: var(--font-display); font-size: 18px;">
            Alle Notizen lesen →
          </a>
        </div>
      </div>
    </section>
  )}

  <section style="padding: 5rem 0; background: var(--bg-warm);">
    <div class="container">
      <header style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
        <span class="eyebrow">Drei Türen</span>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 0; color: var(--text-primary);">
          Wohin als <em>nächstes</em>?
        </h2>
      </header>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 960px; margin: 0 auto;">
        <a
          href="/bewegbar/"
          style="display: flex; flex-direction: column; gap: 0.75rem; padding: 2rem; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-primary); text-decoration: none; color: var(--text-primary); transition: transform 0.15s ease, border-color 0.15s ease;"
          onmouseover="this.style.borderColor='var(--accent-warm)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
        >
          <span class="eyebrow" style="color: var(--accent-warm);">Reisen</span>
          <h3 style="font-family: var(--font-display); font-size: 1.6rem; margin: 0; color: var(--text-primary);">
            Beweg<em>BAR</em>
          </h3>
          <p style="color: var(--text-secondary); margin: 0; font-size: 15px; line-height: 1.55;">
            Stationen unterwegs zu Gemeinschaftsorten — mit Karte, Fotos und Notizen.
          </p>
          <span style="margin-top: auto; color: var(--accent-warm); font-size: 14px;">Zur Karte →</span>
        </a>

        <a
          href="/machbar/"
          style="display: flex; flex-direction: column; gap: 0.75rem; padding: 2rem; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-primary); text-decoration: none; color: var(--text-primary); transition: transform 0.15s ease, border-color 0.15s ease;"
          onmouseover="this.style.borderColor='var(--accent-warm)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
        >
          <span class="eyebrow" style="color: var(--accent-warm);">Werkstätten</span>
          <h3 style="font-family: var(--font-display); font-size: 1.6rem; margin: 0; color: var(--text-primary);">
            Mach<em>BAR</em>
          </h3>
          <p style="color: var(--text-secondary); margin: 0; font-size: 15px; line-height: 1.55;">
            Termine zum Mitmachen — von Sommer-Werkstatt bis Vortrag.
            {upcomingEvents[0]?.title && (
              <>
                <br/><strong style="color: var(--accent-warm); font-weight: 500;">Nächster: {localized(upcomingEvents[0].title)}</strong>
              </>
            )}
          </p>
          <span style="margin-top: auto; color: var(--accent-warm); font-size: 14px;">Zu den Terminen →</span>
        </a>

        <a
          href="/lesbar/"
          style="display: flex; flex-direction: column; gap: 0.75rem; padding: 2rem; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-primary); text-decoration: none; color: var(--text-primary); transition: transform 0.15s ease, border-color 0.15s ease;"
          onmouseover="this.style.borderColor='var(--accent-warm)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
        >
          <span class="eyebrow" style="color: var(--accent-warm);">Bibliothek</span>
          <h3 style="font-family: var(--font-display); font-size: 1.6rem; margin: 0; color: var(--text-primary);">
            Les<em>BAR</em>
          </h3>
          <p style="color: var(--text-secondary); margin: 0; font-size: 15px; line-height: 1.55;">
            Bücher, Texte und Quellen, die mich tragen und begleiten.
          </p>
          <span style="margin-top: auto; color: var(--accent-warm); font-size: 14px;">In die Bibliothek →</span>
        </a>
      </div>
    </div>
  </section>

  <section style="padding: 5rem 0; background: var(--bg-primary); text-align: center;">
    <div class="container" style="max-width: 640px;">
      <span class="eyebrow">Begegnung</span>
      <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 1rem; color: var(--text-primary);">
        Mit<em>kommen</em>.
      </h2>
      <p style="color: var(--text-secondary); margin: 0 0 2rem; font-size: 17px; line-height: 1.6;">
        Werkstatt, Einladung, Beratung, Gespräch — schreib mir, was du brauchst.
        Ich antworte gern, wenn auch nicht immer schnell.
      </p>
      <a href="/mitkommen/" class="btn btn--primary">Zum Formular →</a>
    </div>
  </section>
</BaseLayout>
