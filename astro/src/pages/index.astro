---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { sanity, localized, isSanityConfigured } from '../lib/sanity';

// Landing — Übersicht aller BARs.
//
// In Phase 1 lädt diese Seite Vorschau-Daten aus Sanity (neueste 3 Notizen,
// aktuelle Werkstatt-Termine, Foto für erkennBAR). Solange Sanity noch
// nicht konfiguriert ist, zeigt die Seite Demo-Inhalte aus dem aktuellen
// Prototyp (siehe index.html im Root).

let recentNotes: any[] = [];
let upcomingEvents: any[] = [];

if (isSanityConfigured) {
  // Neueste Notizen
  recentNotes = await sanity.fetch(`
    *[_type == "note"] | order(publishedAt desc) [0...3] {
      _id, title, kind, publishedAt, "slug": slug.current,
      "hero": hero { asset->{ url }, alt }
    }
  `);
  // Nächste Werkstatt-Termine
  upcomingEvents = await sanity.fetch(`
    *[_type == "event" && startDate >= now()] | order(startDate asc) [0...3] {
      _id, title, "slug": slug.current, startDate, location
    }
  `);
}
---

<BaseLayout
  title="werkSTATT Gemeinschaft — Katharina Offenborn"
  description="Miteinander vereinBAR — GemeinschaftsWERK statt allein unterwegs. Katharina Offenborn auf Reisen zu Gemeinschaftsorten."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__main">
        <span class="eyebrow hero__eyebrow">
          <span class="hero__eyebrow-nowrap">Gemeinschafts<em class="hero__eyebrow-werk">WERK</em></span> statt allein unterwegs
        </span>
        <h1 class="hero__title">
          <span class="hero__title-a">Auf der Suche —</span><br />
          <span class="hero__title-b">wie wird <em>Gemeinschaft?</em></span>
        </h1>
        <p class="hero__subtitle">
          Reisen · Werkstätten · Notizen · Fotos
        </p>
        <div class="hero__cta-row">
          <a href="/schreibbar/" class="btn btn--primary">
            In die schreibBAR
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
          <a href="#raeume" class="btn btn--ghost btn--fresh">Wohin dann?</a>
        </div>
      </div>
      <a
        href={upcomingEvents[0]?.slug ? `/machbar/${upcomingEvents[0].slug}/` : '/machbar/'}
        class="hero__meta"
        aria-label="Nächste Begegnung"
      >
        Nächste Begegnung
        <strong>{upcomingEvents[0]?.startDate ? new Date(upcomingEvents[0].startDate).toLocaleDateString('de-DE', { day: 'numeric', month: 'long' }) : '21. Juni'}</strong>
        {upcomingEvents[0]?.location || 'Tempelhof'}
        <span class="hero__meta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {recentNotes.length > 0 && (
    <section style="padding: 6rem 0;">
      <div class="container" style="max-width: 720px;">
        <header style="text-align: center; margin-bottom: 4rem;">
          <span class="eyebrow">Notizen</span>
          <h2 style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3rem); margin: 0.6rem 0 0; color: var(--text-primary); letter-spacing: -0.01em;">
            Der rote <em style="font-style: italic; color: var(--accent); font-weight: 400;">Faden</em>
          </h2>
          <p style="color: var(--text-secondary); margin-top: 1rem; font-size: 16px;">
            Datierte Einträge aus Reisen, Werkstätten, Lesen, Stimme.
          </p>
        </header>

        <ol style="list-style: none; padding: 0; margin: 0; text-align: center;">
          {recentNotes.map((note: any, i: number) => (
            <li>
              {/* Bridge nur zwischen Einträgen, nicht durch sie.
                  Zwei rote Gradient-Linien flankieren einen roten Punkt —
                  der „rote Faden" soll auch sichtbar rot sein. Linien
                  faden via rgba (statt transparent), damit der Farbton
                  durchgehend rot bleibt und nicht ins Graue kippt. */}
              {i > 0 && (
                <div
                  aria-hidden="true"
                  style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.55rem; padding: 1.75rem 0;"
                >
                  <span style="display: block; width: 1.5px; height: 30px; background: linear-gradient(to bottom, rgba(168, 57, 43, 0.15), rgba(168, 57, 43, 1));"></span>
                  <span style="display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent);"></span>
                  <span style="display: block; width: 1.5px; height: 30px; background: linear-gradient(to top, rgba(168, 57, 43, 0.15), rgba(168, 57, 43, 1));"></span>
                </div>
              )}

              <a
                href={`/schreibbar/${note.slug}/`}
                style="display: block; text-decoration: none; color: inherit; padding: 1rem 0;"
                onmouseover="this.querySelector('h3').style.color='var(--accent-warm)';"
                onmouseout="this.querySelector('h3').style.color='var(--text-primary)';"
              >
                <p style="font-family: var(--font-text); font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-warm); margin: 0;">
                  {note.publishedAt
                    ? new Date(note.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
                    : ''}
                  {note.kind && ` · ${['idee', 'vision', 'umfrage'].includes(note.kind) ? 'denkBAR' : 'schreibBAR'}`}
                </p>
                <h3 style="font-family: var(--font-display); font-size: clamp(1.7rem, 3.6vw, 2.6rem); font-weight: 500; font-style: italic; line-height: 1.15; margin: 0.65rem 0 0; color: var(--text-primary); transition: color 0.2s ease; letter-spacing: -0.005em;">
                  {localized(note.title)}
                </h3>
              </a>
            </li>
          ))}
        </ol>

        <div style="text-align: center; margin-top: 4rem;">
          <a
            href="/schreibbar/"
            style="font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--accent-warm); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px;"
          >
            Alle Notizen lesen →
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Sechs Räume — jeder mit eigener Akzentfarbe.
      Die Farb-Trias der ersten Drei-Türen-Version wird auf alle sechs
      Räume erweitert: clay-rot · fern-grün · honig-bronze · mauve-rose
      · deep forest · honig-gold. Dieselben Farben tauchen in der
      Top-Nav als raumspezifischer Active-Underline wieder auf.
      `id="raeume"` ist Scroll-Anchor für den Hero-CTA „Wohin dann?".
      `scroll-margin-top` sorgt dafür, dass die Section nicht unter
      dem sticky Site-Header landet. */}
  <section id="raeume" style="padding: 5rem 0; background: var(--bg-warm); scroll-margin-top: 80px;">
    <div class="container">
      <header style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
        <span class="eyebrow">Räume</span>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 0; color: var(--text-primary);">
          Wohin als <em>nächstes</em>?
        </h2>
      </header>
      <div class="rooms-grid">
        {[
          { slug: 'schreibbar', eyebrow: 'Notizen', stem: 'schreib', desc: 'Datierte Einträge — Notizen, Gedichte, Gedanken aus Reisen, Werkstätten und Lektüren.', accent: 'var(--accent)' },
          { slug: 'bewegbar', eyebrow: 'Reisen', stem: 'beweg', desc: 'Orte, an denen ich war — Ökodörfer, Cohousing-Projekte und gemeinsame Lebensorte, auf einer Karte.', accent: 'var(--accent-green)' },
          { slug: 'machbar', eyebrow: 'Werkstatt', stem: 'mach', desc: 'Werkstatt-Termine zum Mitmachen — drei Themen, im Jahres-Rhythmus.', accent: 'var(--accent-warm)' },
          { slug: 'lesbar', eyebrow: 'Bibliothek', stem: 'les', desc: 'Bücher, Webseiten, Filme, Podcasts und Werkzeuge zu Fragen des Miteinander.', accent: 'var(--accent-rose)' },
          { slug: 'hoerbar', eyebrow: 'Audio', stem: 'hör', desc: 'Eingesprochene Reflexionen, Gedichte, Lieder — plus Gespräche mit Menschen, die in Gemeinschaft leben.', accent: 'var(--accent-deep)' },
          { slug: 'wunderbar', eyebrow: 'Kreatives', stem: 'wunder', desc: 'Was nicht in die anderen Räume passt — spielerisch, offen, ungeordnet.', accent: 'var(--accent-gold)' },
        ].map((room) => (
          <a class="room-card" href={`/${room.slug}/`} style={`--card-accent: ${room.accent};`}>
            <span class="eyebrow room-card__eyebrow">{room.eyebrow}</span>
            <h3 class="room-card__title">{room.stem}<em>BAR</em></h3>
            <p class="room-card__desc">
              {room.desc}
              {room.slug === 'machbar' && upcomingEvents[0]?.title && (
                <>
                  <br/><strong class="room-card__next">Nächster: {localized(upcomingEvents[0].title)}</strong>
                </>
              )}
            </p>
            <span class="room-card__cta">Zur {room.stem}BAR →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      max-width: 960px;
      margin: 0 auto;
    }
    .room-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 2rem;
      border: 1px solid var(--border-subtle);
      border-radius: 4px;
      background: var(--bg-primary);
      text-decoration: none;
      color: var(--text-primary);
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .room-card:hover {
      border-color: var(--card-accent);
      transform: translateY(-2px);
    }
    .room-card__eyebrow {
      color: var(--card-accent);
    }
    .room-card__title {
      font-family: var(--font-display);
      font-size: 1.6rem;
      margin: 0;
      color: var(--text-primary);
    }
    .room-card__title em {
      color: var(--card-accent);
      font-style: italic;
    }
    .room-card__desc {
      color: var(--text-secondary);
      margin: 0;
      font-size: 15px;
      line-height: 1.55;
    }
    .room-card__next {
      color: var(--card-accent);
      font-weight: 500;
    }
    .room-card__cta {
      margin-top: auto;
      color: var(--card-accent);
      font-size: 14px;
    }
  </style>

  <section style="padding: 5rem 0; background: var(--bg-primary); text-align: center;">
    <div class="container" style="max-width: 640px;">
      <span class="eyebrow">Begegnung</span>
      <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 1rem; color: var(--text-primary);">
        Mitkommen
      </h2>
      <p style="color: var(--text-secondary); margin: 0 0 2rem; font-size: 17px; line-height: 1.6;">
        Werkstatt, Einladung, Beratung, Gespräch — schreib mir, was du brauchst.
        Ich antworte gern, wenn auch nicht immer schnell.
      </p>
      <a href="/mitkommen/" class="btn btn--primary">Wohin jetzt? →</a>
    </div>
  </section>

  <NewsletterBlock variant="landing" />
</BaseLayout>
