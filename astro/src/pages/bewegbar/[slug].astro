---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import SanityImage from '../../components/SanityImage.astro';
import ShareButton from '../../components/ShareButton.astro';
import { sanity, urlFor, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const stations = await sanity.fetch(`
    *[_type == "station" && defined(slug.current)] {
      "slug": slug.current, _id, name, region, country, address,
      visitedAt, visitedRange, coordinates,
      images,
      reflection,
      tags, communityLink,
      "conceptPdfUrl": conceptPdf.asset->url
    }
  `);
  // images bleibt als volles Image-Array — Sanity-Image-Object mit
  // asset._ref + alt + caption, kompatibel mit @sanity/image-url
  return stations.map((s: any) => ({ params: { slug: s.slug }, props: { station: s } }));
}

const { station } = Astro.props;

const fallbackOgPhoto =
  'https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1200&h=630&fit=crop&q=85';
const firstImage = Array.isArray(station.images) ? station.images[0] : null;
const ogImage = firstImage?.asset
  ? urlFor(firstImage).width(1200).height(630).fit('crop').auto('format').quality(85).url()
  : fallbackOgPhoto;
---

<BaseLayout
  title={`${station.name} — bewegBAR`}
  description={`Station: ${station.name}${station.address ? `, ${station.address}` : station.region ? `, ${station.region}` : ''}`}
  image={ogImage}
  ogType="article"
>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 880px;">
      <a href="/bewegbar/" style="color: var(--accent); text-decoration: none; font-size: 14px;">← Zurück zur Karte</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">
        bewegBAR{(station.region || station.country) ? ` · ${station.region || station.country?.toUpperCase()}` : ''}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 0.5rem 0 0.75rem;">
        {station.name}
      </h1>
      {station.address && (
        <p style="font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: var(--text-secondary); margin: 0 0 0.5rem;">
          {station.address}
        </p>
      )}
      {station.visitedAt && (
        <p style="color: var(--text-muted); font-size: 14px; margin: 0;">
          Besucht: {new Date(station.visitedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      )}

      {station.images && station.images.length > 0 && (
        <div style="margin: 2rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
          {station.images.map((img: any) => (
            <SanityImage image={img} width={800} showCaption />
          ))}
        </div>
      )}

      <PortableText value={station.reflection} />

      {(station.communityLink || station.conceptPdfUrl) && (
        <aside style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);">
          <h3 class="eyebrow">Mehr zur Station</h3>
          <ul style="list-style: none; padding: 0; margin-top: 1rem;">
            {station.communityLink && (
              <li><a href={station.communityLink} target="_blank" rel="noopener">Zur Gemeinschaft →</a></li>
            )}
            {station.conceptPdfUrl && (
              <li><a href={station.conceptPdfUrl} target="_blank" rel="noopener">Konzept-PDF →</a></li>
            )}
          </ul>
        </aside>
      )}

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
        <ShareButton title={station.name} />
      </div>
    </div>
  </article>
</BaseLayout>
