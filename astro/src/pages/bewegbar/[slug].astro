---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { sanity, urlFor, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const stations = await sanity.fetch(`
    *[_type == "station" && defined(slug.current)] {
      "slug": slug.current, _id, name, region, country,
      visitedAt, visitedRange, coordinates,
      images, reflection, tags, communityLink,
      "conceptPdfUrl": conceptPdf.asset->url
    }
  `);
  return stations.map((s: any) => ({ params: { slug: s.slug }, props: { station: s } }));
}

const { station } = Astro.props;
---

<BaseLayout title={`${station.name} — BewegBAR`} description={`Station: ${station.name}, ${station.region || station.country}`}>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 880px;">
      <a href="/bewegbar/" style="color: var(--accent-warm); text-decoration: none; font-size: 14px;">← Zurück zur Karte</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">
        BewegBAR · {station.region || station.country?.toUpperCase()}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 0.5rem 0 1rem;">
        {station.name}
      </h1>
      {station.visitedAt && (
        <p style="color: var(--text-secondary); font-size: 14px;">
          Besucht: {new Date(station.visitedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      )}

      {station.images && station.images.length > 0 && (
        <div style="margin: 2rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
          {station.images.map((img: any) => (
            <figure style="margin: 0;">
              <img
                src={urlFor(img).width(800).quality(80).auto('format').url()}
                alt={localized(img.alt) || ''}
                style="width: 100%; height: auto; border-radius: 6px;"
              />
              {img.caption && (
                <figcaption style="margin-top: 0.4rem; font-style: italic; color: var(--text-secondary); font-size: 13px;">
                  {localized(img.caption)}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )}

      <PortableText value={station.reflection} />

      {(station.communityLink || station.conceptPdfUrl) && (
        <aside style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);">
          <h3 class="eyebrow">Mehr zur Station</h3>
          <ul style="list-style: none; padding: 0; margin-top: 1rem;">
            {station.communityLink && (
              <li><a href={station.communityLink} target="_blank" rel="noopener">Zur Gemeinschaft →</a></li>
            )}
            {station.conceptPdfUrl && (
              <li><a href={station.conceptPdfUrl} target="_blank" rel="noopener">Konzept-PDF →</a></li>
            )}
          </ul>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
