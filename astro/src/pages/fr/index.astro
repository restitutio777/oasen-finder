---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="werkSTATT Gemeinschaft — version française (à venir)"
  description="Version française en préparation"
  locale="fr"
>
  <section style="padding: 6rem 0; text-align: center; max-width: 560px; margin: 0 auto;">
    <div class="container">
      <span class="eyebrow">Français · en préparation</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 1rem 0 1.5rem;">
        Bientôt en <em style="color: var(--accent-gold);">français</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: 19px; line-height: 1.6; color: var(--text-body);">
        La version française du site sera disponible lorsque Katharina aura traduit
        les premiers contenus. En attendant, vous pouvez visiter
        <a href="/" style="color: var(--accent-gold);">la version allemande</a>.
      </p>
    </div>
  </section>
</BaseLayout>
