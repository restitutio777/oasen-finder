---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import SanityImage from '../../components/SanityImage.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const events = await sanity.fetch(`
    *[_type == "event" && defined(slug.current)] {
      "slug": slug.current, _id, title, startDate, endDate, ownership,
      season, location, locationCoords, description,
      registration, dogFriendly, fees,
      photo,
      "programPdfUrl": programPdf.asset->url
    }
  `);
  return events.map((e: any) => ({ params: { slug: e.slug }, props: { event: e } }));
}

const { event } = Astro.props;
---

<BaseLayout title={`${localized(event.title) || 'Termin'} — machBAR`}>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <a href="/machbar/" style="color: var(--accent-warm); font-size: 14px;">← Zurück zu den Terminen</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">
        machBAR · {event.ownership === 'eigener' ? 'Eigener Termin' : 'Mit-Termin'}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 0.5rem 0 1rem;">
        {localized(event.title)}
      </h1>
      <p style="font-size: 18px; color: var(--text-body); margin-bottom: 2rem;">
        <strong>{new Date(event.startDate).toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</strong>
        {event.endDate && ` bis ${new Date(event.endDate).toLocaleDateString('de-DE')}`}
        <br />
        {event.location}
      </p>

      {event.dogFriendly && (
        <p style="font-size: 14px; color: var(--accent-warm); margin-bottom: 1.5rem;">
          🐕 Hundefreundlich — Carla ist dabei
        </p>
      )}

      {event.photo && (
        <SanityImage
          image={event.photo}
          width={1200}
          aspect={16 / 9}
          className="machbar-photo"
        />
      )}

      <PortableText value={event.description} />

      {event.fees && (
        <div style="margin-top: 2rem;">
          <h3 class="eyebrow">Rahmenbedingungen</h3>
          <PortableText value={event.fees} />
        </div>
      )}

      {/* Anmeldung-Block nur rendern wenn ein konkreter Weg konfiguriert ist —
          sonst wirkt eine leere "Anmeldung"-Box wie ein Bug. */}
      {(
        (event.registration?.mode === 'mail' && event.registration?.target) ||
        (event.registration?.mode === 'link' && event.registration?.target) ||
        event.registration?.mode === 'formular'
      ) && (
        <aside style="margin-top: 3rem; padding: 1.5rem; background: var(--bg-warm); border-radius: 6px;">
          <h3 class="eyebrow">Anmeldung</h3>
          <p style="margin-top: 0.75rem;">
            {event.registration?.mode === 'mail' && event.registration?.target && (
              <a href={`mailto:${event.registration.target}?subject=Werkstatt-Anmeldung: ${localized(event.title)}`}>
                Per Mail anmelden →
              </a>
            )}
            {event.registration?.mode === 'link' && event.registration?.target && (
              <a href={event.registration.target} target="_blank" rel="noopener">Externe Anmeldung →</a>
            )}
            {event.registration?.mode === 'formular' && (
              <a href="/mitkommen/">Per Formular →</a>
            )}
          </p>
        </aside>
      )}

      {event.programPdfUrl && (
        <p style="margin-top: 2rem;">
          <a href={event.programPdfUrl} target="_blank" rel="noopener">Programm-PDF →</a>
        </p>
      )}
    </div>
  </article>
</BaseLayout>
