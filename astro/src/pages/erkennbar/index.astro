---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import SanityImage from '../../components/SanityImage.astro';
import PageBanner from '../../components/PageBanner.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

let about: any = null;
if (isSanityConfigured) {
  about = await sanity.fetch(`*[_type == "about" && _id == "about"][0]{
    shortBio,
    longBio,
    mantra, influences, notDescribedAs,
    seasonality,
    portraits, invitations,
    roomInvitations
  }`);
}

/**
 * Räume — Konfiguration für die "Schau mal weiter"-Sektion.
 * Default-Texte werden gezeigt, wenn Katharina keine eigene
 * Beschreibung im Studio gesetzt hat.
 */
const roomMeta: Record<string, {
  eyebrow: string;
  prefix: string;
  url: string;
  defaultDescription: string;
}> = {
  schreibbar: {
    eyebrow: 'Notizen',
    prefix: 'schreib',
    url: '/schreibbar/',
    defaultDescription: 'Datierte Einträge — Notizen, Gedichte, Gedanken aus Reisen, Werkstätten und Lektüren',
  },
  bewegbar: {
    eyebrow: 'Reisen',
    prefix: 'beweg',
    url: '/bewegbar/',
    defaultDescription: 'Orte, an denen ich war — Ökodörfer, Cohousing-Projekte und gemeinsame Lebensorte, auf einer Karte',
  },
  machbar: {
    eyebrow: 'Werkstatt',
    prefix: 'mach',
    url: '/machbar/',
    defaultDescription: 'Werkstatt-Termine zum Mitmachen — drei Themen, im Jahres-Rhythmus',
  },
  lesbar: {
    eyebrow: 'Bibliothek',
    prefix: 'les',
    url: '/lesbar/',
    defaultDescription: 'Bücher, Artikel und Quellen zu Fragen des Miteinander',
  },
  brauchbar: {
    eyebrow: 'Werkzeuge',
    prefix: 'brauch',
    url: '/brauchbar/',
    defaultDescription: 'Webseiten, Konzepte und Werkzeuge — was sich in der Praxis als hilfreich erweist',
  },
  hoerbar: {
    eyebrow: 'Audio',
    prefix: 'hör',
    url: '/hoerbar/',
    defaultDescription: 'Eingesprochene Reflexionen, Gedichte, Lieder — plus Gespräche mit Menschen, die in Gemeinschaft leben',
  },
  wunderbar: {
    eyebrow: 'Kreatives',
    prefix: 'wunder',
    url: '/wunderbar/',
    defaultDescription: 'Was nicht in die anderen Räume passt — spielerisch, offen, ungeordnet',
  },
};

// Wenn Katharina nichts gesetzt hat: zeige alle Räume mit Default-Beschreibung.
const roomEntries: Array<{ room: string; description?: any; ctaLabel?: any }> =
  about?.roomInvitations && about.roomInvitations.length > 0
    ? about.roomInvitations
    : Object.keys(roomMeta).map((room) => ({ room }));
---

<BaseLayout title="erkennBAR — werkSTATT Gemeinschaft" description="Wer Katharina Offenborn ist, was sie macht, was sie nicht ist">
  <PageBanner
    photo="/banner/erkennbar-lupine.jpg"
    alt="Blaue Lupinen-Blüte im Vordergrund, dahinter schneebedeckte Berge im Morgenlicht"
    position="center 30%"
  />
  <section class="who" id="erkennbar">
    <div class="container">
      <div class={`who__inner${about?.portraits?.[0] ? '' : ' who__inner--solo'}`}>
        {about?.portraits?.[0] && (
          <SanityImage
            image={about.portraits[0]}
            alt={localized(about.portraits[0].alt) || 'Katharina Offenborn'}
            width={600}
            eager
            className="who__portrait"
          />
        )}
        <div class="who__body">
          <span class="eyebrow">Über mich</span>
          <h2 class="who__title">Katharina <em>Offenborn</em></h2>
          {/* Das Mantra wird seit jüngerem auf der Landing direkt unter
              dem Fold gerendert — hier auf der erkennBAR-Seite wäre es
              Doppelung. Feld bleibt im Sanity-Schema bestehen. */}
          {about?.shortBio && <PortableText value={about.shortBio} />}
          {about?.longBio && (
            <div style="margin-top: 1.5rem;">
              <PortableText value={about.longBio} />
            </div>
          )}
          {!about && (
            <p style="color: var(--text-secondary);">
              Vollständige Bio kommt aus Sanity — sobald das Studio aufgesetzt ist und
              Katharina die erkennBAR-Felder gefüllt hat.
            </p>
          )}
        </div>
      </div>

      {about?.notDescribedAs && about.notDescribedAs.length > 0 && (
        <aside style="max-width: 760px; margin: 3rem auto 0; padding: 1.5rem; background: var(--bg-warm); border-radius: 6px;">
          <h3 class="eyebrow">Bitte nicht so</h3>
          <p style="margin-top: 0.75rem; font-family: var(--font-display); font-style: italic;">
            Kein {about.notDescribedAs.join(', kein ')}.
          </p>
        </aside>
      )}

      {about?.seasonality && (
        <aside style="max-width: 760px; margin: 2rem auto 0;">
          <h3 class="eyebrow">Jahres-Rhythmus</h3>
          <PortableText value={about.seasonality} />
        </aside>
      )}
    </div>
  </section>

  {/* "Schau mal weiter" — Einladungen in die einzelnen Räume.
       Beschreibungen kommen aus Sanity (about.roomInvitations) mit
       Default-Fallback pro Raum. */}
  <section style="padding: 5rem 0; background: var(--bg-warm);">
    <div class="container">
      <header style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
        <span class="eyebrow">Schau mal weiter</span>
        <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.6rem 0 0; color: var(--text-primary);">
          Die <em>Räume</em>
        </h2>
        <p style="color: var(--text-secondary); margin-top: 1rem; font-size: 16px;">
          Sieben Türen, wenn du mehr entdecken willst.
        </p>
      </header>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 960px; margin: 0 auto;">
        {roomEntries.map((entry) => {
          const meta = roomMeta[entry.room];
          if (!meta) return null;
          const customDesc = entry.description;
          const customCta = localized(entry.ctaLabel);
          return (
            <a
              href={meta.url}
              style="display: flex; flex-direction: column; gap: 0.75rem; padding: 2rem; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-elevated); text-decoration: none; color: var(--text-primary); transition: transform 0.15s ease, border-color 0.15s ease;"
              onmouseover="this.style.borderColor='var(--accent)'; this.style.transform='translateY(-2px)';"
              onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
            >
              <span class="eyebrow" style="color: var(--accent);">{meta.eyebrow}</span>
              <h3 style="font-family: var(--font-display); font-size: 1.7rem; margin: 0; color: var(--text-primary);">
                {meta.prefix}<em>BAR</em>
              </h3>
              {customDesc ? (
                <div style="color: var(--text-secondary); font-family: var(--font-display); font-size: 17px; line-height: 1.55;">
                  <PortableText value={customDesc} />
                </div>
              ) : (
                <p style="color: var(--text-secondary); margin: 0; font-family: var(--font-display); font-size: 17px; line-height: 1.55;">
                  {meta.defaultDescription}
                </p>
              )}
              <span style="margin-top: auto; color: var(--accent); font-size: 14px;">
                {customCta || `Zur ${meta.prefix}BAR →`}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <NewsletterBlock variant="page" />
</BaseLayout>
