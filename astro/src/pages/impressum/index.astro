---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum — werkSTATT Gemeinschaft" description="Anbieter und verantwortliche Stelle">
  <section style="padding: 4rem 0; max-width: 720px; margin: 0 auto;">
    <div class="container">
      <span class="eyebrow">Pflichtangaben</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); margin: 1rem 0 2rem;">
        Impressum
      </h1>

      <h2 style="font-family: var(--font-display); margin-top: 2rem;">Anbieterin</h2>
      <p>
        Katharina Offenborn<br />
        Am Tunnel 2<br />
        36391 Sinntal-Sterbfritz
      </p>

      <h2 style="font-family: var(--font-display); margin-top: 2rem;">Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:katharina.offenborn@googlemail.com">katharina.offenborn@googlemail.com</a>
      </p>

      <h2 style="font-family: var(--font-display); margin-top: 2rem;">Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV</h2>
      <p>Katharina Offenborn (Anschrift wie oben)</p>

      <h2 style="font-family: var(--font-display); margin-top: 2rem;">Hinweis</h2>
      <p style="font-style: italic; color: var(--text-secondary);">
        Vor dem öffentlichen Launch wird dieses Impressum durch einen
        DSGVO-konformen Generator (z.B. eRecht24 oder Datenschutz-Generator.de)
        finalisiert und um die volle Haftungs- und Urheberrechts-Information
        ergänzt.
      </p>
    </div>
  </section>
</BaseLayout>
