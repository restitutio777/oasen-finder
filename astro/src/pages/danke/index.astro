---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Danke — werkSTATT Gemeinschaft" description="Deine Nachricht ist angekommen">
  <section style="padding: 6rem 0; text-align: center; max-width: 560px; margin: 0 auto;">
    <div class="container">
      <span class="eyebrow">Angekommen</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); margin: 1rem 0 1.5rem;">
        Danke <em style="color: var(--accent);">—</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: 19px; line-height: 1.6; color: var(--text-body);">
        Deine Nachricht ist da. Ich antworte gern, wenn auch nicht immer schnell.
      </p>
      <p style="margin-top: 3rem;">
        <a href="/" class="btn btn--ghost">Zurück zur Startseite</a>
      </p>
    </div>
  </section>
</BaseLayout>
