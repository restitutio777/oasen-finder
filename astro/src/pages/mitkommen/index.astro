---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import PageBanner from '../../components/PageBanner.astro';
import { sanity, localized, isSanityConfigured, RICH_TEXT_QUERY } from '../../lib/sanity';

let config: any = null;
if (isSanityConfigured) {
  config = await sanity.fetch(`*[_type == "contact" && _id == "contact"][0]{
    intro ${RICH_TEXT_QUERY},
    emailRecipient, inviteCategories[active == true], feesNote
  }`);
}

const categories = config?.inviteCategories || [
  { kind: 'werkstatt', label: { de: 'Werkstatt-Teilnahme' } },
  { kind: 'einladung', label: { de: 'Einladung in unsere Gemeinschaft' } },
  { kind: 'vortrag', label: { de: 'Vortrag oder Impuls' } },
  { kind: 'beratung', label: { de: 'Beratung beim Aufbau einer Gemeinschaft' } },
  { kind: 'gespraech', label: { de: 'Persönliches Gespräch' } },
  { kind: 'vernetzung', label: { de: 'Bei der Vernetzung helfen' } },
];
---

<BaseLayout title="Mitkommen — werkSTATT Gemeinschaft" description="Drei Wege zu Katharina">
  <PageBanner
    photo="photo-1517842645767-c639042777db"
    alt="Hände schreiben mit Stift in ein offenes Notizbuch"
  />
  <section class="invite" id="mitkommen">
    <div class="container">
      <header class="invite__head">
        <span class="eyebrow invite__eyebrow">Begegnung</span>
        <h1 class="invite__title">Mitkommen</h1>
        {config?.intro
          ? <div class="invite__sub"><PortableText value={config.intro} /></div>
          : <p class="invite__sub">Schreib mir, was du brauchst — ich antworte gern, wenn auch nicht immer schnell.</p>
        }
      </header>

      <form
        id="mitkommen-form"
        method="post"
        action="/api/mitkommen/"
        novalidate
        style="max-width: 640px; margin: 3rem auto; display: grid; gap: 1.25rem;"
      >
        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Dein Name</span>
          <input type="text" name="name" required minlength="2" maxlength="200" autocomplete="name" style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;" />
        </label>

        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Deine Mail-Adresse</span>
          <input type="email" name="email" required autocomplete="email" style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;" />
        </label>

        <fieldset style="display: grid; gap: 0.75rem; border: 1px solid var(--border-subtle); padding: 1.5rem; border-radius: 4px;">
          <legend class="eyebrow">Worum geht es?</legend>
          {categories.map((cat: any) => (
            <label style="display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer;">
              <input type="checkbox" name="anliegen" value={cat.kind} style="margin-top: 4px;" />
              <span>
                <strong style="font-family: var(--font-display);">{localized(cat.label)}</strong>
                {cat.description && (
                  <small style="display: block; color: var(--text-secondary); margin-top: 0.2rem;">
                    {localized(cat.description)}
                  </small>
                )}
              </span>
            </label>
          ))}
        </fieldset>

        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Deine Nachricht</span>
          <textarea name="message" rows="6" required minlength="5" maxlength="8000" style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;"></textarea>
        </label>

        {/* Honeypot — versteckt vor Menschen, Bots füllen es. tabindex=-1 + autocomplete=off als zusätzliche Hinweise. */}
        <div aria-hidden="true" style="position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden;">
          <label>
            Bitte leer lassen
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <button type="submit" class="btn btn--primary" id="mitkommen-submit">Absenden →</button>

        <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">
          Rahmenbedingungen (Honorar, Reisekosten, Mindestgruppe) besprechen wir individuell.
        </p>

        {/* Status-Boxen — initial versteckt, werden vom Script eingeblendet */}
        <div
          id="mitkommen-success"
          role="status"
          hidden
          style="margin-top: 1.5rem; padding: 1.25rem 1.5rem; border-radius: 4px; background: var(--accent-warm); color: var(--bg-primary); font-family: var(--font-display); font-size: 18px; line-height: 1.5;"
        >
          <strong style="display: block; font-size: 22px; margin-bottom: 0.4rem;">Danke!</strong>
          Deine Nachricht ist angekommen. Ich melde mich, sobald ich Ruhe finde.
        </div>

        <div
          id="mitkommen-error"
          role="alert"
          hidden
          style="margin-top: 1.5rem; padding: 1.25rem 1.5rem; border-radius: 4px; background: var(--accent); color: var(--bg-primary); font-family: var(--font-text); font-size: 15px; line-height: 1.5;"
        >
          <strong style="display: block; font-size: 16px; margin-bottom: 0.4rem;">Da ist etwas schiefgelaufen.</strong>
          <span id="mitkommen-error-text">Bitte versuche es nochmal, oder schreib direkt an <a href="mailto:katharina.offenborn@googlemail.com" style="color: var(--bg-primary); text-decoration: underline;">katharina.offenborn@googlemail.com</a>.</span>
        </div>
      </form>

      <p class="invite__signature">— Katharina Offenborn</p>
    </div>
  </section>

  <script is:inline>
  (function () {
    const form = document.getElementById('mitkommen-form');
    if (!form) return;
    const submit = document.getElementById('mitkommen-submit');
    const successBox = document.getElementById('mitkommen-success');
    const errorBox = document.getElementById('mitkommen-error');
    const errorText = document.getElementById('mitkommen-error-text');
    const originalLabel = submit ? submit.textContent : 'Absenden →';

    function showSuccess() {
      if (errorBox) errorBox.hidden = true;
      if (successBox) {
        successBox.hidden = false;
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      form.reset();
    }

    function showError(msg) {
      if (successBox) successBox.hidden = true;
      if (errorBox && errorText) {
        if (msg) errorText.textContent = msg;
        errorBox.hidden = false;
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (successBox) successBox.hidden = true;
      if (errorBox) errorBox.hidden = true;

      // Native required-Check
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Wird gesendet …';
      }

      // Form-Daten sammeln, anliegen[] als Array
      const fd = new FormData(form);
      const anliegen = fd.getAll('anliegen');
      const payload = {
        name: String(fd.get('name') || ''),
        email: String(fd.get('email') || ''),
        message: String(fd.get('message') || ''),
        anliegen: anliegen,
        _hp: String(fd.get('_hp') || ''),
      };

      try {
        const res = await fetch('/api/mitkommen/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        let data = {};
        try { data = await res.json(); } catch (_) {}

        if (res.ok && data && data.ok) {
          showSuccess();
        } else {
          showError(data && data.error ? data.error : null);
        }
      } catch (err) {
        showError('Verbindung zum Server fehlgeschlagen. Bist du offline?');
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  })();
  </script>
</BaseLayout>
