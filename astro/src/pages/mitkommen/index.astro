---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

let config: any = null;
if (isSanityConfigured) {
  config = await sanity.fetch(`*[_type == "contact" && _id == "contact"][0]{
    intro, emailRecipient, inviteCategories[active == true], feesNote
  }`);
}

const categories = config?.inviteCategories || [
  { kind: 'werkstatt', label: { de: 'Werkstatt-Teilnahme' } },
  { kind: 'einladung', label: { de: 'Einladung in unsere Gemeinschaft' } },
  { kind: 'vortrag', label: { de: 'Vortrag oder Impuls' } },
  { kind: 'beratung', label: { de: 'Beratung beim Aufbau einer Gemeinschaft' } },
  { kind: 'gespraech', label: { de: 'Persönliches Gespräch' } },
  { kind: 'vernetzung', label: { de: 'Bei der Vernetzung helfen' } },
];

const mailTo = config?.emailRecipient || 'kontakt@werkstatt-gemeinschaft.example';
---

<BaseLayout title="Mitkommen — WERKstatt Gemeinschaft" description="Drei Wege zu Katharina">
  <section class="invite" id="mitkommen">
    <div class="container">
      <header class="invite__head">
        <span class="eyebrow invite__eyebrow">Begegnung</span>
        <h1 class="invite__title">Mit<em>kommen</em>.</h1>
        <p class="invite__sub">
          {config?.intro ? localized(config.intro) : 'Schreib mir, was du brauchst — ich antworte gern, wenn auch nicht immer schnell.'}
        </p>
      </header>

      {/* Echtes Formular — wird in Phase 1 mit Netlify-Forms / Formspree / Vercel
           Function für Server-Submit ausgestattet. Hier vorerst: mailto-Fallback. */}
      <form
        action={`mailto:${mailTo}`}
        method="post"
        enctype="text/plain"
        style="max-width: 640px; margin: 3rem auto; display: grid; gap: 1.25rem;"
      >
        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Dein Name</span>
          <input type="text" name="name" required style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;" />
        </label>

        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Deine Mail-Adresse</span>
          <input type="email" name="email" required style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;" />
        </label>

        <fieldset style="display: grid; gap: 0.75rem; border: 1px solid var(--border-subtle); padding: 1.5rem; border-radius: 4px;">
          <legend class="eyebrow">Worum geht es?</legend>
          {categories.map((cat: any) => (
            <label style="display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer;">
              <input type="checkbox" name="anliegen" value={cat.kind} style="margin-top: 4px;" />
              <span>
                <strong style="font-family: var(--font-display);">{localized(cat.label)}</strong>
                {cat.description && (
                  <small style="display: block; color: var(--text-secondary); margin-top: 0.2rem;">
                    {localized(cat.description)}
                  </small>
                )}
              </span>
            </label>
          ))}
        </fieldset>

        <label style="display: grid; gap: 0.4rem;">
          <span class="eyebrow">Deine Nachricht</span>
          <textarea name="message" rows="6" required style="padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: 4px; font-family: var(--font-text); font-size: 16px;"></textarea>
        </label>

        <button type="submit" class="btn btn--primary">Absenden →</button>

        <p style="font-size: 13px; color: var(--text-secondary);">
          Rahmenbedingungen (Honorar, Reisekosten, Mindestgruppe) besprechen wir individuell.
        </p>
      </form>

      <p class="invite__signature">— Katharina Offenborn</p>
    </div>
  </section>
</BaseLayout>
