---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';
import { withSafeSlugs } from '../../lib/slug.js';

/**
 * brauchBAR — Webseiten, Konzepte und Werkzeuge für die Praxis des
 * Miteinander.
 *
 * Schwester-Raum zur lesBAR: lesBAR zeigt Quellen (Bücher, Artikel,
 * Filme, Podcasts), brauchBAR zeigt Webseiten, Konzepte und Werkzeuge
 * (Kath 18.07.: „Webseite, Konzept, Werkzeug") — dieselbe
 * Sanity-Resource-Schema, andere kind-Filterung.
 *
 * Eigene Detail-Pages unter /brauchbar/[slug]/ (Kath · 19.05.: URL
 * soll zum Eingangs-Raum passen). lesBAR/[slug] filtert webseite/
 * konzept/werkzeug raus, jeder Doc hat genau eine kanonische URL.
 */

let resources: any[] = [];
if (isSanityConfigured) {
  resources = await sanity.fetch(`
    *[_type == "resource" && kind in ["webseite", "konzept", "werkzeug"]] | order(_createdAt desc) {
      _id, title, kind, authorOrSource, note, "slug": slug.current
    }
  `);
  /* Gleiche Slug-Absicherung wie in brauchbar/[slug].astro — sonst zeigt
     die Liste auf eine Adresse, die es dort nicht gibt. */
  resources = withSafeSlugs(resources);
}

const byKind = resources.reduce((acc: Record<string, any[]>, r) => {
  const k = r.kind || 'andere';
  acc[k] = acc[k] || [];
  acc[k].push(r);
  return acc;
}, {});

// Rubriken-Reihenfolge fix (Katharinas Nennung), nicht nach Erstelldatum
const kindOrder = ['webseite', 'konzept', 'werkzeug'];
const sortedKinds = Object.entries(byKind).sort(
  ([a], [b]) => kindOrder.indexOf(a) - kindOrder.indexOf(b),
);

const kindLabels: Record<string, string> = {
  webseite: 'Webseiten',
  konzept: 'Konzepte',
  werkzeug: 'Werkzeuge',
};
---

<BaseLayout title="brauchBAR — werkSTATT Gemeinschaft" description="Webseiten, Konzepte und Werkzeuge für die Praxis des Miteinander">
  <PageBanner
    photo="photo-1590880795696-20c7dfadacde"
    alt="Traditionelle Holz-Werkstatt mit Werkzeugen, Werkbänken und warmem Tageslicht durch Fenster"
    position="center 30%"
  />
  <section style="padding: 4rem 0;">
    <div class="container">
      <span class="eyebrow">Werkzeuge</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); margin: 1rem 0;">
        brauch<em>BAR</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--text-secondary); margin-bottom: 1rem;">
        Webseiten, Konzepte und Werkzeuge
      </p>
      <p style="max-width: 640px; color: var(--text-body); margin-bottom: 2rem;">
        Was sich in der Praxis als hilfreich erweist — gesammelte Webseiten,
        Konzepte, Methoden und kleine Werkzeuge für das Miteinander-Leben,
        -Arbeiten und -Reden
      </p>

      {resources.length === 0 && (
        <p style="color: var(--text-secondary);">Noch keine Einträge — die brauchBAR füllt sich, sobald die ersten Konzepte und Werkzeuge in Sanity stehen.</p>
      )}

      {sortedKinds.map(([kind, items]) => (
        <section style="margin-bottom: 3rem;">
          <h2 class="eyebrow">{kindLabels[kind] || kind}</h2>
          <ul style="list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 1rem;">
            {items.map((r) => (
              <li>
                <a href={`/brauchbar/${r.slug}/`} style="display: block; padding: 1rem 1.5rem; background: var(--bg-elevated); border-radius: 6px; text-decoration: none; color: inherit;">
                  <h3 style="font-family: var(--font-display); margin: 0;">{localized(r.title)}</h3>
                  {r.authorOrSource && (
                    <p style="font-size: 14px; color: var(--text-muted); margin-top: 0.25rem;">{r.authorOrSource}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
