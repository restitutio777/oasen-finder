---
/**
 * brauchBAR-Detail — Konzepte und Werkzeuge.
 *
 * Schwester-Route zu /lesbar/[slug]: beide Pages teilen das Sanity-
 * Schema `resource`, getrennt nur durch den kind-Filter. Konzepte
 * und Werkzeuge leben unter brauchBAR (eigener Raum, eigene URL),
 * Bücher/Artikel/Filme/Podcasts/Gespräche unter lesBAR.
 *
 * Render-Logik bewusst identisch zu lesbar/[slug].astro gehalten —
 * gleiche Felder, gleiches Layout, nur Raum-Label und Zurück-Link
 * abweichend. Wenn das Layout dort iteriert wird, sollte hier
 * nachgezogen werden.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import MediaLink from '../../components/MediaLink.astro';
import ShareButton from '../../components/ShareButton.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  const resources = await sanity.fetch(`
    *[_type == "resource" && kind in ["konzept", "werkzeug"] && defined(slug.current)] {
      "slug": slug.current, _id, title, kind, authorOrSource,
      note,
      link,
      "coverUrl": coverImage.asset->url,
      "pdfUrl": pdfAttachment.asset->url
    }
  `);
  return resources.map((r: any) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props;

const kindLabels: Record<string, string> = {
  konzept: 'Konzept',
  werkzeug: 'Werkzeug',
};

const resourceTitle = localized(resource.title) || 'Eintrag';
// OG-Image: Cover, wenn vorhanden — sonst greift BaseLayouts eigener
// Marken-Default (kein Unsplash-Fallback mehr, 03.07.).
const ogImage = resource.coverUrl
  ? `${resource.coverUrl}?w=1200&h=630&fit=crop&auto=format&q=85`
  : undefined;
---

<BaseLayout
  title={`${resourceTitle} — brauchBAR`}
  description={`${kindLabels[resource.kind] || 'Werkzeug'}${resource.authorOrSource ? ` — ${resource.authorOrSource}` : ''}`}
  image={ogImage}
  ogType="article"
>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <a href="/brauchbar/" style="color: var(--accent); font-size: 14px;">← Zurück zur brauchBAR</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">brauchBAR · {kindLabels[resource.kind] || resource.kind}</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 0.5rem;">
        {localized(resource.title)}
      </h1>
      {resource.authorOrSource && (
        <p style="color: var(--text-secondary); font-style: italic; margin-bottom: 2rem;">{resource.authorOrSource}</p>
      )}

      {resource.coverUrl && (
        <img src={resource.coverUrl} alt="" style="max-width: 300px; margin: 1rem 0 2rem; border-radius: 4px;" />
      )}

      <PortableText value={resource.note} />

      {resource.link && <MediaLink url={resource.link} label="Zur Quelle" />}

      {resource.pdfUrl && (
        <p style="margin-top: 1rem;">
          <a href={resource.pdfUrl} target="_blank" rel="noopener">Dokument herunterladen →</a>
        </p>
      )}

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
        <ShareButton title={resourceTitle} />
      </div>
    </div>
  </article>
</BaseLayout>
