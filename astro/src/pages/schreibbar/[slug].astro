---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import SanityImage from '../../components/SanityImage.astro';
import MediaLink from '../../components/MediaLink.astro';
import ShareButton from '../../components/ShareButton.astro';
import { sanity, urlFor, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];

  /* Filter: nur notiz/poesie unter /schreibbar/{slug} — idee/vision/
     umfrage werden unter /denkbar/{slug} ausgespielt (Katharinas
     Entscheidung 19.05.: eigener denkBAR-Raum). */
  const notes = await sanity.fetch(`
    *[_type == "note" && kind in ["notiz", "poesie"] && defined(slug.current)] {
      "slug": slug.current,
      _id, title, kind, publishedAt,
      body,
      tags, hero,
      mediaLink, externalLink, substackUrl,
      "pdfUrl": pdfAttachment.asset->url
    }
  `);

  return notes.map((note: any) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;

const kindLabels: Record<string, string> = {
  notiz: 'Notiz',
  poesie: 'Poesie',
  idee: 'Idee · denkBAR',
  vision: 'Vision · denkBAR',
  umfrage: 'Umfrage · denkBAR',
};

// OG-Image: hero-Bild der Notiz, wenn vorhanden — sonst Fallback
// auf das schreibBAR-Mood-Banner. 1200×630 ist die Standard-OG-Größe.
const fallbackOgPhoto =
  'https://images.unsplash.com/photo-1733819109723-92a56f6872a5?w=1200&h=630&fit=crop&q=85';
const ogImage = note.hero?.asset
  ? urlFor(note.hero).width(1200).height(630).fit('crop').auto('format').quality(85).url()
  : fallbackOgPhoto;
const noteTitle = localized(note.title) || 'Notiz';
---

<BaseLayout
  title={`${noteTitle} — schreibBAR`}
  description={`schreibBAR-Eintrag vom ${new Date(note.publishedAt).toLocaleDateString('de-DE')}`}
  image={ogImage}
  ogType="article"
>
  <article style="padding: 4rem 0; max-width: 720px; margin: 0 auto;">
    <div class="container">
      <a href="/schreibbar/" style="color: var(--accent); text-decoration: none; font-size: 14px;">
        ← Zurück zur schreibBAR
      </a>
      <span class="entry__tag" data-tag={note.kind} style="display: inline-block; margin-top: 1.5rem;">
        {kindLabels[note.kind] || note.kind}
      </span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 0.5rem 0 1rem;">
        {localized(note.title)}
      </h1>
      <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 2rem;">
        {new Date(note.publishedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>

      <SanityImage
        image={note.hero}
        width={1200}
        aspect={16 / 9}
        eager
        showCaption
        className="schreibbar-hero"
      />

      <PortableText value={note.body} />

      {/* Medien-Link: YouTube/Spotify/Apple Music werden direkt
          eingebettet, Telegram bekommt eine eigene Card,
          alles andere klassischer Link. */}
      {note.mediaLink && <MediaLink url={note.mediaLink} />}

      {(note.externalLink || note.substackUrl || note.pdfUrl) && (
        <aside style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);">
          <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--text-muted); margin-bottom: 1rem;">
            Weiterlesen
          </h3>
          <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {note.externalLink && (
              <li><a href={note.externalLink} target="_blank" rel="noopener">Externer Link →</a></li>
            )}
            {note.substackUrl && (
              <li><a href={note.substackUrl} target="_blank" rel="noopener">Auf Substack →</a></li>
            )}
            {note.pdfUrl && (
              <li><a href={note.pdfUrl} target="_blank" rel="noopener">Dokument herunterladen →</a></li>
            )}
          </ul>
        </aside>
      )}

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
        <ShareButton title={noteTitle} />
      </div>
    </div>
  </article>
</BaseLayout>
