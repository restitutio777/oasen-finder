---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShare from '../../components/PageShare.astro';
import PageBanner from '../../components/PageBanner.astro';
import ListFilter from '../../components/ListFilter.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';
import { withSafeSlugs } from '../../lib/slug.js';
import {
  SCHREIBBAR_KINDS,
  SCHREIBBAR_KIND_FILTER,
  noteKindLabel,
} from '../../lib/noteKinds.js';

/**
 * schreibBAR — Einträge-Liste.
 * Lädt alle Einträge aus Sanity, nach Datum absteigend sortiert.
 * Arten (Gedanke, Tagebucheintrag, Reisebericht, Begegnung, Brief, Poesie)
 * stehen in `lib/noteKinds.js` — dort ändern, nicht hier.
 */

let notes: any[] = [];

if (isSanityConfigured) {
  /* Alles außer idee/vision/umfrage — die leben seit 19.05. in /denkbar/
     (Katharinas Entscheidung: eigener Raum für die Zukunftsschmiede).
     Bewusst als Ausschluss formuliert: eine neue Art im Studio erscheint
     damit automatisch hier, statt lautlos zu verschwinden. */
  notes = await sanity.fetch(`
    *[_type == "note" && ${SCHREIBBAR_KIND_FILTER}] | order(publishedAt desc) {
      _id, title, kind, publishedAt, "slug": slug.current,
      tags, "hero": hero { asset->{ url, metadata { dimensions } }, alt, caption }
    }
  `);
  /* Gleiche Slug-Absicherung wie in schreibbar/[slug].astro — sonst zeigt
     die Liste auf eine Adresse, die es dort nicht gibt. */
  notes = withSafeSlugs(notes);
}

/* Art-Filter: erscheint erst ab FILTER_THRESHOLD Einträgen automatisch und
   nur, wenn mindestens zwei Arten vorkommen. Reihenfolge und Beschriftung
   kommen aus lib/noteKinds.js; Arten ohne Eintrag fallen raus, damit keine
   leeren Knöpfe in der Leiste stehen. */
const FILTER_THRESHOLD = 20;
const noteCounts: Record<string, number> = {};
for (const n of notes) {
  if (n.kind) noteCounts[n.kind] = (noteCounts[n.kind] ?? 0) + 1;
}
const filters = SCHREIBBAR_KINDS
  .filter((k) => noteCounts[k.value])
  .map((k) => ({ value: k.value, label: k.label, count: noteCounts[k.value] }));
const showFilter = notes.length >= FILTER_THRESHOLD && filters.length >= 2;
---

<BaseLayout
  title="schreibBAR — werkSTATT Gemeinschaft"
  description="Notizen, Gedichte und Gedanken aus der werkSTATT Gemeinschaft."
>
  <PageBanner
    photo="/banner/schreibbar-fueller.jpeg"
    alt="Hand mit Füller schreibt in ein Notizbuch — Tinten-Schrift gut sichtbar, intime Schreib-Atmosphäre"
    position="center center"
  />
  <section class="chronicle" id="schreibbar">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">Notizen · Der rote Faden</span>
          <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); margin: 1rem 0;">
            schreib<em>BAR</em>
          </h1>
          <p style="font-family: var(--font-display); font-size: calc(clamp(1.1rem, 2vw, 1.4rem) * var(--lese-skala, 1)); font-style: italic; color: var(--text-secondary); margin-bottom: 1rem;">
            Notizen, Gedichte, Gedanken
          </p>
          <p class="section-head__sub">
            Stationen, Werkstätten, Lektüren — datiert, kurz aufgeschrieben.
            Hier sammelt sich der Faden
          </p>
        </div>
      </header>

      {notes.length === 0 && (
        <div style="padding: 3rem 0; text-align: center; color: var(--text-secondary);">
          <p>Noch keine Einträge — die schreibBAR füllt sich bald.</p>
        </div>
      )}

      {notes.length > 0 && (
        <div class="filterable">
        {showFilter && <ListFilter filters={filters} total={notes.length} />}
        <ol class="chronicle__list">
          {notes.map((note, idx) => (
            <li class={`entry filterable-item${idx >= 8 ? ' is-hidden' : ''}`} data-kind={note.kind}>
              <span class="entry__bead" aria-hidden="true"></span>
              <div class="entry__date">
                <span class="entry__day">{new Date(note.publishedAt).getDate()}</span>
                <span class="entry__month">
                  {new Date(note.publishedAt).toLocaleDateString('de-DE', { month: 'long' })}
                </span>
                <span class="entry__year">{new Date(note.publishedAt).getFullYear()}</span>
              </div>
              <div class="entry__body">
                <span class="entry__tag" data-tag={note.kind}>
                  {noteKindLabel(note.kind)}
                </span>
                <h3 class="entry__title">
                  <a href={`/schreibbar/${note.slug}/`}>{localized(note.title)}</a>
                </h3>
              </div>
            </li>
          ))}
        </ol>
        {notes.length > 8 && (
          <div class="load-more-wrap">
            <button class="load-more" type="button">Weitere anzeigen ({notes.length - 8})</button>
          </div>
        )}
        </div>
      )}
    </div>
  </section>
  <PageShare title="schreibBAR — werkSTATT Gemeinschaft" text="Notizen von unterwegs — Beobachtungen aus Gemeinschaftsorten." />
</BaseLayout>
