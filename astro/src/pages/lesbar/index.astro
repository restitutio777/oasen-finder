---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShare from '../../components/PageShare.astro';
import PageBanner from '../../components/PageBanner.astro';
import { sanity, localized, isSanityConfigured } from '../../lib/sanity';
import { withSafeSlugs } from '../../lib/slug.js';

let resources: any[] = [];
if (isSanityConfigured) {
  // webseite/konzept/werkzeug-Resources leben jetzt unter /brauchbar/
  // — die lesBAR zeigt nur Bücher, Artikel, Filme, Podcasts, Gespräche.
  resources = await sanity.fetch(`
    *[_type == "resource" && !(kind in ["webseite", "konzept", "werkzeug"])] | order(_createdAt desc) {
      _id, title, kind, authorOrSource, "slug": slug.current,
      "thumb": coverImage { asset->{ url } }
    }
  `);
  /* Gleiche Slug-Absicherung wie in lesbar/[slug].astro — sonst zeigt
     die Liste auf eine Adresse, die es dort nicht gibt. */
  resources = withSafeSlugs(resources);
}

// Gruppierung nach kind
const byKind = resources.reduce((acc: Record<string, any[]>, r) => {
  const k = r.kind || 'andere';
  acc[k] = acc[k] || [];
  acc[k].push(r);
  return acc;
}, {});

const kindLabels: Record<string, string> = {
  buch: 'Bücher',
  aufsatz: 'Aufsätze',
  film: 'Filme',
  podcast: 'Podcasts',
  gespraech: 'Gespräche',
};
---

<BaseLayout title="lesBAR — werkSTATT Gemeinschaft" description="Bücher, Artikel und Gedichte zu Fragen des Miteinander">
  <PageBanner
    photo="/banner/lesbar-buecherregal.jpeg"
    alt="Dreireihiges Bücherregal mit bunten Buchrücken — oben Orange/Rot, mittig Grün/Gelb, unten Blau"
    position="center center"
  />
  <section style="padding: 4rem 0;">
    <div class="container">
      <span class="eyebrow">Bibliothek</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); margin: 1rem 0;">
        les<em>BAR</em>
      </h1>
      <p style="font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--text-secondary); margin-bottom: 1rem;">
        Quellen, Werkzeuge, Stimmen
      </p>
      <p style="max-width: 640px; color: var(--text-body); margin-bottom: 2rem;">
        Bücher, Artikel und Gedichte zu Fragen des Miteinander —
        mit kurzer Notiz, warum sie hier stehen. Für Webseiten, Konzepte
        und Werkzeuge siehe die <a href="/brauchbar/">brauchBAR</a>
      </p>

      {resources.length === 0 && (
        <p style="color: var(--text-secondary);">Noch keine Einträge — die lesBAR füllt sich bald.</p>
      )}

      {Object.entries(byKind).map(([kind, items]) => (
        <section style="margin-bottom: 3rem;">
          <h2 class="eyebrow">{kindLabels[kind] || kind}</h2>
          <ul style="list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 1rem;">
            {items.map((r) => (
              <li>
                <a href={`/lesbar/${r.slug}/`} style="display: block; padding: 1rem 1.5rem; background: var(--bg-elevated); border-radius: 6px; text-decoration: none; color: inherit;">
                  <h3 style="font-family: var(--font-display); margin: 0;">{localized(r.title)}</h3>
                  {r.authorOrSource && (
                    <p style="font-size: 14px; color: var(--text-muted); margin-top: 0.25rem;">{r.authorOrSource}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <PageShare title="lesBAR — werkSTATT Gemeinschaft" text="Bücher, Artikel und Gedichte zu Fragen des Miteinander." />
</BaseLayout>
