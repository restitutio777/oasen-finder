---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import MediaLink from '../../components/MediaLink.astro';
import ShareButton from '../../components/ShareButton.astro';
import { sanity, urlFor, localized, isSanityConfigured } from '../../lib/sanity';

export async function getStaticPaths() {
  if (!isSanityConfigured) return [];
  /* Filter: kind nicht in konzept/werkzeug — diese leben unter
     /brauchbar/[slug]. Sonst entstünden zwei URLs pro Doc, die
     gleichen Inhalt zeigen (URL-Sprung-Problem aus der Karten-
     Analyse — Kath stimmte 19.05. der Trennung zu). */
  const resources = await sanity.fetch(`
    *[_type == "resource" && !(kind in ["konzept", "werkzeug"]) && defined(slug.current)] {
      "slug": slug.current, _id, title, kind, authorOrSource,
      note,
      link,
      "coverUrl": coverImage.asset->url,
      "pdfUrl": pdfAttachment.asset->url
    }
  `);
  return resources.map((r: any) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props;

const kindLabels: Record<string, string> = {
  buch: 'Buch',
  webseite: 'Webseite',
  aufsatz: 'Aufsatz',
  film: 'Film',
  podcast: 'Podcast',
  gespraech: 'Gespräch',
  konzept: 'Konzept · brauchBAR',
  werkzeug: 'Werkzeug · brauchBAR',
};

const resourceTitle = localized(resource.title) || 'Eintrag';
// Sanity-CDN-URLs unterstützen URL-Parameter für OG-Crop direkt.
// Ohne Cover greift BaseLayouts eigener Marken-Default (kein
// Unsplash-Fallback mehr, 03.07.).
const ogImage = resource.coverUrl
  ? `${resource.coverUrl}?w=1200&h=630&fit=crop&auto=format&q=85`
  : undefined;
---

<BaseLayout
  title={`${resourceTitle} — lesBAR`}
  description={`${kindLabels[resource.kind] || 'Quelle'}${resource.authorOrSource ? ` — ${resource.authorOrSource}` : ''}`}
  image={ogImage}
  ogType="article"
>
  <article style="padding: 4rem 0;">
    <div class="container" style="max-width: 720px;">
      <a href="/lesbar/" style="color: var(--accent); font-size: 14px;">← Zurück zur Bibliothek</a>
      <span class="eyebrow" style="display: inline-block; margin-top: 1.5rem;">lesBAR · {kindLabels[resource.kind] || resource.kind}</span>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 0.5rem;">
        {localized(resource.title)}
      </h1>
      {resource.authorOrSource && (
        <p style="color: var(--text-secondary); font-style: italic; margin-bottom: 2rem;">{resource.authorOrSource}</p>
      )}

      {resource.coverUrl && (
        <img src={resource.coverUrl} alt="" style="max-width: 300px; margin: 1rem 0 2rem; border-radius: 4px;" loading="lazy" decoding="async" />
      )}

      <PortableText value={resource.note} />

      {/* Quellen-Link: YouTube/Spotify werden direkt eingebettet,
          Telegram bekommt eine Card, alles andere klassischer Link. */}
      {resource.link && <MediaLink url={resource.link} label="Zur Quelle" />}

      {resource.pdfUrl && (
        <p style="margin-top: 1rem;">
          <a href={resource.pdfUrl} target="_blank" rel="noopener">Dokument herunterladen →</a>
        </p>
      )}

      <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
        <ShareButton title={resourceTitle} />
      </div>
    </div>
  </article>
</BaseLayout>
