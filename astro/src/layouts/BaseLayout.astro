---
/**
 * Basis-Layout für alle Seiten.
 * Lädt globale Styles, Fonts, Brand-Header und Footer.
 */
/* Schriften self-hosted (DSGVO: keine Verbindung zu Google-Fonts-CDN).
   Cormorant Garamond: 400/500/600 + Italic 400/500 — Inter: 400/500/600/700. */
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Aktuelle Locale für hreflang-Tags */
  locale?: 'de' | 'fr' | 'en';
  /** Pfad ohne Locale-Präfix für hreflang (z.B. "/bewegbar/") */
  path?: string;
  /**
   * Bild für Open Graph / Twitter Card.
   * Akzeptiert volle URL oder relative URL — bei Unsplash-Photo-IDs
   * einfach `https://images.unsplash.com/photo-…?w=1200&h=630&fit=crop`
   * oder bei Sanity-Asset-URLs die `url`-Property mit `?w=1200&h=630`.
   * Wenn nicht gesetzt: Brand-Default (Schreibhände auf Papier).
   */
  image?: string;
  /** Open Graph type — z.B. „article" für Detail-Seiten */
  ogType?: 'website' | 'article';
}

const siteUrl = 'https://reise-zueinander.de';
/* Brand-OG-Image (1200×630): Cream + warmer Bronze-Wash mit Logo +
   Headline. Lokal in public/og-image.png. Vorher war Unsplash-Foto-
   Fallback — jetzt eigene Marke. */
const defaultOgImage = `${siteUrl}/og-image.png`;

const {
  title = 'werkSTATT Gemeinschaft — Katharina Offenborn',
  description = 'werkSTATT Gemeinschaft — Miteinander vereinBAR, GemeinschaftsWERK statt allein unterwegs. Katharina Offenborn auf Reisen zu Ökodörfern, Cohousing-Projekten und gemeinsamen Lebensorten.',
  locale = 'de',
  path = Astro.url.pathname,
  image = defaultOgImage,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = `${siteUrl}${path}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const ogLocale = locale === 'de' ? 'de_DE' : locale === 'fr' ? 'fr_FR' : 'en_US';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="0mGGlMdKMw3QY04YgtIyP9aUL2NBNtjwDHjaIcc_GPc" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Schriften werden lokal ausgeliefert (self-hosted via @fontsource,
        Import im Frontmatter) — keine Verbindung zu Google-Servern. */}

    {/* hreflang-Alternativen für i18n */}
    <link rel="alternate" hreflang="de" href={`${siteUrl}${path}`} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}/fr${path}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en${path}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${path}`} />

    {/* Open Graph — für Vorschau-Cards in WhatsApp, Signal, Mail,
        Mastodon, Slack, iMessage, LinkedIn, … */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="werkSTATT Gemeinschaft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    {/* Twitter Card — größere Vorschau */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {/* Vercel Analytics — ohne Cookies, anonymisiert.
        (Speed Insights ist im Hobby-Plan auf ein Projekt limitiert,
        nutzen wir hier nicht.) */}
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>

    {/* Listing-Limit (Stufe 1 aus Katharinas Wachstums-Plan, 19.05.):
        Jede Raum-Liste zeigt initial nur die ersten N Einträge (per
        .is-hidden auf späteren Items). Ein „Weitere anzeigen"-Button
        blendet beim Klick alle weiteren Items ein. Reine Progressive-
        Enhancement-Lösung — ohne JS sind eh alle Items im HTML, der
        Button macht sie nur sichtbar. */}
    <script is:inline>
      document.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('.load-more') : null;
        if (!btn) return;
        /* Nur wenn tatsächlich eine Filterleiste da ist, steuert das
           Filter-Script (unten) „Weitere anzeigen" selbst. Ohne Leiste
           (unter der Schwelle) bleibt dieser einfache Handler zuständig. */
        const box = btn.closest('.filterable');
        if (box && box.querySelector('.list-filter')) return;
        const wrap = btn.closest('.load-more-wrap');
        if (!wrap || !wrap.parentElement) return;
        wrap.parentElement.querySelectorAll('.is-hidden').forEach((el) => el.classList.remove('is-hidden'));
        wrap.remove();
      });
    </script>

    {/* Art-Filter (hörBAR, schreibBAR …): erscheint ab Schwelle automatisch
        (Rendering + Schwelle in ListFilter.astro bzw. der Seite). Steuert
        Sichtbarkeit der Items und das Zusammenspiel mit „Weitere anzeigen":
        - „Alle": erste 8 sichtbar, Button blendet den Rest ein (wie gehabt).
        - Eine Art gewählt: alle Einträge dieser Art sichtbar, Button aus. */}
    <script is:inline>
      document.querySelectorAll('.filterable').forEach((box) => {
        const bar = box.querySelector('.list-filter');
        if (!bar) return; // unter der Schwelle: kein Filter, Standard-Handler greift
        const items = Array.from(box.querySelectorAll('.filterable-item'));
        const buttons = Array.from(bar.querySelectorAll('.list-filter__btn'));
        const moreWrap = box.querySelector('.load-more-wrap');
        // „Overflow"-Items = die, die initial per is-hidden versteckt sind
        const overflow = new WeakSet();
        items.forEach((li) => { if (li.classList.contains('is-hidden')) overflow.add(li); });
        let active = 'all';
        let expanded = false;

        const apply = () => {
          items.forEach((li) => {
            const kind = li.getAttribute('data-kind') || '';
            const show = active === 'all' ? (expanded || !overflow.has(li)) : kind === active;
            li.classList.toggle('is-hidden', !show);
          });
          if (moreWrap) {
            const showMore = active === 'all' && !expanded && items.some((li) => overflow.has(li));
            moreWrap.style.display = showMore ? '' : 'none';
          }
          buttons.forEach((b) => {
            const on = b.getAttribute('data-filter') === active;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        };

        bar.addEventListener('click', (e) => {
          const b = e.target instanceof Element ? e.target.closest('.list-filter__btn') : null;
          if (!b) return;
          active = b.getAttribute('data-filter') || 'all';
          apply();
        });
        if (moreWrap) {
          moreWrap.addEventListener('click', (e) => {
            if (!(e.target instanceof Element) || !e.target.closest('.load-more')) return;
            expanded = true;
            apply();
          });
        }
        apply();
      });
    </script>
  </body>
</html>
