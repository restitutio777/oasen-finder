---
/**
 * Basis-Layout für alle Seiten.
 * Lädt globale Styles, Fonts, Brand-Header und Footer.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Aktuelle Locale für hreflang-Tags */
  locale?: 'de' | 'fr' | 'en';
  /** Pfad ohne Locale-Präfix für hreflang (z.B. "/bewegbar/") */
  path?: string;
}

const {
  title = 'werkSTATT Gemeinschaft — Katharina Offenborn',
  description = 'werkSTATT Gemeinschaft — Miteinander vereinBAR, GemeinschaftsWERK statt allein unterwegs. Katharina Offenborn auf Reisen zu Ökodörfern, Cohousing-Projekten und gemeinsamen Lebensorten.',
  locale = 'de',
  path = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Fonts — preconnect + load */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* hreflang-Alternativen für i18n */}
    <link rel="alternate" hreflang="de" href={`https://oasen-finder.vercel.app${path}`} />
    <link rel="alternate" hreflang="fr" href={`https://oasen-finder.vercel.app/fr${path}`} />
    <link rel="alternate" hreflang="en" href={`https://oasen-finder.vercel.app/en${path}`} />
    <link rel="alternate" hreflang="x-default" href={`https://oasen-finder.vercel.app${path}`} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {/* Vercel Analytics + Speed Insights — beide ohne Cookies,
        anonymisiert. Werden client-side geladen, kein Privacy-Impact
        gegenüber dem Standard-Setup. */}
    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>
