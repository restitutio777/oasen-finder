---
/**
 * Site-Header mit Brand und Top-Navigation.
 * Mirror der aktuellen index.html-Header-Struktur — funktioniert mit
 * dem migrierten global.css.
 *
 * Active-State: jeder Raum hat eine eigene Akzentfarbe, die als
 * dezenter Underline auf dem aktiven Nav-Eintrag erscheint.
 * Konsistent mit den Karten in der Landing-Übersicht.
 */
const locale = 'de'; // TODO: aus Astro.params.locale ableiten wenn FR/EN aktiv
const path = Astro.url.pathname;

// Farb-Trias der Räume, deckungsgleich mit den Karten auf der Landing.
// Jede Farbe hat eine klare Rolle: Clay-Rot = Wärme/Aktion (schreibBAR
// → roter Faden), Fern-Grün = Natur (bewegBAR), Bronze = Werkstatt
// (machBAR), Slate-Blau = Reflexion (lesBAR), Mauve-Rose = Intimität
// (hörBAR), Sage = leichtfüssig (wunderBAR). Gold bleibt der Brand-
// Wortmarke und der zentralen Hero-Frage vorbehalten.
// Eurythmie-Räume-Farben (palette-eurythmie):
//   Coral-Rosa  schreibBAR · Anker
//   Mint        bewegBAR   · Bewegung
//   Altgold     machBAR    · Werkstatt
//   Warm-Grey   lesBAR     · ruhiger Pol
//   Aubergine   brauchBAR  · Werkzeuge
//   Plum        hörBAR     · Intim
//   Sage tiefer wunderBAR  · leicht
const roomAccent: Record<string, string> = {
  '/schreibbar': 'var(--accent-deep)',  // Plum — meditativ-warm, statt Coral (raus)
  '/bewegbar': 'var(--accent-blue)',
  '/machbar': 'var(--accent)',
  '/lesbar': 'var(--neutral)',
  '/brauchbar': 'var(--text-primary)',
  '/hoerbar': 'var(--accent-deep)',
  '/wunderbar': 'var(--accent-green)',
  '/erkennbar': 'var(--text-primary)',
  '/mitkommen': 'var(--accent-blue)',   // Türkis — Echo zum Logo-„Gemeinschaft"
};

const isActive = (prefix: string): boolean => path === prefix || path.startsWith(prefix + '/');
const accentFor = (prefix: string): string => roomAccent[prefix] ?? 'var(--accent)';
// --nav-accent wird IMMER gesetzt (nicht nur bei active), damit jedes
// Item permanent eine 14px Mini-Subline in seiner Raum-Farbe zeigt.
// aria-current bleibt nur auf dem aktiven Eintrag.
const navProps = (prefix: string) => ({
  'aria-current': isActive(prefix) ? 'page' as const : undefined,
  style: `--nav-accent: ${accentFor(prefix)};`,
});

const dropdownPaths = ['/lesbar', '/brauchbar', '/hoerbar', '/wunderbar', '/erkennbar'];
const dropdownActive = dropdownPaths.find((p) => isActive(p));
const dropdownProps = {
  'aria-current': dropdownActive ? 'page' as const : undefined,
  style: dropdownActive ? `--nav-accent: ${accentFor(dropdownActive)};` : undefined,
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="WERKSTATT Gemeinschaft — Startseite">
      <span class="brand__noun">WERKSTATT</span>
      <em class="brand__qualifier">Gemeinschaft</em>
    </a>
    <nav class="nav" id="primary-nav" aria-label="Hauptnavigation">
      <a href="/schreibbar/" {...navProps('/schreibbar')}>schreibBAR</a>
      <a href="/bewegbar/" {...navProps('/bewegbar')}>bewegBAR</a>
      <a href="/machbar/" {...navProps('/machbar')}>machBAR</a>
      <div class="nav-group">
        <button
          class="nav-group__trigger"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          {...dropdownProps}
        >
          Räume <span class="nav-group__caret" aria-hidden="true">↓</span>
        </button>
        <div class="nav-group__menu" role="menu">
          <a href="/lesbar/" role="menuitem" {...navProps('/lesbar')}>lesBAR</a>
          <a href="/brauchbar/" role="menuitem" {...navProps('/brauchbar')}>brauchBAR</a>
          <a href="/hoerbar/" role="menuitem" {...navProps('/hoerbar')}>hörBAR</a>
          <a href="/wunderbar/" role="menuitem" {...navProps('/wunderbar')}>wunderBAR</a>
          <a href="/erkennbar/" role="menuitem" {...navProps('/erkennbar')}>Über mich</a>
        </div>
      </div>
      <a href="/mitkommen/" {...navProps('/mitkommen')}>Mitkommen</a>
    </nav>
    <button
      class="nav-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="primary-nav"
      type="button"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  // Mobile hamburger
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
      nav.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
