---
/**
 * NewsletterBlock — Substack-Anmelde-Widget mit Brand-Anpassung.
 *
 * Lädt das Substack-Custom-Widget client-side via Script-Tag.
 * Farben werden an die Site-Palette angepasst, sodass das Formular
 * wie ein nativer Block wirkt (kein iframe-Look).
 *
 * Konfiguration kommt aus Sanity contact.newsletter, mit Fallback
 * auf hardcoded Default falls Sanity nicht erreichbar.
 */
import { sanity, localized, isSanityConfigured } from '../lib/sanity';

interface Props {
  /** Optionale Variante für unterschiedliche Page-Kontexte. */
  variant?: 'landing' | 'page';
}
const { variant = 'landing' } = Astro.props;

let config: any = null;
if (isSanityConfigured) {
  config = await sanity.fetch(`*[_type == "contact" && _id == "contact"][0]{
    newsletter
  }`);
}

const substackHandle = config?.newsletter?.target || 'katharinaoffenborn';
const label = localized(config?.newsletter?.label) || 'Brief von unterwegs';
const text = localized(config?.newsletter?.text) || 'Eine leise Notiz, wenn etwas Neues entsteht — Reise, Werkstatt, Lesefrucht. Kein Plan, kein Rhythmus.';

// Eindeutige ID, falls die Komponente mehrfach auf der Seite ist
const widgetId = `substack-embed-${variant}`;

// Newsletter sitzt auf der Landing als letzte Section vor dem Footer.
// Hintergrund identisch mit der Mitkommen-Section drüber
// (--bg-warm-soft) — kein Sprung dazwischen, beide bilden eine
// ruhige Cream-Zone. Der Footer setzt klar mit Gold-Ocker an, eine
// feine Plum-Saumlinie (siehe global.css .site-footer) markiert
// die Trennung sauber. Alle anderen Pages bleiben auf --bg-base.
const bgColor = variant === 'landing' ? 'var(--bg-warm-soft)' : 'var(--bg-base)';
---

<section class="newsletter-section" style={`background: ${bgColor};`}>
  <div class="container newsletter-section__inner">
    <span class="eyebrow eyebrow--balanced newsletter-section__eyebrow">Newsletter</span>
    <h2 class="newsletter-section__title">
      {label.split(' ').map((word: string, i: number, arr: string[]) =>
        i === arr.length - 1
          ? <em>{word}</em>
          : <>{word}{' '}</>
      )}
    </h2>
    <p class="newsletter-section__lead">
      {text}
    </p>

    {/* Substack custom widget mount-point */}
    <div id={widgetId} class="substack-embed"></div>

    <p class="newsletter-section__fine">
      Versand über Substack. Du kannst dich jederzeit abmelden.
    </p>
  </div>
</section>

<script is:inline define:vars={{ substackHandle, widgetId }}>
  // Globale Widget-Config — Substack liest das beim Load
  window.CustomSubstackWidget = {
    substackUrl: `${substackHandle}.substack.com`,
    placeholder: 'deine@mail.de',
    buttonText: 'Abonnieren',
    theme: 'custom',
    colors: {
      primary: '#c89a78',     // --accent · Champagne-Gold
      input: '#ffffff',       // --bg-elevated · pure white
      email: '#2d2435',       // --text-primary · Aubergine-Plum
      text: '#fbf6f3',        // --bg-base · warm off-white (Button-Label)
    },
    // Wo soll das Widget eingehängt werden
    target: `#${widgetId}`,
  };

  // Script nur einmal pro Page laden, auch wenn der Block doppelt vorkommt
  if (!document.querySelector('script[data-substack-widget]')) {
    const s = document.createElement('script');
    s.src = 'https://substackapi.com/widget.js';
    s.async = true;
    s.dataset.substackWidget = 'true';
    document.body.appendChild(s);
  }
</script>

<style>
  .newsletter-section {
    padding: 3.5rem 0 5rem;
  }
  .newsletter-section__inner {
    max-width: 640px;
    text-align: center;
  }
  .newsletter-section__eyebrow {
    color: var(--accent-deep);
  }
  .newsletter-section__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 0.8rem 0 1.25rem;
  }
  .newsletter-section__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent-deep);
    /* Letztes Wort der Headline italic + Plum — gibt der Zeile
       eine geschwungene Schluss-Geste, ähnlich „Mitkommen". */
  }
  .newsletter-section__lead {
    color: var(--text-body);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    margin: 0 auto 2rem;
    max-width: 520px;
  }
  .newsletter-section__fine {
    margin-top: 1rem;
    font-size: 13px;
    color: var(--text-muted);
  }
  .substack-embed {
    max-width: 480px;
    margin: 0 auto;
  }
</style>
