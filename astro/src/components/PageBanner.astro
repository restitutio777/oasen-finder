---
/**
 * PageBanner — schmaler Mood-Banner oben auf jeder Hauptseite.
 *
 * Akzeptiert zwei Foto-Quellen:
 *   1. Unsplash-Photo-ID ("photo-XXXXX...") → über deren CDN mit srcset
 *      in vier Grössen, WebP/AVIF auto.
 *   2. Lokaler Pfad ("/hero/...jpeg") → direkt aus astro/public/, ohne
 *      srcset-Optimierung (lokale Bilder werden statisch ausgeliefert).
 *
 * Aspect-Ratio fix, damit kein Layout-Shift entsteht. Keine Overlays
 * oder Effekte — Foto pur als Mood-Element.
 */
interface Props {
  /**
   * Foto-Quelle. Entweder Unsplash-Photo-ID ("photo-XXXXX...") oder
   * lokaler Pfad mit führendem Slash ("/hero/foto.jpeg").
   */
  photo: string;
  /** Beschreibender Alt-Text für Screenreader */
  alt: string;
  /**
   * Position des Bildausschnitts bei Crop. Default: center.
   * Akzeptiert Keywords ('center', 'top', 'bottom', …) oder beliebige
   * CSS-`object-position`-Strings wie `'center 65%'`, um den Fokus
   * gezielt nach oben/unten zu verschieben.
   */
  position?: string;
}
const { photo, alt, position = 'center' } = Astro.props;
const isLocal = photo.startsWith('/');
const base = isLocal ? photo : `https://images.unsplash.com/${photo}`;
const params = 'auto=format&fit=crop';
---

<div class="page-banner">
  {isLocal ? (
    <img
      src={base}
      alt={alt}
      width="1600"
      height="600"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${position};`}
    />
  ) : (
    <img
      src={`${base}?w=1600&q=80&${params}`}
      srcset={`
        ${base}?w=800&q=80&${params} 800w,
        ${base}?w=1200&q=80&${params} 1200w,
        ${base}?w=1600&q=80&${params} 1600w,
        ${base}?w=2400&q=75&${params} 2400w
      `.trim().replace(/\s+/g, ' ')}
      sizes="100vw"
      alt={alt}
      width="1600"
      height="600"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${position};`}
    />
  )}
</div>
