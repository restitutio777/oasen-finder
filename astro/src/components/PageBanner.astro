---
/**
 * PageBanner — schmaler Mood-Banner oben auf jeder Hauptseite.
 *
 * Lädt ein Unsplash-Foto via deren CDN, automatisch im richtigen Format
 * (WebP/AVIF) und in vier Größen für srcset. Aspect-Ratio fix, damit kein
 * Layout-Shift entsteht. Auf Mobile etwas höher (mehr Atmosphäre auf wenig
 * Breite). Keine Overlays, keine Effekte — Foto pur als Mood-Element.
 *
 * Bilder ersetzen: einfach `photo`-Prop auf eine andere Unsplash-Photo-ID
 * setzen (Format: "photo-XXXXX..."). Die URL-Logik bleibt gleich.
 */
interface Props {
  /** Unsplash-Photo-ID, z.B. "photo-1455390582262-044cdead277a" */
  photo: string;
  /** Beschreibender Alt-Text für Screenreader */
  alt: string;
  /** Position des Bildausschnitts bei Crop. Default: center */
  position?: 'center' | 'top' | 'bottom' | 'left' | 'right';
}
const { photo, alt, position = 'center' } = Astro.props;
const base = `https://images.unsplash.com/${photo}`;
const params = 'auto=format&fit=crop';
---

<div class="page-banner">
  <img
    src={`${base}?w=1600&q=80&${params}`}
    srcset={`
      ${base}?w=800&q=80&${params} 800w,
      ${base}?w=1200&q=80&${params} 1200w,
      ${base}?w=1600&q=80&${params} 1600w,
      ${base}?w=2400&q=75&${params} 2400w
    `.trim().replace(/\s+/g, ' ')}
    sizes="100vw"
    alt={alt}
    width="1600"
    height="600"
    loading="eager"
    fetchpriority="high"
    style={`object-position: ${position};`}
  />
</div>
