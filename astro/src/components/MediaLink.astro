---
/**
 * MediaLink — Smart-Detection für Medien-URLs.
 *
 * Statt einen blanken Link zu zeigen, erkennt diese Komponente die
 * Plattform und rendert das passende Embed:
 *
 *   - YouTube  → eingebetteter Player (16/9, lazy load)
 *   - Spotify  → eingebetteter Player (Track / Album / Episode / Show)
 *   - Apple Music → eingebetteter Player
 *   - Vimeo    → eingebetteter Player
 *   - SoundCloud → eingebetteter Player
 *   - Telegram → schöne Card mit Telegram-Icon, Klick öffnet App/Web
 *   - sonst    → klassischer Link mit Pfeil
 *
 * Plattform-Wechsel erfordert kein Eintrag-Update — Katharina pflegt
 * einfach die URL ein, der Rest passiert automatisch.
 */
interface Props {
  url: string;
  /** Optional: Label statt URL-Anzeige bei Fallback */
  label?: string;
}
const { url, label } = Astro.props;

type Platform =
  | { type: 'youtube'; embed: string }
  | { type: 'spotify'; embed: string }
  | { type: 'apple-music'; embed: string }
  | { type: 'vimeo'; embed: string }
  | { type: 'soundcloud'; embed: string }
  | { type: 'telegram' }
  | { type: 'other' };

function detectPlatform(u: string): Platform {
  // YouTube — youtube.com/watch?v=X, youtu.be/X, youtube.com/shorts/X
  const ytMatch =
    u.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
  if (ytMatch) return { type: 'youtube', embed: `https://www.youtube-nocookie.com/embed/${ytMatch[1]}` };

  // Spotify — open.spotify.com/track|album|episode|show|playlist/ID
  const spMatch = u.match(/open\.spotify\.com\/(track|album|episode|show|playlist)\/([a-zA-Z0-9]+)/);
  if (spMatch) return { type: 'spotify', embed: `https://open.spotify.com/embed/${spMatch[1]}/${spMatch[2]}` };

  // Apple Music — music.apple.com/... → embed-Variante
  if (u.includes('music.apple.com')) {
    return { type: 'apple-music', embed: u.replace('music.apple.com', 'embed.music.apple.com') };
  }

  // Vimeo
  const vMatch = u.match(/vimeo\.com\/(\d+)/);
  if (vMatch) return { type: 'vimeo', embed: `https://player.vimeo.com/video/${vMatch[1]}` };

  // SoundCloud
  if (u.includes('soundcloud.com')) {
    return {
      type: 'soundcloud',
      embed: `https://w.soundcloud.com/player/?url=${encodeURIComponent(u)}&color=%23c89a78&inverse=false&auto_play=false&show_user=true`,
    };
  }

  // Telegram — t.me/X oder telegram.me/X
  if (u.includes('t.me/') || u.includes('telegram.me/')) return { type: 'telegram' };

  return { type: 'other' };
}

const platform = detectPlatform(url);
---

{platform.type === 'youtube' && (
  <div style="aspect-ratio: 16/9; margin: 1.5rem 0; max-width: 720px; background: var(--bg-warm);">
    <iframe
      src={platform.embed}
      title="YouTube-Video"
      style="width: 100%; height: 100%; border: 0; border-radius: 4px; display: block;"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
)}

{platform.type === 'spotify' && (
  <iframe
    src={platform.embed}
    style="width: 100%; max-width: 720px; height: 352px; margin: 1.5rem 0; border: 0; border-radius: 12px; display: block;"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
  ></iframe>
)}

{platform.type === 'apple-music' && (
  <iframe
    src={platform.embed}
    style="width: 100%; max-width: 720px; height: 175px; margin: 1.5rem 0; border: 0; border-radius: 10px; display: block;"
    allow="autoplay *; encrypted-media *; clipboard-write"
    sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
    loading="lazy"
  ></iframe>
)}

{platform.type === 'vimeo' && (
  <div style="aspect-ratio: 16/9; margin: 1.5rem 0; max-width: 720px; background: var(--bg-warm);">
    <iframe
      src={platform.embed}
      title="Vimeo-Video"
      style="width: 100%; height: 100%; border: 0; border-radius: 4px; display: block;"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
)}

{platform.type === 'soundcloud' && (
  <iframe
    src={platform.embed}
    style="width: 100%; max-width: 720px; height: 166px; margin: 1.5rem 0; border: 0; display: block;"
    allow="autoplay"
    loading="lazy"
  ></iframe>
)}

{platform.type === 'telegram' && (
  <a
    href={url}
    target="_blank"
    rel="noopener"
    style="display: inline-flex; align-items: center; gap: 0.7rem; padding: 0.75rem 1.25rem; background: var(--bg-warm); border: 1px solid var(--border-subtle); border-radius: 4px; text-decoration: none; color: var(--text-primary); margin: 1.5rem 0; transition: border-color 0.18s, transform 0.18s;"
    onmouseover="this.style.borderColor='var(--accent)'; this.style.transform='translateY(-1px)';"
    onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='translateY(0)';"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
    </svg>
    {label || 'Auf Telegram öffnen'}
    <span style="color: var(--accent); font-size: 14px;">→</span>
  </a>
)}

{platform.type === 'other' && (
  <p style="margin: 1.5rem 0;">
    <a
      href={url}
      target="_blank"
      rel="noopener"
      style="color: var(--accent); text-decoration: underline; text-underline-offset: 3px;"
    >
      {label || url} →
    </a>
  </p>
)}
