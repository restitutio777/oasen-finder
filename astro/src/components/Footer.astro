---
/**
 * Site-Footer mit Brand, Erkunden-Navigation, Kontakt-Mail.
 * Telegram-Link erscheint nur wenn in Sanity contact.telegramUrl gesetzt.
 *
 * Erkunden-Spalte zeigt immer alle BARs — auch auf der Landing.
 * Die kleine Redundanz mit „Wohin als nächstes?" weiter oben ist
 * akzeptabel; konsistenter Footer wirkt sauberer als ein zwei-
 * Spalten-Layout mit ungenutztem Leerraum rechts.
 */
import { sanity, isSanityConfigured } from '../lib/sanity';

let contact: any = null;
if (isSanityConfigured) {
  contact = await sanity.fetch(`*[_type == "contact" && _id == "contact"][0]{
    telegramUrl
  }`);
}
const telegramUrl: string | null = contact?.telegramUrl || null;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__brand">
          <span class="site-footer__brand-noun">WERKSTATT</span>
          {' '}
          <em class="site-footer__brand-qualifier">Gemeinschaft</em>
        </p>
        <p class="site-footer__intro">
          Eine fortlaufende Werkstatt von Reisen, Begegnungen und Lesefrüchten —
          geführt von Katharina Offenborn. Wächst, wenn etwas wachsen will.
        </p>
      </div>
      <div>
        <h4>Erkunden</h4>
        <nav class="site-footer__nav" aria-label="Footer-Navigation">
          <a href="/schreibbar/">schreibBAR</a>
          <a href="/bewegbar/">bewegBAR</a>
          <a href="/machbar/">machBAR</a>
          <a href="/lesbar/">lesBAR</a>
          <a href="/brauchbar/">brauchBAR</a>
          <a href="/hoerbar/">hörBAR</a>
          <a href="/wunderbar/">wunderBAR</a>
          <a href="/erkennbar/">Über mich</a>
          <a href="/mitkommen/">Kontakt</a>
        </nav>
      </div>
      <div>
        <h4>Kontakt</h4>
        <div class="site-footer__contact">
          <a href="/mitkommen/">Kontakt-Formular</a>
          {telegramUrl && (
            <a href={telegramUrl} target="_blank" rel="noopener" class="site-footer__telegram" aria-label="Auf Telegram folgen">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: -2px; margin-right: 0.4rem;">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              Telegram
            </a>
          )}
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>
        © 2026 Katharina Offenborn · WERKSTATT Gemeinschaft
        <span class="site-footer__credit">
          · <a href="https://site-web-intuitif.fr/" target="_blank" rel="noopener">Webdesign?</a>
        </span>
      </span>
      <button
        class="scroll-to-top"
        type="button"
        aria-label="Nach oben scrollen"
        onclick="window.scrollTo({top:0,behavior:'smooth'})"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m18 15-6-6-6 6" />
        </svg>
      </button>
    </div>
  </div>
</footer>
