---
/**
 * Site-Footer mit Brand, Erkunden-Navigation, Kontakt-Mail.
 */
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__brand">
          <span class="site-footer__brand-noun">
            <span class="brand__verb">werk</span><span class="werk-accent">STATT</span>
          </span>
          {' '}
          <em class="site-footer__brand-qualifier">Gemeinschaft</em>
        </p>
        <p class="site-footer__intro">
          Eine fortlaufende Werkstatt von Reisen, Begegnungen und Lesefrüchten —
          geführt von Katharina Offenborn. Wächst, wenn etwas wachsen will.
        </p>
      </div>
      <div>
        <h4>Erkunden</h4>
        <nav class="site-footer__nav" aria-label="Footer-Navigation">
          <a href="/erkennbar/">erkennBAR</a>
          <a href="/schreibbar/">schreibBAR</a>
          <a href="/bewegbar/">bewegBAR</a>
          <a href="/machbar/">machBAR</a>
          <a href="/lesbar/">lesBAR</a>
          <a href="/hoerbar/">hörBAR</a>
          <a href="/mitkommen/">Mitkommen</a>
        </nav>
      </div>
      <div>
        <h4>Kontakt</h4>
        <div class="site-footer__contact">
          <a href="/mitkommen/">Kontakt-Formular</a>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© 2026 Katharina Offenborn · werkSTATT Gemeinschaft</span>
      <button
        class="scroll-to-top"
        type="button"
        aria-label="Nach oben scrollen"
        onclick="window.scrollTo({top:0,behavior:'smooth'})"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m18 15-6-6-6 6" />
        </svg>
      </button>
    </div>
  </div>
</footer>
