---
/**
 * Übersetzungen unter dem deutschen Text (09.09.26).
 *
 * Bewusst die einfachste Lösung: KEINE eigenen Sprach-Adressen, kein
 * Sprachumschalter im Menü, keine Browser-Erkennung. Wenn Katharina im
 * Studio unter „Übersetzungen (optional)" Englisch oder Französisch
 * ausfüllt, erscheint die Fassung aufklappbar unter dem deutschen Beitrag
 * — plus ein Hinweis oben (TranslationLink.astro). Sonst gar nichts.
 *
 * Die Überschrift des Aufklappers ist der ÜBERSETZTE TITEL selbst, nicht
 * ein erklärender Satz: der Leser sieht sofort, worum es geht, und nichts
 * wiederholt sich (Betreiber, 09.09.).
 *
 * Verwendung — direkt hinter dem deutschen <PortableText>:
 *   <Translations title={note.title} body={note.body} />
 */
import PortableText from './PortableText.astro';
import { availableTranslations } from '../lib/sanity';

export interface Props {
  /** i18nString mit dem Titel */
  title?: any;
  /** i18nText mit dem Fließtext ({ de, fr, en }) */
  body?: any;
}

const { title, body } = Astro.props;
const translations = availableTranslations(body, title);
---

{translations.length > 0 && (
  <section class="translations">
    {translations.map((t) => (
      <details class="translations__item" id={t.anchor}>
        <summary class="translations__summary" lang={t.locale}>
          {/* Ohne erkennbaren Titel wäre der Eyebrow über „English version"
              nur eine Dopplung — dann trägt die eine Zeile alles. */}
          {t.hasTitle && <span class="eyebrow">{t.locale === 'en' ? 'English' : 'Français'}</span>}
          <h2 class="translations__title">{t.heading}</h2>
        </summary>
        <div class="translations__body" lang={t.locale}>
          <PortableText value={t.blocks} />
        </div>
      </details>
    ))}
  </section>
)}

<script>
  /* Hinweis oben (TranslationLink) klappt den Text unten mit auf — sonst
     landet der Leser auf einer zugeklappten Zeile und muss ein zweites Mal
     klicken. Gleiches beim Aufruf mit Anker in der Adresse, damit ein
     direkt verschickter Link (…/beitrag/#uebersetzung-en) sofort den
     englischen Text zeigt.

     Das Ausrichten übernimmt scrollIntoView, NICHT der native Ankersprung:
     der findet statt, bevor der Aufklapper offen ist. Und es geschieht
     mehrfach, weil Bilder oberhalb des Ankers ihre Höhe erst mit dem Laden
     bekommen und den Anker danach verschieben — ohne die Wiederholung
     landet der Leser 100 Pixel daneben (Betreiber, 10.09.). Den Abstand zum
     klebenden Header hält scroll-margin-top frei, das respektiert
     scrollIntoView von sich aus. */
  function findeAufklapper(anchor: string | null): HTMLDetailsElement | null {
    if (!anchor) return null;
    const target = document.getElementById(anchor);
    return target instanceof HTMLDetailsElement ? target : null;
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-translation-jump]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = findeAufklapper(link.dataset.translationJump ?? null);
      if (!target) return;
      // Selbst ausrichten statt den Browser springen zu lassen: erst öffnen,
      // dann scrollen — sonst zielt der Sprung auf die zugeklappte Zeile.
      event.preventDefault();
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', `#${target.id}`);
    });
  });

  if (location.hash) {
    const target = findeAufklapper(decodeURIComponent(location.hash.slice(1)));
    if (target) {
      target.open = true;
      const ausrichten = () => target.scrollIntoView();
      ausrichten();
      requestAnimationFrame(ausrichten);
      if (document.readyState !== 'complete') {
        window.addEventListener('load', () => requestAnimationFrame(ausrichten), { once: true });
      }
      // Auch nach dem Eintreffen der Schriften: die Display-Schrift ändert
      // die Höhe des deutschen Textes ÜBER dem Anker, und der Sprung des
      // Browsers passiert davor. Ohne diese Korrektur landet der Leser rund
      // 120 Pixel zu weit unten — am Textanfang statt am Titel.
      document.fonts?.ready.then(() => requestAnimationFrame(ausrichten));
    }
  }
</script>

<style>
  .translations {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .translations__item {
    /* Sprungziel unter dem klebenden Header freihalten — sonst landet die
       Überschrift dahinter und der Leser sieht nur noch den Textanfang
       (Betreiber, 10.09.). Höhe kommt aus derselben Variablen wie der
       Header selbst, damit beides nicht auseinanderlaufen kann. */
    scroll-margin-top: calc(var(--header-height, 72px) + 1.5rem);
  }
  .translations__summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.35rem 0;
  }
  .translations__summary::-webkit-details-marker {
    display: none;
  }
  /* Aufklapp-Zustand am Titel zeigen, nicht über ein zusätzliches Symbol:
     ein Pfeil, der sich dreht — dieselbe Sprache wie der Hinweis oben. */
  .translations__title::after {
    content: '↓';
    font-size: 0.55em;
    opacity: 0.55;
    display: inline-block;
    /* Abstand und Höhe eigens setzen: direkt an den Buchstaben geklebt und
       auf der Grundlinie sitzend wirkte der Pfeil wie ein Tippfehler. */
    margin-left: 0.5em;
    vertical-align: 0.35em;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .translations__summary:hover .translations__title::after {
    opacity: 0.9;
  }
  .translations__summary:hover .eyebrow {
    color: var(--accent, #c89a78);
  }
  .translations__item[open] .translations__title::after {
    transform: rotate(180deg);
    vertical-align: 0.1em;
  }
  /* Als <h2> gesetzt: Schriftschnitt, Laufweite, Zeilenhöhe und Farbe
     kommen damit aus derselben Regel wie die deutsche Überschrift
     (h1, h2, h3 in global.css). Die Größe holt sich die Zeile aus
     --article-title-size, die jede Beitragsseite auf ihrem <article>
     setzt — die englische Überschrift ist dadurch IMMER genauso groß wie
     die deutsche, auch wenn ein Raum eine andere Größe verwendet
     (bewegBAR und machBAR sind größer, Betreiber 10.09.). */
  .translations__title {
    margin: 0;
    font-size: var(--article-title-size, clamp(2rem, 4vw, 3rem));
    transition: color 200ms ease;
  }
  .translations__summary:hover .translations__title {
    color: var(--accent, #c89a78);
  }
  .translations__body {
    margin-top: 1.5rem;
  }
  /* Katharina fügt Übersetzungen als Ganzes ein — die Absätze stecken dann
     als Zeilenumbrüche IN einem Block, nicht in getrennten Blöcken (bei
     „Pancho's Garten" 4 Blöcke gegenüber 17 im deutschen Original, geprüft
     09.09.). Ohne pre-line liefe der Text zu einer Wand zusammen. Bewusst
     nur hier im Übersetzungsblock — die deutschen Beiträge bleiben, wie
     sie sind. */
  .translations__body :global(.rich p),
  .translations__body :global(.rich li) {
    white-space: pre-line;
  }
</style>
