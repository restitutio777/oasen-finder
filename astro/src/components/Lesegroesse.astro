---
/**
 * Schriftgrößen-Regler (14.09.26, seit 16.09. für die ganze Seite).
 *
 * Drei Stufen, als drei „A" in wachsender Größe — ohne Erklärtext, das
 * Bild sagt es. Die Wahl gilt für die ganze Site und übersteht das
 * Schließen des Browsers (localStorage, kein Cookie, kein Tracking, keine
 * Übertragung).
 *
 * Reichweite (Katharina 16.09.: „bei allen Texten der Webseite"): der
 * Regler setzt --lese-skala auf <html>, und JEDE Textgröße der Site
 * rechnet sich damit — `font-size: calc(<Wert> * var(--lese-skala, 1))`
 * in global.css und in den Seiten. Fest bleiben nur Kopfzeile, Marke,
 * die großen Schauüberschriften und die Ziffern der Terminkarten: sie
 * tragen das Layout und würden bei Stufe 1,3 brechen. Die
 * Zwischenüberschriften im Lesetext skalieren bewusst MIT — sonst stünden
 * sie auf der höchsten Stufe kleiner da als der Fließtext darunter.
 *
 * Bewusst KEIN Einbau in die einzelnen Seiten: der Regler liegt einmal im
 * BaseLayout und sucht sich seinen Platz selbst — über dem ersten Text
 * der Seite. So erscheint er auf JEDER Seite, auch auf künftigen, und
 * niemand muss daran denken.
 *
 * Ohne JavaScript erscheint er nicht. Das ist richtig so: er könnte ohne
 * JavaScript auch nichts bewirken.
 */
---

<div class="lesegroesse" hidden data-lesegroesse>
  <span class="lesegroesse__label">Schriftgröße</span>
  <div class="lesegroesse__gruppe" role="group" aria-label="Schriftgröße für den Text">
    <button type="button" data-stufe="1" aria-label="Normale Schriftgröße" aria-pressed="true"
      ><span style="font-size: 15px">A</span></button
    >
    <button type="button" data-stufe="1.15" aria-label="Größere Schrift" aria-pressed="false"
      ><span style="font-size: 19px">A</span></button
    >
    <button type="button" data-stufe="1.3" aria-label="Größte Schrift" aria-pressed="false"
      ><span style="font-size: 24px">A</span></button
    >
  </div>
</div>

<style>
  .lesegroesse {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    /* Oben Luft, damit der Regler nicht am Bild klebt; unten etwas mehr,
       damit er zum Text gehört und nicht zwischen beiden schwebt. */
    margin: 1.25rem 0 1.75rem;
  }
  .lesegroesse__label {
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .lesegroesse__gruppe {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    overflow: hidden;
    /* Kein eigener Grund: der Regler liegt auf dem Seitenton und drängt
       sich nicht vor den Text. */
    background: transparent;
  }
  /* 44px Mindesthöhe: am Handy muss der Knopf mit dem Daumen sicher zu
     treffen sein, auch wenn das „A" darin klein ist. */
  .lesegroesse__gruppe button {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-display);
    line-height: 1;
    color: var(--text-secondary);
    transition: color 200ms ease, background-color 200ms ease;
  }
  .lesegroesse__gruppe button + button {
    border-left: 1px solid var(--border-subtle);
  }
  .lesegroesse__gruppe button:hover {
    color: var(--accent-bronze);
  }
  /* Die gewählte Stufe bekommt einen hellen Goldschimmer statt Grau: Grau
     las sich am 14.09. wie „ausgeschaltet", das Gold knüpft an die
     Überschriften und den Hauptknopf an. */
  .lesegroesse__gruppe button[aria-pressed='true'] {
    color: var(--accent-bronze);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  @media (max-width: 480px) {
    .lesegroesse__label {
      font-size: 10px;
      letter-spacing: 0.16em;
    }
  }
</style>

<script>
  /* Ab wie vielen Zeichen ein Absatz als „der Text der Seite" gilt. Auf
     Übersichtsseiten ist das der Einleitungssatz unter der Überschrift,
     auf Beitragsseiten der Beitrag selbst. Nur wenn nirgends so viel
     Text steht, rückt der Regler an den Anfang von <main>. */
  const SCHWELLE = 80;
  const SPEICHER = 'werkstatt:lesegroesse';

  const regler = document.querySelector<HTMLElement>('[data-lesegroesse]');
  const main = document.querySelector('main');

  if (regler && main) {
    const laenge = (el: Element) => (el.textContent || '').trim().length;

    /* Reihenfolge der Ankersuche:
       1. Lesetext (.rich) — der Beitrag, nicht der Übersetzungs-Aufklapper.
       2. Der erste Absatz mit genug Text — die Einleitung einer Übersicht.
       3. Sonst irgendein Absatz; sonst der Anfang von <main>.
       Vom 14.09. bis 16.09. sprang der Regler ganz weg, wenn kein .rich
       mit 700 Zeichen da war — damit fehlte er auf allen Übersichts- und
       Randseiten. Er verschwindet jetzt nirgends mehr. */
    const richBloecke = [...main.querySelectorAll<HTMLElement>('.rich')].filter(
      (el) => !el.closest('.translations__body')
    );
    const absaetze = [...main.querySelectorAll<HTMLElement>('p')];
    const ziel =
      richBloecke[0] ||
      absaetze.find((el) => laenge(el) >= SCHWELLE) ||
      absaetze[0] ||
      null;

    if (!ziel || !ziel.parentElement) {
      main.insertBefore(regler, main.firstChild);
    } else {
      /* In einer Flex- oder Grid-Spalte würde der Regler als eigenes
         Layout-Element mitgezählt und die Spalte verschieben — dann
         lieber vor den ganzen Kasten. */
      const eltern = ziel.parentElement;
      const anzeige = getComputedStyle(eltern).display;
      if ((anzeige === 'flex' || anzeige === 'grid') && eltern.parentElement) {
        eltern.parentElement.insertBefore(regler, eltern);
      } else {
        eltern.insertBefore(regler, ziel);
      }
    }
    regler.hidden = false;

    const knoepfe = [...regler.querySelectorAll<HTMLButtonElement>('button')];
    const setze = (stufe: string, speichern: boolean) => {
      document.documentElement.style.setProperty('--lese-skala', stufe);
      knoepfe.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.stufe === stufe)));
      if (speichern) {
        try {
          localStorage.setItem(SPEICHER, stufe);
        } catch {
          /* Privates Fenster o. Ä. — die Einstellung gilt dann nur für
             diese Seite. Kein Grund, den Regler kaputtgehen zu lassen. */
        }
      }
    };

    let gespeichert: string | null = null;
    try {
      gespeichert = localStorage.getItem(SPEICHER);
    } catch {
      /* siehe oben */
    }
    setze(gespeichert && ['1', '1.15', '1.3'].includes(gespeichert) ? gespeichert : '1', false);

    knoepfe.forEach((b) => b.addEventListener('click', () => setze(b.dataset.stufe || '1', true)));
  }
</script>
