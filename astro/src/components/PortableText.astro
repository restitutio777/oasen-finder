---
/**
 * PortableText-Renderer für Sanity-Block-Inhalte.
 *
 * Wandelt das Portable-Text-Block-Array (was Sanity zurückgibt für
 * Rich-Text-Felder wie body, reflection, description, note, summary)
 * in semantisches HTML um — mit Brand-Klassen, sodass das globale
 * CSS greift.
 *
 * Nutzt @portabletext/to-html (Standard-Tool von Sanity).
 *
 * Verwendung:
 *   <PortableText blocks={note.body?.de} />
 */
import { toHTML, type PortableTextOptions } from '@portabletext/to-html';
import { localized, urlFor, type Locale } from '../lib/sanity';

export interface Props {
  /** Lokalisiertes PortableText-Feld (i18nText) oder direkt ein Block-Array */
  value?: any;
  /** Sprache — Default Deutsch */
  locale?: Locale;
  /** Zusätzliche CSS-Klasse für den Wrapper */
  className?: string;
}

const { value, locale = 'de', className = 'rich' } = Astro.props;

/**
 * Wenn value ein i18nText-Objekt ist ({de, fr, en}), holen wir die richtige
 * Sprache. Wenn es schon ein Block-Array ist, nutzen wir es direkt.
 */
const blocks = Array.isArray(value)
  ? value
  : value && typeof value === 'object'
    ? localized(value, locale)
    : null;

/** HTML-Escape für Nutzertext, der in Attribute/Markup eingebaut wird. */
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const components: PortableTextOptions['components'] = {
  types: {
    /* Bild im Fließtext (12.07.): Katharina fügt im Studio ein Bild
       zwischen zwei Absätzen ein — hier wird es responsive gerendert.
       Ohne diesen Handler würde @portabletext/to-html den Block still
       verschlucken und das Bild erschiene nie auf der Seite. */
    image: ({ value }) => {
      const ref: string = value?.asset?._ref || value?.asset?._id || '';
      if (!ref) return '';
      // Originalmaße stecken im Asset-Namen (image-<hash>-<BxH>-<format>) —
      // width/height am <img> verhindern Springen beim Laden.
      const dims = /-(\d+)x(\d+)-/.exec(ref);
      const w = 1200;
      const h = dims ? Math.round((Number(dims[2]) / Number(dims[1])) * w) : undefined;
      const src = (width: number) =>
        urlFor(value).width(width).fit('max').auto('format').quality(80).url();
      const srcset = [400, 800, 1200].map((x) => `${src(x)} ${x}w`).join(', ');
      const caption = typeof value?.caption === 'string' ? value.caption.trim() : '';
      return (
        `<figure class="rich__image">` +
        `<img src="${src(w)}" srcset="${srcset}" sizes="(max-width: 720px) 100vw, 680px"` +
        ` alt="${esc(caption)}" loading="lazy" decoding="async" width="${w}"${h ? ` height="${h}"` : ''}>` +
        (caption ? `<figcaption>${esc(caption)}</figcaption>` : '') +
        `</figure>`
      );
    },
  },
  block: {
    // Standard-Absatz
    normal: ({ children }) => `<p>${children}</p>`,
    // Überschriften
    h1: ({ children }) => `<h2 class="rich__h1">${children}</h2>`,
    h2: ({ children }) => `<h2 class="rich__h2">${children}</h2>`,
    h3: ({ children }) => `<h3 class="rich__h3">${children}</h3>`,
    h4: ({ children }) => `<h4 class="rich__h4">${children}</h4>`,
    blockquote: ({ children }) => `<blockquote class="rich__quote">${children}</blockquote>`,
  },
  marks: {
    // Inline-Formatierungen
    em: ({ children }) => `<em>${children}</em>`,
    strong: ({ children }) => `<strong>${children}</strong>`,
    code: ({ children }) => `<code>${children}</code>`,
    underline: ({ children }) => `<u>${children}</u>`,
    'strike-through': ({ children }) => `<s>${children}</s>`,
    // Link-Mark (wenn Katharina einen Inline-Link im Text setzt)
    link: ({ children, value }) => {
      const href = (value as any)?.href || '#';
      const external = /^https?:\/\//.test(href);
      const attrs = external ? ' target="_blank" rel="noopener"' : '';
      return `<a href="${href}"${attrs}>${children}</a>`;
    },
  },
  list: {
    bullet: ({ children }) => `<ul class="rich__list">${children}</ul>`,
    number: ({ children }) => `<ol class="rich__list rich__list--ordered">${children}</ol>`,
  },
  listItem: {
    bullet: ({ children }) => `<li>${children}</li>`,
    number: ({ children }) => `<li>${children}</li>`,
  },
};

const html = blocks ? toHTML(blocks, { components }) : '';
---

{html && <div class={className} set:html={html} />}

<style is:global>
  /* Rich-Text-Styling — Block-Renderer aus PortableText.astro.
     Greift auf das globale Font/Color-Set, fügt nur Spacing dazu. */
  .rich > * + * {
    margin-top: 1.2em;
  }
  .rich p {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.7;
    color: var(--text-body, #4a3d5a);
  }
  .rich em {
    font-style: italic;
    color: var(--text-primary, #2d2435);
  }
  .rich strong {
    font-weight: 600;
    color: var(--text-primary, #2d2435);
  }
  .rich a {
    color: var(--link, #8a6348);
    font-weight: 600;
    border-bottom: 1.5px solid currentColor;
    text-underline-offset: 2px;
    transition: color 200ms ease;
  }
  .rich a:hover {
    color: var(--link-hover, #6d4d38);
  }
  .rich__h2 {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-primary, #2d2435);
    margin-top: 2em;
  }
  .rich__h3 {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 500;
    color: var(--text-primary, #2d2435);
    margin-top: 1.6em;
  }
  .rich__quote {
    border-left: 3px solid var(--accent, #c89a78);
    padding-left: 1.2em;
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--text-primary, #2d2435);
  }
  .rich__list {
    padding-left: 1.5em;
  }
  .rich__list li {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--text-body, #4a3d5a);
    margin-top: 0.5em;
  }
  /* Bild im Textfluss (types.image) — etwas mehr Luft als Absätze,
     gleiche Kantenrundung wie SanityImage. */
  .rich .rich__image {
    margin: 2em 0;
  }
  .rich .rich__image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .rich .rich__image figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 14px;
    color: var(--text-secondary, #6a5a78);
  }

  /* Gedicht-Layout (kind === 'poesie'): ersetzt die Artikel-Typo durch
     poesietauglichen Zeilen-/Versabstand. Jede Verszeile ist ein eigener
     Block — daher bewusst kleiner Block-Abstand; eine leere Zeile im Text
     wirkt dadurch als Strophen-Trenner. Gesteuert über die Backend-Felder
     poemAlign / poemLineSpacing / poemImageGap / poemItalic. */
  .poem {
    --verse-gap: 0.4em;
  }
  .poem > * + * {
    margin-top: var(--verse-gap);
  }
  .poem p {
    line-height: 1.5;
  }
  .poem.poem--align-zentriert {
    text-align: center;
  }
  .poem.poem--italic p {
    font-style: italic;
  }
  .poem.poem--verse-eng {
    --verse-gap: 0.15em;
  }
  .poem.poem--verse-eng p {
    line-height: 1.4;
  }
  .poem.poem--verse-normal {
    --verse-gap: 0.4em;
  }
  .poem.poem--verse-weit {
    --verse-gap: 0.85em;
  }
  .poem.poem--verse-weit p {
    line-height: 1.7;
  }
  /* Abstand zwischen Hauptbild und Gedicht-Text */
  .poem.poem--imggap-eng {
    margin-top: 1rem;
  }
  .poem.poem--imggap-normal {
    margin-top: 2rem;
  }
  .poem.poem--imggap-weit {
    margin-top: 3.5rem;
  }
</style>
