---
/**
 * Hinweis auf eine Übersetzung — direkt unter dem Titel (09.09.26).
 *
 * Zweck (Betreiber, 09.09.): Katharina verschickt einzelne Beiträge an
 * anderssprachige Leute. Die sollen sofort beim Öffnen sehen, dass es ihre
 * Fassung gibt — und nicht erst nach seitenlangem Scrollen. Deshalb steht
 * der Hinweis oben und springt zum Text unten, wo er zugleich aufgeklappt
 * wird (siehe translations.js).
 *
 * Beschriftung in der ZIELsprache samt übersetztem Titel — wer nur Englisch
 * liest, versteht die Zeile auch dann, wenn ringsum alles deutsch ist.
 *
 * Ohne JavaScript bleibt es ein simpler Anker-Link: der Sprung funktioniert,
 * der Leser klappt selbst auf.
 */
import { availableTranslations } from '../lib/sanity';

export interface Props {
  /** i18nString mit dem Titel */
  title?: any;
  /** i18nText mit dem Fließtext ({ de, fr, en }) */
  body?: any;
}

const { title, body } = Astro.props;
const translations = availableTranslations(body, title);
---

{translations.length > 0 && (
  <nav class="translation-link" aria-label="Übersetzungen">
    {translations.map((t) => (
      <a class="translation-link__item" href={`#${t.anchor}`} lang={t.locale} data-translation-jump={t.anchor}>
        <span class="translation-link__code">{t.locale.toUpperCase()}</span>
        <span class="translation-link__text">
          <span class="translation-link__invitation">{t.hasTitle ? `${t.invitation}:` : t.invitation}</span>
          {t.hasTitle && <span class="translation-link__title">{t.heading}</span>}
        </span>
        <span class="translation-link__arrow" aria-hidden="true">↓</span>
      </a>
    ))}
  </nav>
)}

<style>
  .translation-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0 0 2rem;
  }
  .translation-link__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--accent, #c89a78);
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent, #c89a78) 8%, transparent);
    text-decoration: none;
    transition: background 200ms ease, border-color 200ms ease;
  }
  .translation-link__item:hover {
    background: color-mix(in srgb, var(--accent, #c89a78) 16%, transparent);
  }
  .translation-link__code {
    flex: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    background: var(--accent, #c89a78);
    color: #fff;
  }
  .translation-link__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
  }
  .translation-link__invitation {
    font-size: 14px;
    color: var(--text-secondary, #6a5a78);
  }
  .translation-link__title {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary, #2d2435);
  }
  .translation-link__arrow {
    margin-left: auto;
    flex: none;
    color: var(--accent, #c89a78);
    font-size: 16px;
  }
</style>
