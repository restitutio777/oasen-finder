---
/**
 * Hinweis auf eine Übersetzung — direkt unter dem Titel (09.09.26).
 *
 * Zweck (Betreiber, 09.09.): Katharina verschickt einzelne Beiträge an
 * anderssprachige Leute. Die sollen sofort beim Öffnen sehen, dass es ihre
 * Fassung gibt — und nicht erst nach seitenlangem Scrollen. Deshalb steht
 * der Hinweis oben und springt zum Text unten, wo er zugleich aufgeklappt
 * wird (siehe Translations.astro).
 *
 * Gestaltung: bewusst KEIN Kasten und kein farbiges Badge — das war der
 * erste Versuch und stand als Fremdkörper in einer Seite, die sonst nur mit
 * Typografie und feinen Linien arbeitet (Betreiber, 09.09.: „ugly and
 * boxy"). Stattdessen das hauseigene Vokabular: der globale `.eyebrow`
 * (gesperrte Versalien mit Strich davor, wie „NOTIZ" oder „POESIE") plus
 * der Titel in der Display-Schrift. Fügt sich in die Titelzone ein, statt
 * sie zu unterbrechen.
 *
 * Beschriftung in der ZIELsprache samt übersetztem Titel — wer nur Englisch
 * liest, versteht die Zeile auch dann, wenn ringsum alles deutsch ist.
 *
 * Ohne JavaScript bleibt es ein simpler Anker-Link: der Sprung funktioniert,
 * der Leser klappt selbst auf.
 */
import { availableTranslations } from '../lib/sanity';

export interface Props {
  /** i18nString mit dem Titel */
  title?: any;
  /** i18nText mit dem Fließtext ({ de, fr, en }) */
  body?: any;
}

const { title, body } = Astro.props;
const translations = availableTranslations(body, title);
---

{translations.length > 0 && (
  <nav class="translation-link" aria-label="Übersetzungen">
    {translations.map((t) => (
      <a class="translation-link__item" href={`#${t.anchor}`} lang={t.locale} data-translation-jump={t.anchor}>
        <span class="eyebrow">{t.invitation}</span>
        {t.hasTitle && <span class="translation-link__title">{t.heading}</span>}
      </a>
    ))}
  </nav>
)}

<style>
  .translation-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 2.5rem;
  }
  .translation-link__item {
    display: flex;
    flex-direction: column;
    /* Der Saum unter dem Titel soll am Text enden, nicht durch die ganze
       Spalte laufen — sonst wirkt er wieder wie ein Rahmen. */
    align-items: flex-start;
    gap: 0.4rem;
    text-decoration: none;
    /* Anfassbare Fläche, ohne sichtbaren Rahmen. */
    padding: 0.1rem 0;
  }
  .translation-link__title {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(19px, 1.6vw, 22px);
    font-style: italic;
    line-height: 1.35;
    color: var(--link, #3a7894);
    /* Feiner Saum statt Unterstreichung — wie die Fließtext-Links. */
    box-shadow: inset 0 -1px 0 color-mix(in srgb, currentColor 35%, transparent);
    transition: color 200ms ease, box-shadow 200ms ease;
  }
  .translation-link__title::after {
    content: ' ↓';
    font-style: normal;
    font-size: 0.8em;
    opacity: 0.7;
  }
  .translation-link__item:hover .translation-link__title {
    color: var(--link-hover, #2f5f76);
    box-shadow: inset 0 -1px 0 currentColor;
  }
  /* Ohne übersetzten Titel trägt der Eyebrow allein den Link — dann darf er
     nicht wie unklickbare Meta-Zeile wirken. */
  .translation-link__item:hover .eyebrow {
    color: var(--accent, #c89a78);
  }
</style>
