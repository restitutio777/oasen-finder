---
/**
 * Hinweis auf eine Übersetzung — direkt unter dem Titel (09.09.26).
 *
 * Zweck (Betreiber, 09.09.): Katharina verschickt einzelne Beiträge an
 * anderssprachige Leute. Die sollen sofort beim Öffnen sehen, dass es ihre
 * Fassung gibt — und nicht erst nach seitenlangem Scrollen. Deshalb steht
 * der Hinweis oben und springt zum Text unten, wo er zugleich aufgeklappt
 * wird (siehe Translations.astro).
 *
 * Gestaltung: bewusst KEIN Kasten und kein farbiges Badge — das war der
 * erste Versuch und stand als Fremdkörper in einer Seite, die sonst nur mit
 * Typografie und feinen Linien arbeitet (Betreiber, 09.09.: „ugly and
 * boxy"). Stattdessen das hauseigene Vokabular: der globale `.eyebrow`
 * (gesperrte Versalien mit Strich davor, wie „NOTIZ" oder „POESIE") plus
 * der Titel in der Display-Schrift. Fügt sich in die Titelzone ein, statt
 * sie zu unterbrechen.
 *
 * Beschriftung in der ZIELsprache samt übersetztem Titel — wer nur Englisch
 * liest, versteht die Zeile auch dann, wenn ringsum alles deutsch ist.
 *
 * Ohne JavaScript bleibt es ein simpler Anker-Link: der Sprung funktioniert,
 * der Leser klappt selbst auf.
 */
import { availableTranslations } from '../lib/sanity';

export interface Props {
  /** i18nString mit dem Titel */
  title?: any;
  /** i18nText mit dem Fließtext ({ de, fr, en }) */
  body?: any;
}

const { title, body } = Astro.props;
const translations = availableTranslations(body, title);
---

{translations.length > 0 && (
  <nav class="translation-link" aria-label="Übersetzungen">
    {translations.map((t) => (
      <a class="translation-link__item" href={`#${t.anchor}`} lang={t.locale} data-translation-jump={t.anchor}>
        {t.hasTitle && <span class="eyebrow">{t.invitation}</span>}
        <span class="translation-link__title">
          {/* Der Pfeil steht außerhalb des unterstrichenen Textes — sonst
              zöge sich der Saum unter ihm durch und sähe aus wie ein
              versehentlicher Strich. */}
          <span class="translation-link__text">{t.hasTitle ? t.heading : t.invitation}</span>
          <span class="translation-link__arrow" aria-hidden="true">↓</span>
        </span>
      </a>
    ))}
  </nav>
)}

<style>
  .translation-link {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0 0 2.25rem;
  }
  .translation-link__item {
    display: block;
    text-decoration: none;
    /* Feine Linie links statt Rahmen ringsum: dieselbe Geste, mit der die
       Seite schon Zitate auszeichnet (.rich__quote in PortableText.astro),
       nur zurückhaltender. Sie bindet Sprachangabe und Titel zu EINEM
       Element zusammen, ohne einen Kasten zu bauen. */
    border-left: 1px solid var(--accent, #c89a78);
    border-left-color: color-mix(in srgb, var(--accent, #c89a78) 45%, transparent);
    padding: 0.15rem 0 0.15rem 1.1rem;
    transition: border-left-color 200ms ease;
  }
  .translation-link__item:hover {
    border-left-color: var(--accent, #c89a78);
  }
  /* Der Strich der Eyebrow entfällt hier — die Linie links übernimmt
     seine Rolle, zwei Striche nebeneinander wären eine Geste zu viel. */
  .translation-link__item .eyebrow::before {
    display: none;
  }
  .translation-link__title {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(20px, 1.7vw, 23px);
    font-style: italic;
    line-height: 1.3;
    color: var(--link, #3a7894);
    transition: color 200ms ease;
  }
  /* Ohne Sprachangabe darüber trägt der Titel die Zeile allein. */
  .translation-link__item .eyebrow + .translation-link__title {
    margin-top: 0.35rem;
  }
  .translation-link__item > .translation-link__title:first-child {
    margin-top: 0;
  }
  .translation-link__text {
    /* Ruhender Saum nur angedeutet, beim Überfahren voll — wie die
       Fließtext-Links, aber leiser. */
    box-shadow: inset 0 -1px 0 color-mix(in srgb, currentColor 22%, transparent);
    transition: box-shadow 200ms ease;
  }
  .translation-link__item:hover .translation-link__text {
    box-shadow: inset 0 -1px 0 currentColor;
  }
  .translation-link__item:hover .translation-link__title {
    color: var(--link-hover, #2f5f76);
  }
  .translation-link__arrow {
    font-style: normal;
    font-size: 0.72em;
    opacity: 0.6;
    margin-left: 0.3em;
    display: inline-block;
    transition: transform 200ms ease;
  }
  .translation-link__item:hover .translation-link__arrow {
    transform: translateY(2px);
  }
</style>
