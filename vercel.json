{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd astro && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "astro/dist",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.sanity.studio https://*.sanity.io" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
